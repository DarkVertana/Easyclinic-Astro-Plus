---
import AdminShell from '../../components/admin/AdminShell.astro';
import { DashboardPage } from '../../components/admin/app/DashboardPage';
import { STAGE_LABELS } from '../../components/admin/app/format';
import { activityFeed, loadWorkflow, pageUser, pipelineCounts, postRows, STALE_DAYS } from '../../components/admin/data';
import { frameData, rowData } from '../../components/admin/frame';

export const prerender = false;

const auth = await pageUser(Astro);
if (auth instanceof Response) return auth;
const user = auth;
const frame = await frameData(Astro.url, user, 'dashboard');
const { submissions, jobs, storeError } = await loadWorkflow();
const rows = await postRows(submissions, user);
const [counts, feed] = await Promise.all([pipelineCounts(rows), activityFeed(8, submissions)]);
const stages = [
  { key: 'draft', label: 'Drafts', value: counts.drafts, href: '/admin/posts/?tab=drafts' },
  { key: 'review', label: 'In review', value: counts.inReview, href: '/admin/posts/?tab=review' },
  { key: 'scheduled', label: 'Scheduled', value: counts.scheduled, href: '/admin/posts/?tab=scheduled' },
  { key: 'live', label: 'Published', value: counts.published, href: '/admin/posts/?tab=published' },
];

/* My work: what this person can act on now, most urgent first */
const createdBy = new Map(submissions.map((s) => [s.id, s.createdBy]));
const rank = (work: string) => (user.role === 'approver' ? { failed: 0, in_review: 1, changes_requested: 2, editing: 3, scheduled: 4 } : { failed: 0, changes_requested: 1, editing: 2, in_review: 3, scheduled: 4 } as Record<string, number>)[work as 'failed'] ?? 5;
const mine = rows
  .filter((r) => !r.trashed && r.work !== 'none')
  .filter((r) => user.role === 'approver' || (r.submissionId && createdBy.get(r.submissionId) === user.email))
  .filter((r) => r.work !== 'editing' || (r.submissionId && createdBy.get(r.submissionId) === user.email))
  .sort((a, b) => rank(a.work) - rank(b.work) || new Date(a.updated ?? 0).getTime() - new Date(b.updated ?? 0).getTime());
const workItem = (r: (typeof rows)[number]) => {
  if ((r.work === 'in_review' || r.work === 'failed') && r.actions.includes('approve')) return { label: 'Review', href: `/admin/approvals/${r.submissionId}/` };
  if (r.work === 'changes_requested') return { label: 'Fix', href: `/admin/posts/${r.submissionId}/` };
  if (r.work === 'editing') return { label: 'Continue', href: `/admin/posts/${r.submissionId}/` };
  return { label: 'Open', href: `/admin/posts/${r.submissionId}/` };
};

/* Content health: real counts, each one a link to that list */
const live = rows.filter((r) => !r.trashed);
const now = new Date();
const staleCutoff = now.getTime() - STALE_DAYS * 86_400_000;
const health = [
  { label: 'No author', value: live.filter((r) => !r.authorId).length, href: '/admin/posts/?health=no-author' },
  { label: 'No landing page', value: live.filter((r) => !r.owner || r.owner === 'No owner').length, href: '/admin/posts/?health=no-owner' },
  { label: 'Owned by the blog index', value: live.filter((r) => r.owner === '/blog/').length, href: '/admin/posts/?health=blog-owner' },
  { label: `Published, not updated in ${STALE_DAYS} days`, value: live.filter((r) => r.site === 'live' && r.updated && new Date(r.updated).getTime() < staleCutoff).length, href: '/admin/posts/?health=out-of-date' },
];
const dayKey = (value: Date | string) => new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(value));
const updatedDays = [...new Set(rows.filter((r) => !r.trashed && r.site === 'live' && r.updated).map((r) => dayKey(r.updated!)))];
const scheduled = rows.filter((r) => r.scheduledAt && !r.trashed).sort((a, b) => a.scheduledAt!.localeCompare(b.scheduledAt!)).map((r) => ({ slug: r.slug, title: r.title, at: r.scheduledAt!, day: dayKey(r.scheduledAt!) }));
const stageLabel = (stage: string) => STAGE_LABELS.find((s) => s.stage === stage)?.label ?? 'Working';
const openJobs = jobs.filter((j) => j.stage !== 'done').slice(0, 5).map((j) => ({ id: j.id, title: j.brief.topicIdea, note: j.stage === 'failed' ? 'Failed. Open it to retry.' : j.stage === 'awaiting_outline' ? 'Outline needs your approval' : `Paused at: ${stageLabel(j.stage)}` }));
---

<AdminShell title="Dashboard">
  <DashboardPage client:load {frame} now={now.toISOString()} {storeError} {stages} work={mine.slice(0, 8).map((r) => ({ row: rowData(r), ...workItem(r) }))} workCount={mine.length} {health} {updatedDays} {scheduled} feed={feed.map((e) => ({ at: e.at, by: e.by, text: e.text, title: e.title, slug: e.slug }))} jobs={openJobs} />
</AdminShell>

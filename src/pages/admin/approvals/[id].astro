---
import AdminShell from '../../../components/admin/AdminShell.astro';
import { MessagePage } from '../../../components/admin/app/MessagePage';
import { ReviewPage } from '../../../components/admin/app/ReviewPage';
import { approvalChecks, pageUser, postRows, previewUrl, schedulePrecision, storeOrNull } from '../../../components/admin/data';
import { compareData, evidenceData, frameData, publishedFields, rowData } from '../../../components/admin/frame';
import { linkTargets } from '../../../lib/admin/harness';
import { parsePost } from '../../../lib/admin/mdx-file';
import { renderPreview } from '../../../lib/admin/preview';
import { getRepo } from '../../../lib/admin/repo';
import { isExternalLink } from '../../../lib/admin/review';
import type { Job, Submission } from '../../../lib/admin/types';

export const prerender = false;

const auth = await pageUser(Astro);
if (auth instanceof Response) return auth;
const user = auth;
const frame = await frameData(Astro.url, user, 'approvals');
const id = Astro.params.id!;

const { store, storeError } = storeOrNull();
let submission: Submission | null = null;
let job: Job | null = null;
let loadError = storeError;
try {
  submission = store ? await store.getSubmission(id) : null;
  if (submission?.jobId && store) job = await store.getJob(submission.jobId);
} catch {
  loadError = 'This post could not be loaded because the workflow store did not respond. Nothing has changed. Reload to try again.';
}
if (!submission && !loadError) Astro.response.status = 404;

const fm = (submission?.content.frontmatter ?? {}) as Record<string, any>;
const str = (v: unknown) => (typeof v === 'string' ? v : '');
const checks = submission ? await approvalChecks(submission) : null;
const row = submission ? ((await postRows(await store!.listSubmissions(), user)).find((r) => r.slug === submission!.slug) ?? null) : null;
const mode = Astro.url.searchParams.get('show') === 'changes' ? 'changes' : 'rendered';

let compare = null;
let changesUnknown = false;
if (submission?.kind === 'edit') {
  try {
    const live = await getRepo().readPost(submission.slug);
    if (live) compare = compareData({ label: 'Live', ...parsePost(live.raw) }, { label: 'For review', frontmatter: fm, body: submission.content.body });
  } catch {
    changesUnknown = true;
  }
}
const title = submission ? str(fm.h1) || str(fm.title) || submission.slug : 'Post not found';
const faq: Array<{ question: string; answer: string }> = Array.isArray(fm.faq) ? fm.faq : [];
---

<AdminShell {title}>
  {submission ? (
    <ReviewPage
      client:load
      {frame}
      now={new Date().toISOString()}
      row={row && rowData(row)}
      sub={{ id: submission.id, slug: submission.slug, kind: submission.kind, state: submission.state, createdBy: submission.createdBy, contentHash: submission.contentHash, history: submission.history, submittedAt: [...submission.history].reverse().find((e) => e.action === 'submitted')?.at ?? submission.updatedAt }}
      {title}
      h1={str(fm.h1)}
      opening={str(fm.openingAnswer)}
      html={renderPreview(submission.content.body)}
      faq={faq.map((f) => ({ question: f.question, html: renderPreview(f.answer ?? '') }))}
      searchTitle={str(fm.title)}
      searchDescription={str(fm.metaDescription)}
      fields={await publishedFields(fm)}
      links={linkTargets(submission.content.body, true).map((l) => ({ target: l.target, external: isExternalLink(l.target) }))}
      {checks}
      {compare}
      canCompare={Boolean(compare)}
      {changesUnknown}
      {mode}
      previewUrl={previewUrl(submission.previewBranch, submission.slug)}
      precision={schedulePrecision()}
      job={job && evidenceData(job)}
    />
  ) : (
    <MessagePage client:load {frame} title={loadError ? 'Post unavailable' : 'Post not found'} back={{ href: '/admin/approvals/', label: 'Review' }} error={loadError} text="It may have been removed." link={{ href: '/admin/approvals/', label: 'See the queue' }} />
  )}
</AdminShell>

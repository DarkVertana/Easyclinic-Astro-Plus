---
import AdminShell from '../../../components/admin/AdminShell.astro';
import { QueuePage } from '../../../components/admin/app/ReviewPage';
import { loadWorkflow, pageUser, runChecks } from '../../../components/admin/data';
import { frameData } from '../../../components/admin/frame';

export const prerender = false;

const auth = await pageUser(Astro);
if (auth instanceof Response) return auth;
const user = auth;
const frame = await frameData(Astro.url, user, 'approvals');
const { submissions, storeError } = await loadWorkflow();
const submittedAt = (s: (typeof submissions)[number]) => [...s.history].reverse().find((e) => e.action === 'submitted')?.at ?? s.updatedAt;
const queue = submissions.filter((s) => s.state === 'pending').sort((a, b) => submittedAt(a).localeCompare(submittedAt(b)));
const rows = await Promise.all(
  queue.map(async (s) => {
    const checks = await runChecks(s);
    return { id: s.id, title: String(s.content.frontmatter.h1 || s.content.frontmatter.title || s.slug), kind: s.kind, ai: Boolean(s.jobId), createdBy: s.createdBy, submittedAt: submittedAt(s), problems: checks === null ? null : checks.filter((c) => c.severity === 'error').length };
  }),
);
---

<AdminShell title="Review">
  <QueuePage client:load {frame} now={new Date().toISOString()} {storeError} {rows} />
</AdminShell>

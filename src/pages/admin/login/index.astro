---
import AdminShell from '../../../components/admin/AdminShell.astro';
import { LoginPage } from '../../../components/admin/blog/LoginPage';
import { authSetupProblem, currentUser } from '../../../lib/admin/auth';
import { devSignInEnabled } from '../../../lib/admin/dev-guard';
import { safeBack } from '../../../lib/admin/http';

export const prerender = false;

const back = safeBack(Astro.url.searchParams.get('back'), '/admin/posts/');
if (await currentUser(Astro)) return Astro.redirect(back);
const error = Astro.url.searchParams.get('error')?.slice(0, 200) ?? null;
---

<AdminShell title="Sign in">
  <LoginPage client:load {error} {back} setupProblem={authSetupProblem()} dev={devSignInEnabled()} />
</AdminShell>

---
import AdminShell from '../../../components/admin/AdminShell.astro';
import { PostList } from '../../../components/admin/blog/PostList';
import { blogRows } from '../../../components/admin/blog-data';
import { pageUser } from '../../../components/admin/data';

export const prerender = false;

const auth = await pageUser(Astro);
if (auth instanceof Response) return auth;
const { rows, storeError } = await blogRows();
const flash = Astro.url.searchParams.get('done')?.slice(0, 160) ?? null;
---

<AdminShell title="Posts">
  <PostList client:load {rows} email={auth.email} now={new Date().toISOString()} {storeError} {flash} />
</AdminShell>

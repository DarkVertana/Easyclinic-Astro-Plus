---
/** Opens any post by its web address. A GET that writes nothing: a working copy goes to its editor, a live post gets a read view, a draft opens for editing. */
import AdminShell from '../../../../components/admin/AdminShell.astro';
import { EditorPage } from '../../../../components/admin/app/EditorPage';
import { MessagePage } from '../../../../components/admin/app/MessagePage';
import { ReadPage } from '../../../../components/admin/app/ReadPage';
import { loadWorkflow, pageUser, postForView, postRows, runChecks } from '../../../../components/admin/data';
import { editorData, frameData, publishedFields, rowData } from '../../../../components/admin/frame';
import { renderPreview } from '../../../../lib/admin/preview';
import type { Submission } from '../../../../lib/admin/types';

export const prerender = false;

const auth = await pageUser(Astro);
if (auth instanceof Response) return auth;
const user = auth;
const frame = await frameData(Astro.url, user, 'posts');
const slug = Astro.url.searchParams.get('slug') ?? '';

const { submissions } = await loadWorkflow();
const row = (await postRows(submissions, user)).find((r) => r.slug === slug) ?? null;
if (row?.submissionId) {
  const next = new URLSearchParams(Astro.url.searchParams);
  next.delete('slug');
  const query = next.toString();
  return Astro.redirect(`/admin/posts/${row.submissionId}/${query ? `?${query}` : ''}`, 303);
}

let content: { frontmatter: Record<string, unknown>; body: string } | null = null;
let baseSha: string | null = null;
let loadError: string | null = null;
try {
  const view = /^[a-z0-9-]{1,120}$/.test(slug) ? await postForView(slug, user) : null;
  content = view?.content ?? null;
  baseSha = view?.file?.sha ?? null;
} catch {
  loadError = 'The post could not be read from the repository. Nothing has changed. Reload to try again.';
}
if (!content && !loadError) Astro.response.status = 404;

// Reading only: nothing here stores this object. The checks need the shape of a working copy.
const checks = content
  ? await runChecks({ id: '', slug, kind: 'edit', state: 'draft', content, contentHash: '', baseSha: null, submittedHash: null, previewBranch: null, jobId: null, history: [], createdAt: '', updatedAt: '', createdBy: '' } as Submission)
  : null;
const fm = (content?.frontmatter ?? {}) as Record<string, any>;
const title = content ? String(fm.h1 || fm.title || slug) : 'Post not found';
// A post with no working copy reads first unless the person asked to edit, except a draft, whose only purpose is editing.
const editing = Boolean(content && row?.actions.includes('edit') && (Astro.url.searchParams.has('edit') || row.site !== 'live'));
const data = content && editing ? await editorData(content, slug) : null;
const faq: Array<{ question: string; answer: string }> = Array.isArray(fm.faq) ? fm.faq : [];
---

<AdminShell {title}>
  {!content || !row ? (
    <MessagePage client:load {frame} title={loadError ? 'Post unavailable' : 'Post not found'} back={{ href: '/admin/posts/', label: 'Posts' }} error={loadError} text="It may have been removed." link={{ href: '/admin/posts/', label: 'Go back to posts' }} />
  ) : data ? (
    <EditorPage client:load {frame} {slug} {...data} row={rowData(row)} submission={null} isOpenCopy={false} {baseSha} {checks} note={null} revisions={[]} compare={null} compareError={null} conflict={null} jobId={null} />
  ) : (
    <ReadPage client:load {frame} row={rowData(row)} {title} opening={String(fm.openingAnswer ?? '')} html={renderPreview(content.body)} faq={faq.map((f) => ({ question: f.question, html: renderPreview(f.answer ?? '') }))} fields={await publishedFields(fm)} searchTitle={String(fm.title ?? '')} searchDescription={String(fm.metaDescription ?? '')} {checks} />
  )}
</AdminShell>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/frame/Breadcrumbs.astro';
import Hero from '../components/frame/Hero.astro';
import FAQ from '../components/frame/FAQ.astro';
import RelatedLinks from '../components/frame/RelatedLinks.astro';
import ProblemList from '../components/frame/ProblemList.astro';
import CTABand from '../components/frame/CTABand.astro';
import HelpBand from '../components/frame/HelpBand.astro';
import AwardRecognition from '../components/frame/AwardRecognition.astro';
import FeatureChips from '../components/frame/FeatureChips.astro';
import ClientLogos from '../components/frame/ClientLogos.astro';
import WhatIsEasyClinic from '../components/frame/WhatIsEasyClinic.astro';
import HeroPanel from '../components/frame/HeroPanel.astro';
import TrustSection from '../components/frame/TrustSection.astro';
import ReadinessSection from '../components/frame/ReadinessSection.astro';
import PlatformSection from '../components/frame/PlatformSection.astro';
import Section from '../components/ui/Section.astro';
import Md from '../components/ui/Md.astro';
import Sections from '../components/blocks/Sections.astro';
import ContactCard from '../components/blocks/ContactCard/ContactCard.astro';
import { getEntry } from 'astro:content';
import { getRegistry, type PageRecord } from '../lib/content/registry';
import { breadcrumbTrail } from '../lib/seo/breadcrumbs';
import { pageGraph } from '../lib/seo/page-graph';
import type { BlockContext } from '../components/blocks/types';

/**
 * The template for landing families (spec 7.4): frame around the page's sections.
 * Hero, byline, FAQ, related links and the closing band come from the entry's own fields.
 */
interface Props {
  record: PageRecord;
}

const { record } = Astro.props;
const registry = await getRegistry();
const d = record.data;
const trail = breadcrumbTrail(record, registry);
const jsonLd = await pageGraph(record, trail);
const countryId = d.country?.id;
const site = (await getEntry('site', 'site'))!.data;
const countryData = countryId ? (await getEntry('countries', countryId))?.data : undefined;
const whatsappText = d.ctas.whatsapp ?? `Hi, I was reading about Easy Clinic (${record.label}) and would like a demo.`;
const whatsappHref = `https://wa.me/${countryData?.contact.whatsapp ?? site.whatsapp}?text=${encodeURIComponent(whatsappText)}`;
const ctx: Omit<BlockContext, 'index'> = {
  path: record.path,
  family: record.family,
  status: record.status,
  country: countryId,
  pageLabel: record.label,
  whatsappHref,
};
// Country pages carry the local contact card in the hero (section 11, "Country pages").
const heroContact = (record.family === 'country' || record.family === 'countryDemo') && d.country;
// A hero panel (the country listicles) puts an image card beside the text and a reach line under the CTAs.
const heroPanel = d.heroPanel;
---

<BaseLayout
  title={d.title}
  description={d.metaDescription}
  path={record.path}
  canonical={d.canonical}
  indexable={record.indexable}
  jsonLd={jsonLd}
  modifiedTime={d.lastUpdated}
  country={countryId}
  family={record.family}
  whatsappText={whatsappText}
  preview={{ status: record.status, issues: record.issues }}
>
  <Breadcrumbs trail={trail} />
  <Hero
    eyebrow={d.eyebrow}
    h1={d.h1}
    openingAnswer={d.openingAnswer}
    ctas={d.ctas}
    heroMedia={d.heroMedia}
    heroStrip={d.heroStrip}
    narrowLede={record.path === '/'}
    noColumnGap={record.path === '/'}
    largeHeading={Boolean(heroPanel) || ['feature', 'solution', 'specialty', 'ai', 'curapilot'].includes(record.family) || ['/solutions/', '/specialties/', '/countries/', '/pricing/', '/compare/', '/customers/', '/start-a-clinic/', '/switch/', '/blog/'].includes(record.path)}
    byline={{ author: d.author, reviewedBy: d.reviewedBy, lastUpdated: d.lastUpdated }}
  >
    {heroPanel && <HeroPanel slot="media" src={heroPanel.src} alt={heroPanel.alt} />}
    {
      heroPanel && (
        <ul slot="stats" class="mt-7 grid grid-cols-[auto_auto] justify-start gap-x-8 gap-y-2 text-base text-ink min-[45rem]:flex min-[45rem]:flex-wrap min-[45rem]:gap-x-3" aria-label="Easy Clinic in numbers">
          {[
            ['200+', 'cities'],
            ['5000+', 'doctors'],
            ['18+', 'countries'],
            ['10+ years', heroPanel.yearsIn],
          ].map(([n, label], i) => (
            // Two columns (the last item on its own row) on phones; one line with separators from 720px, except beside
            // the image on tablets (md), where the last item takes its own line.
            <li class:list={['flex items-center gap-3 min-[45rem]:whitespace-nowrap', i === 3 && 'col-span-2 md:basis-full lg:basis-auto']}>
              {i > 0 && <span class:list={['hidden text-[#b4bdca] min-[45rem]:inline', i === 3 && 'md:hidden lg:inline']} aria-hidden="true">|</span>}
              <span>
                <strong class="font-semibold text-ink-heading">{n}</strong> {label}
              </span>
            </li>
          ))}
        </ul>
      )
    }
    {heroContact && <div slot="aside" class="mt-6"><ContactCard country={d.country!} showClients={false} ctx={{ ...ctx, index: -1 }} /></div>}
  </Hero>
  {d.trustSection && <TrustSection {...d.trustSection} />}
  {d.readinessSection && <ReadinessSection {...d.readinessSection} />}
  {d.platformSection && <PlatformSection {...d.platformSection} />}
  {record.path === '/' && <AwardRecognition />}
  {record.path === '/' && <FeatureChips />}
  {record.path === '/' && <ClientLogos />}
  {record.path === '/' && <WhatIsEasyClinic />}
  <Sections sections={d.sections} ctx={ctx} />
  {/* Related links come before the FAQ, so the FAQ sits directly above the closing CTA band. */}
  <RelatedLinks heading={d.links.relatedHeading} links={d.links.related} countryPills={record.path === '/'} tinted={record.path === '/about-us/'} />
  {d.helpBand && <HelpBand {...d.helpBand} />}
  {
    d.nearbySection && (
      <Section id="nearby-markets" heading={d.nearbySection.heading} tone="wash" wideHeader>
        <Md text={d.nearbySection.body} class="nearby-body max-w-[56rem] text-[1.0625rem] leading-relaxed text-ink sm:text-lg" />
      </Section>
    )
  }
  {d.problems && d.problems.items.length > 0 && <ProblemList {...d.problems} />}
  <FAQ heading={d.faqHeading} items={d.faq} tone="plain" whatsappHref={whatsappHref} />
  {d.closing && <CTABand closing={d.closing} whatsappHref={whatsappHref} />}
</BaseLayout>

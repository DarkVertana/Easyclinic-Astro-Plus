---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/frame/Breadcrumbs.astro';
import AuthorByline from '../components/frame/AuthorByline.astro';
import FAQ from '../components/frame/FAQ.astro';
import RelatedLinks from '../components/frame/RelatedLinks.astro';
import CTABand from '../components/frame/CTABand.astro';
import Sections from '../components/blocks/Sections.astro';
import Md from '../components/ui/Md.astro';
import Button from '../components/ui/Button.astro';
import InlineCta from '../components/mdx/InlineCta.astro';
import Link from '../components/mdx/Link.astro';
import PostTable from '../components/mdx/PostTable.astro';
import { getRegistry, type PageRecord } from '../lib/content/registry';
import { breadcrumbTrail } from '../lib/seo/breadcrumbs';
import { pageGraph } from '../lib/seo/page-graph';
import { formatDate, isoDate } from '../lib/format/date';
import { newestFirst, readingMinutes, summaryRepeatsOpening, toIndexItem, type IndexItem, type Listable, type PostExtras } from '../lib/content/posts';
import { coverFor } from '../components/blocks/PostIndex/covers';
import PostCover from '../components/blocks/PostIndex/PostCover.astro';
import { POST_TOPIC_LABELS } from '../schemas/constants';

/**
 * Long-form template (spec 7.4 GuidePage): byline, table of contents, body, FAQ, curated links.
 * Posts (spec 5.19) add the topic, the reading time beside the date, the summary and a labelled link to
 * the landing page that owns the post. Markdown tables in every family render through PostTable, which
 * stacks them into cards below 640px.
 */
interface Props {
  record: PageRecord;
}
const { record } = Astro.props;
const registry = await getRegistry();
const d = record.data;
const trail = breadcrumbTrail(record, registry);
const jsonLd = await pageGraph(record, trail);
const { Content, headings } = await render(record.entry as never);
// The contents list is generated from the body's headings: each H2, with its H3s nested under it.
const toc: Array<{ slug: string; text: string; children: Array<{ slug: string; text: string }> }> = [];
for (const h of headings) {
  if (h.depth === 2) toc.push({ slug: h.slug, text: h.text, children: [] });
  else if (h.depth === 3 && toc.length) toc[toc.length - 1].children.push({ slug: h.slug, text: h.text });
}
const countryId = d.country?.id;
const site = (await getEntry('site', 'site'))!.data;
const countryData = countryId ? (await getEntry('countries', countryId))?.data : undefined;
const whatsappText = d.ctas.whatsapp ?? `Hi, I was reading Easy Clinic's ${record.family === 'post' ? 'post' : 'guide'} "${record.label}" and would like a demo.`;
const whatsappHref = `https://wa.me/${countryData?.contact.whatsapp ?? site.whatsapp}?text=${encodeURIComponent(whatsappText)}`;
const minutes = readingMinutes(record.entry.body, record.family);

// Posts only.
const post = record.family === 'post' ? (d as typeof d & PostExtras) : null;
const eyebrow = d.eyebrow ?? (post ? POST_TOPIC_LABELS[post.topic] : undefined);
const summary = post && d.summary && !summaryRepeatsOpening(d.summary, d.openingAnswer) ? d.summary : null;
// The owning landing page, linked only when it is rendered in this stage (production: published).
const ownerRecord = post ? registry.get(post.owner.split('#')[0]) : undefined;
const ownerHref = post && ownerRecord ? registry.urlFor(post.owner) : null;

// Posts and guides read as an article in the header's 1440px frame: title, cover and text in the main column, with
// the contents and the newest guides in a sticky sidebar from 1200px. Legal pages stay one centred column.
const hasToc = toc.length >= 2;
const self = record.family === 'legal' ? null : toIndexItem(record as unknown as Listable);
const cover = self ? coverFor(self) : null;
const recent = self
  ? registry.visible
      .map((r) => toIndexItem(r as unknown as Listable))
      .filter((item): item is IndexItem => item !== null && item.path !== record.path)
      .sort(newestFirst)
      .slice(0, 4)
  : [];
const sidebar = record.family !== 'legal' && (hasToc || recent.length > 0);
---

<BaseLayout
  title={d.title}
  description={d.metaDescription}
  path={record.path}
  canonical={d.canonical}
  indexable={record.indexable}
  jsonLd={jsonLd}
  ogType="article"
  modifiedTime={d.lastUpdated}
  country={countryId}
  family={record.family}
  whatsappText={whatsappText}
  preview={{ status: record.status, issues: record.issues }}
>
  <Breadcrumbs trail={trail} />
  <div class:list={['py-8 md:py-12', sidebar ? 'container-page lg:grid lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16' : 'container-measure']}>
    <article class="min-w-0">
      <header>
        {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
        <h1 class="[text-wrap:balance]">{d.h1}</h1>
        {
          record.family === 'legal' ? (
            <p class="mt-4 text-sm text-ink-muted">
              Last reviewed <time datetime={d.lastUpdated?.toISOString().slice(0, 10)}>{d.lastUpdated && formatDate(d.lastUpdated)}</time>
            </p>
          ) : (
            <div class="mt-4 text-sm text-ink-muted sm:flex sm:flex-wrap sm:items-baseline sm:gap-x-1.5">
              <AuthorByline author={d.author} reviewedBy={d.reviewedBy} lastUpdated={d.lastUpdated} />
              <p>
                <span aria-hidden="true" class="hidden sm:inline">·</span> {minutes} minute read
              </p>
            </div>
          )
        }
        {cover && <PostCover cover={cover} sizes="(min-width: 75rem) 760px, 100vw" priority class="mt-8 rounded-card" />}
        <Md text={d.openingAnswer} class="lede mt-8" />
        {record.family !== 'legal' && <div class="mt-6"><Button {...d.ctas.primary} variant="cta" /></div>}
      </header>

      {
        summary && (
          <aside aria-labelledby="summary-heading" class="mt-10 rounded-card bg-surface-alt p-5 md:p-6">
            <h2 id="summary-heading" class="font-sans text-base font-semibold">In short</h2>
            <p class="mt-2">{summary}</p>
          </aside>
        )
      }
      {
        hasToc && (
          <nav aria-labelledby="toc-heading-inline" class:list={['toc-inline mt-10 rounded-card border border-line', sidebar && 'lg:hidden']}>
            <details open>
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-5 py-2">
                <h2 id="toc-heading-inline" class="font-sans text-base font-semibold">On this page</h2>
                <span class="toc-chevron text-ink-muted" aria-hidden="true">⌄</span>
              </summary>
              <ol class="list-decimal px-5 pb-4 pl-10">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="link-plain inline-flex min-h-11 items-center py-1">{h.text}</a>
                    {h.children.length > 0 && (
                      <ul class="mb-1 pl-1">
                        {h.children.map((c) => (
                          <li><a href={`#${c.slug}`} class="link-plain inline-flex min-h-11 items-center py-1 text-ink-muted">{c.text}</a></li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )
      }
      <div class:list={['guide-body prose-md mt-10 text-lg leading-relaxed', post && 'post-body']}>
        <Content components={{ InlineCta, a: Link, table: PostTable }} />
      </div>
      {
        ownerRecord && ownerHref && (
          <aside aria-labelledby="owner-heading" class="card mt-12 p-5 md:p-6">
            <p id="owner-heading" class="eyebrow">This post is part of</p>
            <p class="mt-2 font-sans text-lg font-semibold leading-snug">
              <a href={ownerHref}>{ownerRecord.label}</a>
            </p>
            {ownerRecord.data.summary && <p class="mt-1 text-ink-muted">{ownerRecord.data.summary}</p>}
          </aside>
        )
      }
    </article>

    {
      sidebar && (
        <aside aria-label="More from the blog" class="hidden lg:block">
          <div class="sticky top-24 space-y-10">
            {hasToc && (
              <nav aria-labelledby="toc-heading" data-toc>
                <h2 id="toc-heading" class="font-sans text-base font-semibold">On this page</h2>
                <ol class="mt-3 max-h-[calc(100dvh-16rem)] space-y-0.5 overflow-y-auto border-l border-line text-sm">
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class="toc-link link-plain -ml-px block border-l-2 border-transparent py-1.5 pl-3 leading-snug text-ink-muted">{h.text}</a>
                      {h.children.length > 0 && (
                        <ol class="space-y-0.5">
                          {h.children.map((c) => (
                            <li><a href={`#${c.slug}`} class="toc-link link-plain -ml-px block border-l-2 border-transparent py-1 pl-6 text-[0.8125rem] leading-snug text-ink-muted">{c.text}</a></li>
                          ))}
                        </ol>
                      )}
                    </li>
                  ))}
                </ol>
              </nav>
            )}
            {recent.length > 0 && (
              <section aria-labelledby="recent-heading">
                <h2 id="recent-heading" class="font-sans text-base font-semibold">Recent guides</h2>
                <ul class="mt-4 space-y-5">
                  {recent.map((item) => (
                    <li class="card-link relative flex gap-3">
                      <PostCover cover={coverFor(item)} sizes="96px" class="w-24 shrink-0 rounded-control" />
                      <div class="min-w-0">
                        <a href={registry.urlFor(item.path) ?? item.path} class="card-link-title link-plain line-clamp-3 text-sm font-semibold leading-snug text-ink-heading after:absolute after:inset-0">
                          {item.title}
                        </a>
                        {item.date && <time datetime={isoDate(item.date)} class="mt-1 block text-xs text-ink-muted">{formatDate(item.date)}</time>}
                      </div>
                    </li>
                  ))}
                </ul>
                <a href="/blog/" class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold">See all guides</a>
              </section>
            )}
          </div>
        </aside>
      )
    }
  </div>
  {
    /* Posts end with the article and its sidebar; guides and legal pages keep their sections, FAQ and links. */
    !post && (
      <>
        <Sections sections={d.sections} ctx={{ path: record.path, family: record.family, status: record.status, country: countryId, pageLabel: record.label, whatsappHref }} />
        <FAQ heading={d.faqHeading} items={d.faq} tone="wash" />
        <RelatedLinks heading={d.links.relatedHeading} links={d.links.related} />
        {d.closing && <CTABand closing={d.closing} whatsappHref={whatsappHref} />}
      </>
    )
  }
</BaseLayout>

<script>
  // Marks the contents entry for the section in view. Without JavaScript the list still links every section.
  const nav = document.querySelector('[data-toc]');
  if (nav && 'IntersectionObserver' in window) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((el): el is HTMLElement => el !== null);
    const mark = (id: string) => links.forEach((a) => a.setAttribute('aria-current', String(decodeURIComponent(a.hash.slice(1)) === id)));
    const seen = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) (e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id));
        const current = targets.find((t) => seen.has(t.id)) ?? [...targets].reverse().find((t) => t.getBoundingClientRect().top < 120);
        if (current) mark(current.id);
      },
      { rootMargin: '-80px 0px -60% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .guide-body :global(h2) {
    margin-top: 2.5rem;
    font-size: var(--text-2xl);
    scroll-margin-top: 5rem;
  }
  .guide-body :global(h3) {
    margin-top: 1.75rem;
    font-size: var(--text-xl);
    scroll-margin-top: 5rem;
  }
  /* Contents: smooth jumps unless the reader prefers less motion; the section in view is marked. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has([data-toc])) {
      scroll-behavior: smooth;
    }
  }
  .toc-link[aria-current='true'] {
    border-left-color: var(--link);
    color: var(--ink-heading);
    font-weight: 600;
  }
  .toc-inline summary::-webkit-details-marker {
    display: none;
  }
  .toc-inline details:not([open]) .toc-chevron {
    transform: rotate(-90deg);
  }
  /* Markdown tables in every family. Below 640px PostTable stacks the rows into cards
     (components/mdx/PostTable.astro, docs/components.md rule 3), so nothing scrolls sideways. */
  .guide-body :global(table) {
    width: 100%;
    font-size: var(--text-sm);
    border: 1px solid var(--border);
  }
  .guide-body :global(th),
  .guide-body :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .guide-body :global(th) {
    background: var(--surface-muted);
  }
  /* Posts: long words and pasted URLs wrap instead of widening the page. */
  .post-body {
    overflow-wrap: break-word;
  }
</style>

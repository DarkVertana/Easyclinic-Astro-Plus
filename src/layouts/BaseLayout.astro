---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import { PUBLIC_GA4_ID } from 'astro:env/client';
import SEO from '../components/chrome/SEO.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import WhatsAppButton from '../components/chrome/WhatsAppButton.astro';
import PreviewToolbar from '../components/chrome/PreviewToolbar.astro';
import Analytics from '../components/chrome/Analytics.astro';
import { isProduction } from '../lib/content/stage';
import type { Issue } from '../lib/rules/audit';

interface Props {
  title: string;
  description: string;
  path: string;
  indexable: boolean;
  canonical?: string;
  jsonLd?: Record<string, unknown> | null;
  ogType?: 'website' | 'article';
  modifiedTime?: Date | null;
  /** Country id (in, ke, ae, ng) for WhatsApp routing and the local demo page. */
  country?: string;
  family?: string;
  /** Prefilled WhatsApp message naming this page (spec 7.9). */
  whatsappText?: string;
  preview?: { status: string; issues: Issue[] };
  /** Load GA immediately (confirmation and 404 pages, where the event is the point of the visit). */
  analyticsImmediate?: boolean;
}

const { title, description, path, indexable, canonical, jsonLd, ogType, modifiedTime, country, family, whatsappText, preview, analyticsImmediate = false } =
  Astro.props;
const site = (await getEntry('site', 'site'))!.data;
const countryData = country ? (await getEntry('countries', country))?.data : undefined;
const whatsappNumber = countryData?.contact.whatsapp ?? site.whatsapp;
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappText ?? `Hi, I was reading about EasyClinic on your website and would like a demo.`)}`;
---

<!doctype html>
<html lang="en" data-ga={PUBLIC_GA4_ID} data-canonical-host={site.canonicalHost} data-ga-immediate={String(analyticsImmediate)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Preload only the Latin files the first paint needs. -->
    <Font cssVariable="--font-inter" preload={[{ subset: 'latin', weight: '400' }]} />
    <Font cssVariable="--font-fraunces" preload={[{ subset: 'latin', weight: '600' }]} />
    <SEO title={title} description={description} path={path} canonical={canonical} indexable={indexable} jsonLd={jsonLd} ogType={ogType} modifiedTime={modifiedTime} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a2540" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-family={family} data-country={country} class="min-h-dvh">
    <a href="#main" class="sr-only-focusable fixed left-4 top-4 z-[60] rounded-control bg-navy-900 px-4 py-3 font-semibold text-white">Skip to content</a>
    <Header country={country} whatsappHref={whatsappHref} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton href={whatsappHref} />
    {!isProduction && preview && <PreviewToolbar status={preview.status} issues={preview.issues} path={path} />}
    <Analytics />
  </body>
</html>

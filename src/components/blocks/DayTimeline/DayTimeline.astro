---
import type { SectionValue } from '../../../schemas/sections';
import { getRegistry } from '../../../lib/content/registry';
import { need } from '../../../lib/content/need';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'dayTimeline'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, beforeLabel, afterLabel, entries, ctx } = Astro.props;
const sectionTone = toneFor(tone, ctx.index);
const inverse = sectionTone === 'inverse';

const registry = await getRegistry();

/*
 * Spec 5.5, "A Tuesday with and without Easy Clinic": a timed vertical timeline. Each entry is a list
 * item whose h3 starts with its <time>, followed by the two versions of that moment as a description
 * list (label, text), so every "before" and "after" is labelled for screen readers at every width.
 *
 * The two versions share one card: "before" muted, "after" tinted with the journey teal, split by a
 * hairline. Phones and tablets: one column, the teal journey line down the left through a dot at each
 * time, "before" stacked above "after", each with its own label.
 * 60rem and up: time column | card (before | after). The times sit in solid pills on the line, the two
 * lanes are headed once at the top with chips (a visual repeat of the per-entry labels, which become
 * visually hidden). When no entry has a "before", "after" takes the full width and keeps its label.
 */
const lanes = entries.some((entry) => entry.before) ? 2 : 1;

const items = entries.map((entry) => {
  const [hours, minutes] = entry.time.split(':').map(Number);
  // The schema checks the shape (H:MM or HH:MM); a time such as 25:10 is still a content error.
  const valid = hours <= 23 && minutes <= 59;
  return {
    ...entry,
    // A valid time string for <time datetime> needs two-digit hours.
    datetime: valid ? entry.time.padStart(5, '0') : null,
    timeError: valid ? null : need(Astro, `a 24-hour time for "${entry.title}" (${entry.time} is not one)`, null),
    url: entry.href ? registry.urlFor(entry.href) : null,
  };
});
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={sectionTone}>
  <div class="dtl-wrap">
    {
      lanes === 2 && (
        <div class="dtl-lanes" aria-hidden="true">
          <p class="dtl-chip dtl-chip--before">
            <Icon name="circle-x" size={16} />
            <span>{beforeLabel}</span>
          </p>
          <p class="dtl-chip dtl-chip--after">
            <Icon name="circle-check" size={16} />
            <span>{afterLabel}</span>
          </p>
        </div>
      )
    }
    <ol role="list" class="dtl" data-lanes={lanes}>
      {
        items.map((item) => (
          <li class="dtl-entry">
            <h3 class:list={['font-display text-lg font-semibold leading-snug', inverse ? 'text-white' : 'text-ink-heading']}>
              {item.datetime ? (
                <time datetime={item.datetime} class="dtl-time">
                  {item.time}
                </time>
              ) : (
                <span class="block text-sm font-normal">{item.timeError}</span>
              )}{' '}
              {item.url ? (
                <a href={item.url} class:list={['dtl-link group', inverse ? 'text-white hover:text-blue-200' : 'text-ink-heading hover:text-link']}>
                  <span>{item.title}</span>
                  <Icon name="arrow-right" size={18} class="text-teal-700 transition-transform group-hover:translate-x-0.5" />
                </a>
              ) : (
                <span>{item.title}</span>
              )}
            </h3>
            <dl class="dtl-compare">
              {item.before && (
                <div class="dtl-card dtl-before">
                  <dt class:list={['dtl-label', lanes === 2 && 'md:sr-only']}>
                    <Icon name="circle-x" size={15} />
                    <span>{beforeLabel}</span>
                  </dt>
                  <dd>
                    <Md text={item.before} />
                  </dd>
                </div>
              )}
              <div class="dtl-card dtl-after">
                <dt class:list={['dtl-label', lanes === 2 && 'md:sr-only']}>
                  <Icon name="circle-check" size={15} />
                  <span>{afterLabel}</span>
                </dt>
                <dd>
                  <Md text={item.after} />
                </dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  .dtl-wrap {
    --dot: 0.875rem; /* the dot on the line, phones and tablets */
    --dot-y: 0.1875rem; /* dot top: centred on the first line of the time (text-sm, 1.25rem line) */
    --rail: 1.75rem; /* width taken by the line and dot */
    --after-bg: color-mix(in srgb, var(--journey) 7%, var(--surface));
  }

  .dtl {
    position: relative;
    isolation: isolate;
  }

  .dtl-entry {
    position: relative;
    padding-left: var(--rail);
    padding-bottom: 2.25rem;
  }
  .dtl-entry:last-child {
    padding-bottom: 0;
  }

  /* The line: from this entry's marker to the next one's. Decoration only. */
  .dtl-entry:not(:last-child)::before {
    content: '';
    position: absolute;
    top: calc(var(--dot-y) + var(--dot) / 2);
    bottom: calc(-1 * (var(--dot-y) + var(--dot) / 2));
    left: calc(var(--dot) / 2 - 1px);
    border-left: 2px solid color-mix(in srgb, var(--journey) 45%, transparent);
    pointer-events: none;
  }

  .dtl-time {
    display: block;
    width: fit-content;
    margin-bottom: 0.25rem;
    color: var(--color-teal-700);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.25rem;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  /* The dot, positioned against the entry: a solid teal disc with a soft halo. */
  .dtl-time::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: var(--dot-y);
    left: 0;
    width: var(--dot);
    height: var(--dot);
    border-radius: 9999px;
    background: var(--journey);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--journey) 18%, var(--surface));
  }

  .dtl-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
  }
  .dtl-link:hover > span {
    text-decoration: underline;
    text-decoration-color: var(--journey);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* Before and after share one card: muted above (or left), teal-tinted below (or right). */
  .dtl-compare {
    display: grid;
    margin-top: 0.875rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow:
      0 1px 2px rgb(16 24 40 / 0.04),
      0 6px 18px -8px rgb(16 24 40 / 0.1);
  }
  .dtl-card {
    padding: 1.125rem 1.375rem;
    line-height: 1.65;
  }
  .dtl-card > dd {
    margin-top: 0.5rem;
  }
  .dtl-before {
    background: var(--surface-muted);
    color: var(--ink-muted);
  }
  .dtl-after {
    background: var(--after-bg);
    color: var(--ink);
  }
  .dtl-before + .dtl-after {
    border-top: 1px solid var(--line);
  }
  .dtl-label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dtl-after .dtl-label {
    color: var(--color-teal-700);
  }
  /* Markdown inside the cards keeps dark ink on inverse sections (the cards stay light). */
  .dtl-card :global(.prose-md strong) {
    color: var(--ink-heading);
  }
  .dtl-card :global(.prose-md a) {
    color: var(--link);
  }

  .dtl-lanes {
    display: none;
  }
  .dtl-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.4rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dtl-chip--before {
    border: 1px solid var(--line);
    background: var(--surface-muted);
    color: var(--ink-muted);
  }
  .dtl-chip--after {
    border: 1px solid color-mix(in srgb, var(--journey) 35%, transparent);
    background: var(--after-bg);
    color: var(--color-teal-700);
  }

  @media (width >= 60rem) {
    .dtl-wrap {
      --timecol: 5.5rem;
      --gap: 1.5rem;
      --pill: 2rem; /* pill height */
      --pill-y: -0.125rem; /* pill top: centred on the h3's first line */
    }

    .dtl-lanes {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 1.25rem;
      padding-left: calc(var(--timecol) + var(--gap));
    }
    .dtl-chip {
      margin-left: 1.5rem;
    }

    .dtl-entry {
      padding-left: calc(var(--timecol) + var(--gap));
      padding-bottom: 2.75rem;
    }
    .dtl-entry:not(:last-child)::before {
      top: calc(var(--pill-y) + var(--pill) / 2);
      bottom: calc(-1 * (var(--pill-y) + var(--pill) / 2));
      left: calc(var(--timecol) / 2 - 1px);
    }

    /* The time moves into its own column, as a solid pill on the line. */
    .dtl-time {
      position: absolute;
      z-index: 1;
      top: var(--pill-y);
      left: calc(var(--timecol) / 2);
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 4.5rem;
      height: var(--pill);
      margin: 0;
      padding-inline: 0.75rem;
      border-radius: 9999px;
      background: var(--color-teal-700);
      color: #fff;
      box-shadow: 0 0 0 4px var(--surface);
    }
    .dtl-time::before {
      content: none;
    }

    .dtl[data-lanes='2'] .dtl-compare {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .dtl[data-lanes='2'] .dtl-after {
      grid-column: 2;
    }
    .dtl[data-lanes='2'] .dtl-before + .dtl-after {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
    .dtl[data-lanes='2'] .dtl-card {
      padding: 1.375rem 1.5rem;
    }
    .dtl[data-lanes='2'] .dtl-card > dd {
      margin-top: 0;
    }
  }
</style>

---
import type { SectionValue } from '../../../schemas/sections';
import Md from '../../ui/Md.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'statBand'> & { ctx: BlockContext };
const { id, eyebrow, heading, tone, body, stats, note, ctx } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
const toneClass = { plain: 'bg-surface', wash: 'bg-surface-alt', inverse: 'bg-surface-inverse' }[toneFor(tone, ctx.index)];
---

{/* The heading beside its paragraph from 960px (stacked below that), then the figures in one bordered panel with
    hairline dividers: four across from 960px, two by two below that. */}
<section id={id} aria-labelledby={heading ? headingId : undefined} class:list={['section-y', toneClass]}>
  <div class="container-page">
    <div class="grid gap-6 md:grid-cols-2 md:items-center md:gap-16">
      <div>
        {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
        {heading && <h2 id={headingId}>{heading}</h2>}
      </div>
      {body && <Md text={body} class="text-[1.0625rem] leading-relaxed text-ink-muted sm:text-lg" />}
    </div>

    <dl class="stat-panel mt-10 grid grid-cols-2 overflow-hidden rounded-2xl border border-line bg-surface md:mt-14 md:grid-cols-4">
      {
        stats.map((s) => (
          <div class="stat-cell flex flex-col gap-2 p-5 sm:p-7">
            <dt class="order-last text-sm leading-relaxed text-ink-muted sm:text-[0.9375rem]">{s.label}</dt>
            <dd class="m-0 font-display text-4xl leading-none font-semibold text-blue-600 sm:text-5xl">
              <Md text={s.value} inline />
            </dd>
          </div>
        ))
      }
    </dl>
    {note && <Md text={note} class="mt-4 text-sm text-ink-muted" />}
  </div>
</section>

<style>
  .stat-panel {
    box-shadow: 0 16px 40px -28px rgb(10 37 64 / 0.35);
  }
  /* Hairlines between cells: on the left of each but the first in its row, and above the second row (phones). */
  .stat-cell + .stat-cell {
    border-left: 1px solid var(--color-line);
  }
  .stat-cell:nth-child(odd) {
    border-left: 0;
  }
  .stat-cell:nth-child(n + 3) {
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 60rem) {
    .stat-cell:nth-child(odd):not(:first-child) {
      border-left: 1px solid var(--color-line);
    }
    .stat-cell:nth-child(n + 3) {
      border-top: 0;
    }
  }
</style>

---
import { getEntry } from 'astro:content';
import type { SectionValue } from '../../../schemas/sections';
import { optional } from '../../../lib/content/need';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'addOns'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, currency, ctx } = Astro.props;

const plans = (await getEntry('plans', 'plans'))?.data;
if (!plans) throw new Error(`addOns on ${ctx.path}: src/data/plans.yaml is missing`);
const price = (await getEntry(currency))?.data;
if (!price) throw new Error(`addOns on ${ctx.path}: no price entry "${currency.id}"`);

const planName = new Map(plans.plans.map((p) => [p.id, p.name]));

// Indicative prices or ranges from the currency's price file, never "quoted separately" (spec 5.12 item 4).
const addons = plans.addons.map((addon) => {
  const value = price.addons[addon.id] ?? null;
  return {
    ...addon,
    known: value !== null,
    price: optional(`${price.currency} ${addon.name} add-on price`, value),
    availableOn: addon.availableOn.map((id) => ({ id, name: planName.get(id) ?? id })),
  };
});

// Each module's icon and accent; a module not listed here falls back to the first look.
const LOOK: Record<string, { icon: string; tile: string }> = {
  pharmacy: { icon: 'pill', tile: 'bg-teal-50 text-teal-700' },
  lab: { icon: 'flask-conical', tile: 'bg-blue-50 text-blue-700' },
  claims: { icon: 'receipt', tile: 'bg-amber-100 text-[#a56a00]' },
  integrations: { icon: 'network', tile: 'bg-[#efe9fb] text-[#6a4fc0]' },
};
// The plan badges from the pricing cards.
const PLAN_BADGE: Record<string, { icon: string; bg: string; fill: boolean }> = {
  professional: { icon: 'star', bg: 'bg-[#c9cbd1]', fill: true },
  premium: { icon: 'crown', bg: 'bg-[#fbb917]', fill: true },
  enterprise: { icon: 'gem', bg: 'bg-[#8b6fd6]', fill: false },
};
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={toneFor(tone, ctx.index)}>
  <ul class:list={['grid gap-6', addons.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : addons.length === 2 ? 'md:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3']}>
    {
      addons.map((a) => {
        const look = LOOK[a.id] ?? LOOK.pharmacy;
        return (
          <li class="flex flex-col rounded-2xl border border-line bg-surface p-6 text-ink shadow-[0_10px_30px_-18px_rgb(10_37_64/0.25)] transition duration-200 hover:-translate-y-1 hover:shadow-[0_22px_44px_-20px_rgb(10_37_64/0.35)]">
            <div class="flex items-start justify-between gap-3">
              <span class:list={['flex size-12 items-center justify-center rounded-xl', look.tile]} aria-hidden="true">
                <Icon name={look.icon} size={24} />
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-surface-muted px-2.5 py-1 text-xs font-semibold text-ink-heading">
                <Icon name="plus" size={12} />
                Add-on
              </span>
            </div>
            <h3 class="mt-5 font-display text-lg leading-snug font-semibold text-ink-heading">{a.name}</h3>
            {a.price && <p class:list={['mt-2', a.known ? 'font-display text-xl font-semibold text-ink-heading' : 'text-sm']}>{a.price}</p>}
            <Md text={a.body} class="mt-3 text-[0.9375rem] leading-relaxed text-ink-muted" />
            <div class="mt-auto pt-6">
              <p class="border-t border-line pt-4 text-xs font-semibold tracking-wide text-ink-muted uppercase">Available on</p>
              <ul class="mt-2 flex flex-wrap gap-1.5">
                {a.availableOn.map((p) => {
                  const badge = PLAN_BADGE[p.id];
                  return (
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-surface-muted py-1 pr-2.5 pl-1 text-xs font-semibold text-ink-heading">
                      {badge && (
                        <span class:list={['flex size-4 items-center justify-center rounded-[5px] text-white', badge.bg]} aria-hidden="true">
                          <Icon name={badge.icon} size={10} class={badge.fill ? 'fill-white' : undefined} />
                        </span>
                      )}
                      {p.name}
                    </li>
                  );
                })}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ul>
</Section>

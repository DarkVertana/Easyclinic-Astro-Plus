---
import { getEntry } from 'astro:content';
import type { SectionValue } from '../../../schemas/sections';
import { PLAN_IDS, type PlanId } from '../../../schemas/constants';
import { getRegistry } from '../../../lib/content/registry';
import { need } from '../../../lib/content/need';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import Icon from '../../ui/Icon.astro';
import Button from '../../ui/Button.astro';
import Screenshot from '../../ui/Screenshot.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'featureRows'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, items, layout = 'auto', wideIntro = false, ctx } = Astro.props;
const sectionTone = toneFor(tone, ctx.index);
const inverse = sectionTone === 'inverse';

const registry = await getRegistry();
const plans = (await getEntry('plans', 'plans'))!.data.plans;

// Plan names come from plans.yaml; the top plan of the ladder has nothing "above" it.
function planTag(planId: PlanId): string {
  const name = need(Astro, `${planId} plan name in plans.yaml`, plans.find((p) => p.id === planId)?.name);
  return PLAN_IDS.indexOf(planId) === PLAN_IDS.length - 1 ? `Included in ${name}` : `Included in ${name} and above`;
}

// Media alternates right, left, right on wide screens, counting only rows that have media.
let mediaCount = 0;
const rows = items.map((item) => ({
  ...item,
  tag: item.plan ? planTag(item.plan) : null,
  flip: item.media ? mediaCount++ % 2 === 1 : false,
  showLink: Boolean(item.link && registry.urlFor(item.link.href)),
  linkHref: item.link ? registry.urlFor(item.link.href) : undefined,
}));

// With no screenshot to sit beside, full-width rows leave the right side empty, so the section renders as a
// ruled grid: each item sits under a top rule, with no box. Three across only when the count fills whole rows
// and no item carries a bullet list.
const grid = rows.every((row) => !row.media);
const threeUp = rows.length % 3 === 0 && rows.every((row) => row.bullets.length === 0);
// Exactly three items with no media: one panel split into three columns by rules, each with its checklist.
const panel = grid && rows.length === 3;
// In the card grid, a plan tag every card shares is left off the cards (the intro already names the plan).
// Bento: a six-column grid on wide screens. Cards span two columns (three across); when the last row would be
// short, its cards widen to fill it (two cards span three each, one card spans all six). On tablets, two across,
// with an odd last card spanning both.
const bentoSpan = (i: number, n: number) => {
  const rest = n % 3;
  const inLast = i >= n - rest;
  const lg = !inLast || rest === 0 ? 'lg:col-span-2' : rest === 2 ? 'lg:col-span-3' : 'lg:col-span-6';
  const sm = n % 2 === 1 && i === n - 1 ? 'sm:col-span-2' : '';
  return `${lg} ${sm}`;
};
// Bento: icon tiles cycle through the brand tints.
const BENTO_TINTS = [{ tile: 'bg-blue-50 text-blue-700' }, { tile: 'bg-teal-50 text-teal-700' }, { tile: 'bg-green-50 text-green-700' }];
const sharedTag = rows.length > 1 && rows.every((row) => row.tag && row.tag === rows[0].tag) ? rows[0].tag : null;
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={sectionTone} wideHeader={wideIntro}>
  {layout === 'list' ? (
    // Ruled rows, no boxes. Wide screens: number and heading | text, bullets and link. Below lg each row stacks
    // heading, then text. No plan badge (owner request 2026-10-30).
    <ol role="list" class:list={['border-t', inverse ? 'border-white/15' : 'border-line']}>
      {rows.map((row, i) => (
        <li class:list={['grid gap-3 border-b py-7 sm:py-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-start lg:gap-10 xl:gap-14', inverse ? 'border-white/15' : 'border-line']}>
          <div class="flex items-start gap-4">
            {row.icon ? (
              // With an icon: a tinted tile carrying the icon, the number above the heading.
              <span class:list={['grid size-12 shrink-0 place-items-center rounded-2xl', inverse ? 'bg-white/10 text-teal-500' : sectionTone === 'wash' ? 'bg-surface text-blue-600 shadow-[0_6px_16px_-8px_rgb(10_37_64/0.3)]' : 'bg-blue-50 text-blue-600']} aria-hidden="true">
                <Icon name={row.icon} size={24} />
              </span>
            ) : (
              <span class:list={['mt-0.5 font-display text-sm font-semibold tabular-nums', inverse ? 'text-teal-500' : 'text-blue-600']} aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            )}
            <div class="min-w-0">
              {row.icon && (
                <span class:list={['mb-1 block font-display text-sm font-semibold tabular-nums', inverse ? 'text-teal-500' : 'text-blue-600']} aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              )}
              <h3 class:list={['text-xl leading-snug sm:text-[1.375rem]', inverse && '!text-white']}>{row.heading}</h3>
            </div>
          </div>
          <div class:list={[row.icon ? 'pl-16 lg:pl-0' : 'pl-8 lg:pl-0']}>
            <Md text={row.body} class:list={['text-base leading-relaxed sm:text-[1.0625rem]', inverse ? 'text-ink-inverse-muted' : 'text-ink-muted']} />
            {row.bullets.length > 0 && (
              <ul role="list" class="mt-3 grid gap-2">
                {row.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-[0.9375rem] leading-snug">
                    <span class="mt-px grid size-[18px] shrink-0 place-items-center rounded-full bg-[#00c554] text-white" aria-hidden="true">
                      <Icon name="check" size={12} />
                    </span>
                    <span class:list={[inverse ? 'text-ink-inverse-muted' : 'text-ink']}>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
            {row.showLink && row.link && (
              <p class="mt-4">
                {/* Inline, so a label that wraps keeps its arrow after the last word. */}
                <a href={row.linkHref} class:list={['group text-[0.9375rem] font-semibold no-underline hover:underline', inverse && '!text-white']} data-track="cta_click" data-label={row.link.label}>
                  {row.link.label}
                  <Icon name="arrow-right" size={14} class="ml-1 inline align-[-2px] transition-transform group-hover:translate-x-0.5" />
                </a>
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  ) : panel ? (
    <ul
      role="list"
      class:list={[
        'grid overflow-hidden rounded-[1.25rem] border lg:grid-cols-3',
        inverse ? 'divide-y divide-white/15 border-white/15 bg-white/5 lg:divide-x lg:divide-y-0' : 'divide-y divide-line border-line bg-surface shadow-[0_1px_2px_rgb(10_37_64/0.04),0_12px_32px_-16px_rgb(10_37_64/0.14)] lg:divide-x lg:divide-y-0',
      ]}
    >
      {rows.map((row) => (
        <li class="flex flex-col p-7 sm:p-8">
          {row.icon && (
            <span class:list={['mb-6 flex size-11 items-center justify-center rounded-xl border', inverse ? 'border-white/20 text-teal-500' : 'border-line bg-surface text-blue-700 shadow-[0_1px_2px_rgb(10_37_64/0.06),0_6px_14px_-6px_rgb(10_37_64/0.18)]']}>
              <Icon name={row.icon} size={20} />
            </span>
          )}
          <h3 class:list={['text-xl leading-snug', inverse && '!text-white']}>{row.heading}</h3>
          {row.tag && <p class:list={['mt-1 text-sm font-medium', inverse ? 'text-teal-500' : 'text-teal-700']}>{row.tag}</p>}
          <Md text={row.body} class:list={['mt-2.5 text-[0.9375rem] leading-relaxed', inverse ? 'text-ink-inverse-muted' : 'text-ink-muted']} />
          {row.bullets.length > 0 && (
            <ul role="list" class:list={['mt-6 grid gap-3 border-t pt-6', inverse ? 'border-white/15' : 'border-line']}>
              {row.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5 text-[0.9375rem] leading-snug">
                  <span class:list={['mt-0.5 flex size-[18px] shrink-0 items-center justify-center rounded-full', inverse ? 'bg-white/10 text-teal-500' : 'bg-blue-50 text-blue-700']}>
                    <Icon name="check" size={12} />
                  </span>
                  <span class:list={[inverse && 'text-ink-inverse-muted']}>{bullet}</span>
                </li>
              ))}
            </ul>
          )}
          {row.showLink && row.link && (
            <a href={row.linkHref} class:list={['group mt-auto inline-flex items-center gap-1 pt-6 text-sm font-semibold no-underline hover:underline', inverse && '!text-white']} data-track="cta_click" data-label={row.link.label}>
              {row.link.label}
              <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
            </a>
          )}
        </li>
      ))}
    </ul>
  ) : layout === 'grid' ? (
    // Two across from md, split by hairlines instead of boxes: a rule between the columns and between the rows.
    // Each cell: icon tile and plan tag, heading, text, then its link held to the bottom so the row lines up.
    <ul role="list" class:list={['grid border-t md:grid-cols-2', inverse ? 'border-white/15' : 'border-line']}>
      {rows.map((row, i) => (
        <li
          class:list={[
            'flex flex-col border-b py-8 md:py-10',
            i % 2 === 0 ? 'md:border-r md:pr-10 lg:pr-14' : 'md:pl-10 lg:pl-14',
            inverse ? 'border-white/15' : 'border-line',
          ]}
        >
          <div class="flex items-center justify-between gap-4">
            <span
              class:list={[
                'grid size-12 shrink-0 place-items-center rounded-2xl',
                inverse ? 'bg-white/10 text-teal-500' : sectionTone === 'wash' ? 'bg-surface text-blue-700 shadow-[0_6px_16px_-8px_rgb(10_37_64/0.3)]' : BENTO_TINTS[i % BENTO_TINTS.length].tile,
              ]}
              aria-hidden="true"
            >
              <Icon name={row.icon ?? 'circle-check'} size={24} />
            </span>
            {row.tag && (
              <span class:list={['rounded-full border px-3 py-1 text-xs font-semibold', inverse ? 'border-white/20 text-teal-500' : 'border-teal-500/40 bg-surface text-teal-700']}>
                {row.tag}
              </span>
            )}
          </div>
          <h3 class:list={['mt-5 text-xl leading-snug sm:text-[1.375rem]', inverse && '!text-white']}>{row.heading}</h3>
          <Md text={row.body} class:list={['mt-3 text-base leading-relaxed sm:text-[1.0625rem]', inverse ? 'text-ink-inverse-muted' : 'text-ink-muted']} />
          {row.bullets.length > 0 && (
            <ul role="list" class="mt-4 grid gap-2">
              {row.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5 text-[0.9375rem] leading-snug">
                  <span class="mt-px grid size-[18px] shrink-0 place-items-center rounded-full bg-[#00c554] text-white" aria-hidden="true">
                    <Icon name="check" size={12} />
                  </span>
                  <span class:list={[inverse ? 'text-ink-inverse-muted' : 'text-ink']}>{bullet}</span>
                </li>
              ))}
            </ul>
          )}
          {row.showLink && row.link && (
            <p class="mt-auto pt-5">
              <a href={row.linkHref} class:list={['group text-[0.9375rem] font-semibold no-underline hover:underline', inverse && '!text-white']} data-track="cta_click" data-label={row.link.label}>
                {row.link.label}
                <Icon name="arrow-right" size={14} class="ml-1 inline align-[-2px] transition-transform group-hover:translate-x-0.5" />
              </a>
            </p>
          )}
        </li>
      ))}
    </ul>
  ) : layout === 'bento' ? (
    <ul role="list" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-6 lg:gap-6">
      {rows.map((row, i) => {
        const tint = BENTO_TINTS[i % BENTO_TINTS.length];
        return (
          <li
            class:list={[
              'group relative flex flex-col overflow-hidden rounded-[18px] border p-6 transition-[transform,box-shadow,border-color] duration-200 sm:p-7 motion-reduce:transition-none',
              bentoSpan(i, rows.length),
              inverse
                ? 'border-white/15 bg-white/5'
                : 'border-line bg-surface shadow-[0_1px_2px_rgb(10_37_64/0.04),0_14px_34px_-26px_rgb(10_37_64/0.3)] hover:-translate-y-1 hover:border-blue-200 hover:shadow-[0_2px_4px_rgb(10_37_64/0.05),0_24px_48px_-28px_rgb(10_37_64/0.4)] motion-reduce:hover:translate-y-0',
            ]}
          >
            <div class="flex items-center justify-between gap-4">
              <span class:list={['grid size-12 shrink-0 place-items-center rounded-2xl', inverse ? 'bg-white/10 text-teal-500' : tint.tile]} aria-hidden="true">
                <Icon name={row.icon ?? 'circle-check'} size={24} />
              </span>
              <span class:list={['font-display text-3xl font-semibold tabular-nums opacity-15', inverse && 'text-white']} aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <h3 class:list={['mt-5 text-lg leading-snug sm:text-xl', inverse && '!text-white']}>{row.heading}</h3>
            {row.tag && <p class:list={['mt-1 text-sm font-medium', inverse ? 'text-teal-500' : 'text-teal-700']}>{row.tag}</p>}
            <Md text={row.body} class:list={['mt-2.5 text-[0.9375rem] leading-relaxed', inverse ? 'text-ink-inverse-muted' : 'text-ink-muted']} />
            {row.bullets.length > 0 && (
              <ul role="list" class="mt-4 grid gap-2">
                {row.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-[0.9375rem] leading-snug">
                    <span class="mt-px grid size-[18px] shrink-0 place-items-center rounded-full bg-[#00c554] text-white" aria-hidden="true">
                      <Icon name="check" size={12} />
                    </span>
                    <span class:list={[inverse ? 'text-ink-inverse-muted' : 'text-ink']}>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
            {row.showLink && row.link && (
              <p class="mt-auto pt-5">
                <a href={row.linkHref} class:list={['text-[0.9375rem] font-semibold no-underline hover:underline', inverse && '!text-white']} data-track="cta_click" data-label={row.link.label}>
                  {row.link.label}
                  <Icon name="arrow-right" size={14} class="ml-1 inline align-[-2px]" />
                </a>
              </p>
            )}
          </li>
        );
      })}
    </ul>
  ) : grid ? (
    <>
      <ul role="list" class:list={['grid gap-5 sm:grid-cols-2 lg:gap-6', threeUp && 'lg:grid-cols-3']}>
        {rows.map((row) => (
          <li
            class:list={[
              'flex flex-col rounded-card border p-6 sm:p-7',
              inverse ? 'border-white/15 bg-white/5' : 'border-line bg-surface shadow-[0_1px_2px_rgb(10_37_64/0.04),0_10px_28px_-18px_rgb(10_37_64/0.18)]',
            ]}
          >
            <div class="flex items-center gap-3.5">
              {row.icon && (
                <span class:list={['flex size-14 shrink-0 items-center justify-center rounded-2xl', inverse ? 'bg-white/10 text-teal-500' : 'bg-blue-50 text-blue-700']}>
                  <Icon name={row.icon} size={28} />
                </span>
              )}
              <h3 class:list={['text-lg leading-snug lg:text-xl', inverse && '!text-white']}>{row.heading}</h3>
            </div>
            <Md text={row.body} class:list={['mt-4 text-[0.9375rem] leading-relaxed', inverse ? 'text-ink-inverse-muted' : 'text-ink-muted']} />
            {row.bullets.length > 0 && (
              <ul role="list" class="mt-5 grid gap-2.5">
                {row.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-[0.9375rem] leading-snug">
                    <span class:list={['mt-px flex size-[18px] shrink-0 items-center justify-center rounded-full', inverse ? 'bg-white/10 text-teal-500' : 'bg-teal-50 text-teal-700']}>
                      <Icon name="check" size={12} />
                    </span>
                    <span class:list={[inverse ? 'text-ink-inverse-muted' : 'text-ink']}>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
            {((row.tag && !sharedTag) || (row.showLink && row.link)) && (
              <div class:list={['mt-auto pt-6']}>
                <div class:list={['flex flex-wrap items-center justify-between gap-x-5 gap-y-2 border-t pt-4 text-sm', inverse ? 'border-white/15' : 'border-line']}>
                  {row.tag && !sharedTag && (
                    <span class:list={['font-medium', inverse ? 'text-teal-500' : 'text-teal-700']}>{row.tag}</span>
                  )}
                  {row.showLink && row.link && (
                    <a href={row.linkHref} class:list={['group inline-flex items-center gap-1 font-semibold no-underline hover:underline', inverse && '!text-white']} data-track="cta_click" data-label={row.link.label}>
                      {row.link.label}
                      <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
                    </a>
                  )}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </>
  ) : (
  <div class="grid gap-16 md:gap-20">
    {
      rows.map((row) => (
        <div class:list={['grid gap-8', row.media && 'lg:grid-cols-2 lg:items-center lg:gap-14']}>
          <div>
            <div class="max-w-[46rem]">
              <h3 class:list={[inverse && '!text-white']}>{row.heading}</h3>
              {row.tag && (
                <p class="mt-3">
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-muted px-3 py-1 text-sm font-medium text-ink-heading">
                    <Icon name="layers" size={16} class="text-teal-700" />
                    {row.tag}
                  </span>
                </p>
              )}
              <Md text={row.body} class:list={['mt-4', inverse && 'text-ink-inverse-muted']} />
            </div>
            {row.bullets.length > 0 && (
              <ul class:list={['mt-5 grid gap-x-8 gap-y-2.5', !row.media && 'sm:grid-cols-2']}>
                {row.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="check" size={20} class:list={['mt-0.5', inverse ? 'text-teal-500' : 'text-success']} />
                    <span class:list={[inverse && 'text-ink-inverse-muted']}>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
            {row.showLink && row.link && (
              <div class="mt-6">
                <Button {...row.link} variant="outline" />
              </div>
            )}
          </div>
          {row.media && (
            <Screenshot media={row.media} class={row.flip ? 'lg:order-first' : undefined} sizes="(min-width: 90rem) 700px, (min-width: 75rem) 580px, 100vw" />
          )}
        </div>
      ))
    }
  </div>
  )}
</Section>

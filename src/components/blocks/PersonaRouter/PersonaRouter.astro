---
import type { SectionValue } from '../../../schemas/sections';
import type { Persona } from '../../../schemas/constants';
import { getRegistry } from '../../../lib/content/registry';
import Section from '../../ui/Section.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'personaRouter'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, items, ctx } = Astro.props;

const registry = await getRegistry();

// "Pick your clinic" (spec 5.1 item 2, section 11): one tile per rung of the persona ladder (2.8).
const ICONS: Record<Persona, string> = {
  solo: 'user-round',
  polyclinic: 'hospital',
  chain: 'network',
  'hospital-opd': 'building-2',
  ngo: 'heart-handshake',
};
// A target that is not rendered in this stage leaves the tile as plain text, never a dead link.
// Each linked tile has one link, on its title; the link's ::after covers the card, so the whole tile
// is the tap target without nesting links.
const cards = items.map((item) => ({ ...item, icon: item.icon ?? ICONS[item.persona], url: registry.urlFor(item.href) }));

// One column on phones, two from sm, then a single row of four or five on wide screens.
const COLUMNS: Record<number, string> = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 md:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
  5: 'sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5',
  6: 'sm:grid-cols-2 md:grid-cols-3',
};
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={toneFor(tone, ctx.index)} center>
  <ul class:list={['grid gap-4', COLUMNS[cards.length]]}>
    {
      cards.map((card) => (
        <li
          class:list={[
            'persona-card card relative flex h-full flex-col p-6 text-ink md:p-7',
            card.url && 'group',
          ]}
        >
          <span class="persona-card__icon flex size-14 items-center justify-center rounded-control bg-blue-500 text-white">
            <Icon name={card.icon} size={28} />
          </span>
          <h3 class="mt-5 font-display text-[21px] leading-snug font-semibold">
            {card.url ? (
              <a
                href={card.url}
                class="link-plain after:absolute after:inset-0 after:rounded-card no-underline group-hover:text-blue-700 group-hover:no-underline"
                data-track="cta_click"
                data-label={`Persona router: ${card.title}`}
              >
                {card.title}
              </a>
            ) : (
              card.title
            )}
          </h3>
          <p class="mt-3 min-h-[calc(1.75em*5)] text-[1.125rem] leading-[1.75] text-ink-muted">{card.body}</p>
          {card.url && (
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-link">
              Learn more
              <Icon name="arrow-right" size={16} class="transition-transform duration-150 group-hover:translate-x-1" />
            </span>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .persona-card {
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease,
      translate 150ms ease;
  }
  .persona-card.group:hover,
  .persona-card.group:focus-within {
    border-color: var(--color-blue-500);
    box-shadow: 0 12px 28px -14px rgb(0 91 176 / 0.35);
    translate: 0 -4px;
  }
  .persona-card__icon {
    transition: background-color 150ms ease;
  }
  .persona-card.group:hover .persona-card__icon {
    background: var(--color-blue-700);
  }
  @media (prefers-reduced-motion: reduce) {
    .persona-card {
      transition: none;
    }
    .persona-card.group:hover,
    .persona-card.group:focus-within {
      translate: none;
    }
  }
</style>

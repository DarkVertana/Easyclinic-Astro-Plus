---
import { getEntry } from 'astro:content';
import type { SectionValue } from '../../../schemas/sections';
import { getRegistry } from '../../../lib/content/registry';
import { optional, unconfirmed } from '../../../lib/content/need';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import Quote from '../../ui/Quote.astro';
import Screenshot from '../../ui/Screenshot.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'proofBlock'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, variant, figures, testimonial, badges, media, body, link, ctx } = Astro.props;

const registry = await getRegistry();
const study = variant === 'study' ? (await getEntry('study', 'study'))!.data : null;
const testimonialEntry = testimonial ? await getEntry(testimonial) : undefined;

// Study figures render from study.yaml with their citation (plan: research finding 2). A figure with
// no public or internal source, or a publication not yet re-verified, cannot be published.
const figureRows = study
  ? figures.map((figId) => {
      const f = study.figures.find((x) => x.id === figId);
      if (!f) throw new Error(`proofBlock on ${ctx.path}: figure "${figId}" is not in study.yaml`);
      const pub = f.source ? study.publications.find((p) => p.id === f.source) : undefined;
      const confirmed = pub ? Boolean(pub.verifiedOn) : Boolean(f.internalSource);
      return {
        value: unconfirmed(Astro, `source for "${f.value} ${f.label}"`, f.value, confirmed),
        label: f.label,
        context: f.context,
        citation: pub ? `${pub.authors}, ${pub.venue} (${pub.published.getUTCFullYear()})` : null,
        url: pub?.url,
      };
    })
  : [];
const citations = [...new Map(figureRows.filter((f) => f.citation).map((f) => [f.url, f])).values()];
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={toneFor(tone, ctx.index)}>
  {
    variant === 'study' && (
      <div>
        <dl class:list={['grid gap-5', figureRows.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : figureRows.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2']}>
          {figureRows.map((f) => (
            <div class="stat-card card relative flex flex-col p-6 md:p-7">
              <dt class="sr-only">{f.label}</dt>
              <dd class="flex flex-1 flex-col">
                <span class="block font-display text-[2.75rem] leading-none font-normal text-blue-700 md:text-[3.25rem]">{f.value}</span>
                <span class="mt-3 block text-[1.0625rem] font-semibold text-ink-heading">{f.label}</span>
                <span class="mt-4 block min-h-[calc(1.6em*2)] border-t border-line pt-4 text-sm leading-[1.6] text-ink-muted">{f.context}</span>
              </dd>
            </div>
          ))}
        </dl>
        {(body || citations.length > 0 || link) && (
          <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:gap-10">
            {body && <Md text={body} class="max-w-[46rem] leading-relaxed" />}
            {(citations.length > 0 || link) && (
              <aside class="self-start rounded-card border border-[#c7c7c7] bg-surface p-6">
                {citations.length > 0 && (
                  <>
                    <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.08em] text-ink-muted uppercase">
                      <Icon name="file-text" size={16} class="text-blue-700" />
                      Source
                    </p>
                    <p class="mt-2 text-sm leading-relaxed">
                      {citations.map((c, i) => (
                        <>
                          {i > 0 && '; '}
                          <a href={c.url} rel="noopener">
                            {c.citation}
                          </a>
                        </>
                      ))}
                    </p>
                  </>
                )}
                {link && registry.urlFor(link.href) && (
                  <div class:list={[citations.length > 0 && 'mt-5']}>
                    <Button {...link} variant="outline" class="w-full" />
                  </div>
                )}
              </aside>
            )}
          </div>
        )}
      </div>
    )
  }

  {
    variant === 'customer' && testimonialEntry && (
      <div class="grid items-center gap-8 lg:grid-cols-[1.3fr_1fr]">
        <Quote testimonial={testimonialEntry} size="large" />
        {body && <Md text={body} class="card p-6" />}
      </div>
    )
  }

  {
    variant === 'badges' && (
      <ul class="flex flex-wrap gap-4">
        {badges.map((b) => (
          <li class="card flex items-center gap-3 p-4">
            <Icon name="star" size={22} class="fill-star text-star" />
            <span>
              <span class="block font-semibold text-ink-heading">
                {b.rating} on {b.label}
              </span>
              {optional(`${b.label} review count`, b.count) && <span class="block text-sm text-ink-muted">{optional(`${b.label} review count`, b.count)} reviews</span>}
            </span>
            {b.href && (
              <a href={b.href} rel="noopener" class="ml-2 text-sm">
                Read the reviews
              </a>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {
    variant === 'screenshot' && media && (
      <div class="grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
        <Screenshot media={media} />
        {body && <Md text={body} />}
      </div>
    )
  }

  {variant !== 'study' && link && registry.urlFor(link.href) && <div class="mt-8"><Button {...link} variant="outline" /></div>}
</Section>

<style>
  .stat-card {
    border-color: #c7c7c7;
    transition: border-color 150ms ease;
  }
  .stat-card:hover {
    border-color: var(--color-blue-500);
  }
</style>

---
import { Image } from 'astro:assets';
import type { SectionValue } from '../../../schemas/sections';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'teamGrid'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, members, ctx } = Astro.props;
---

{/* Team cards: one column on phones, two from 640px, three from 960px. Each portrait sits in a square, padded rounded
    frame, anchored at the top (forced: Astro's own image styles would centre it) so only the bottom is trimmed; an illustration sits in the same frame on a tint. */}
<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={toneFor(tone, ctx.index)}>
  <ul class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
    {
      members.map((m) => (
        <li class="team-card group flex flex-col overflow-hidden rounded-2xl border border-line bg-surface">
          <div class:list={['m-3 mb-0 aspect-square overflow-hidden rounded-xl', m.illustration ? 'flex items-center justify-center bg-blue-50 p-12' : 'bg-white']}>
            <Image
              src={m.image}
              alt={m.illustration ? '' : `${m.name}, ${m.role}`}
              widths={[400, 640]}
              sizes="(min-width: 60rem) 400px, (min-width: 40rem) 50vw, 100vw"
              loading="lazy"
              class:list={[
                'team-card__img transition-transform duration-500',
                m.illustration ? 'h-auto w-full max-w-[14rem] object-contain' : 'h-full! w-full object-cover object-top!',
              ]}
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-display text-lg leading-snug font-semibold text-ink-heading">{m.name}</h3>
                <p class="mt-1 text-xs font-semibold tracking-wide text-blue-700 uppercase">{m.role}</p>
              </div>
              {m.linkedin && (
                <a
                  href={m.linkedin}
                  rel="noopener"
                  target="_blank"
                  class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#0a66c2] text-white transition-opacity hover:opacity-85"
                  aria-label={`${m.name} on LinkedIn (opens in a new tab)`}
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452z" />
                  </svg>
                </a>
              )}
            </div>
            <Md text={m.bio} class="mt-4 border-t border-line pt-4 text-[0.9375rem] leading-relaxed text-ink-muted" />
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .team-card {
    box-shadow: 0 10px 30px -22px rgb(10 37 64 / 0.3);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  @media (hover: hover) {
    .team-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 24px 48px -26px rgb(10 37 64 / 0.4);
    }
    .team-card:hover .team-card__img {
      transform: scale(1.04);
    }
  }
</style>

---
import { POST_TOPIC_LABELS } from '../../../schemas/constants';
import { getRegistry } from '../../../lib/content/registry';
import { newestFirst, toIndexItem, type Listable } from '../../../lib/content/posts';
import { formatDate, isoDate } from '../../../lib/format/date';
import Icon from '../../ui/Icon.astro';
import { TOPIC_ICONS } from './topic-icons';
import { coverFor } from './covers';
import PostCover from './PostCover.astro';

/**
 * The /blog/ hero's media: the newest guide rendered in this stage, as a lead card with its cover. Renders nothing
 * when no guide is visible, so the hero falls back to text only.
 */
const registry = await getRegistry();
const lead = registry.visible
  .map((record) => toIndexItem(record as unknown as Listable))
  .filter((item) => item !== null)
  .sort(newestFirst)[0];
const href = lead ? (registry.urlFor(lead.path) ?? lead.path) : null;
---

{
  lead && href && (
    <article class="card-link relative flex w-full max-w-[36rem] flex-col overflow-hidden rounded-card border border-line bg-surface shadow-[0_1px_2px_rgb(10_37_64/0.05),0_24px_48px_-24px_rgb(10_37_64/0.25)]">
      <div class="relative">
        <PostCover cover={coverFor(lead)} sizes="(min-width: 60rem) 576px, 100vw" priority class="border-b border-line" />
        <span class="absolute left-4 top-4 rounded-full bg-navy-900 px-3 py-1 text-xs font-semibold tracking-wide text-white sm:left-5 sm:top-5">Latest guide</span>
      </div>
      <div class="px-6 pb-6 pt-5 sm:px-8 sm:pb-7 sm:pt-6">
        <p class="flex items-center gap-2.5 text-sm font-semibold text-blue-700 dark:text-link">
          <span class="inline-flex size-8 items-center justify-center rounded-control bg-surface-alt">
            <Icon name={TOPIC_ICONS[lead.topic]} size={16} />
          </span>
          {POST_TOPIC_LABELS[lead.topic]}
        </p>
        <h2 class="mt-3 text-[1.5rem] leading-[1.2] [text-wrap:pretty] sm:text-[1.75rem]">
          <a href={href} class="card-link-title link-plain after:absolute after:inset-0">{lead.title}</a>
        </h2>
        <p class="mt-3 line-clamp-3 leading-relaxed text-ink-muted">{lead.summary}</p>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
          <p class="flex flex-wrap items-center gap-x-2 text-sm text-ink-muted">
            {lead.date && (
              <span>
                Updated <time datetime={isoDate(lead.date)}>{formatDate(lead.date)}</time>
              </span>
            )}
            {lead.date && <span aria-hidden="true">·</span>}
            <span>{lead.minutes} min read</span>
          </p>
          <span class="card-link-arrow inline-flex items-center gap-1.5 text-sm font-semibold text-link" aria-hidden="true">
            Read the guide <Icon name="arrow-right" size={16} />
          </span>
        </div>
      </div>
    </article>
  )
}

---
import type { SectionValue } from '../../../schemas/sections';
import { POST_TOPIC_LABELS } from '../../../schemas/constants';
import { getRegistry } from '../../../lib/content/registry';
import { groupByTopic, toIndexItem, type IndexItem, type Listable } from '../../../lib/content/posts';
import { formatDate, isoDate } from '../../../lib/format/date';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'postIndex'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, topics, jumpLinksFrom, ctx } = Astro.props;
const sectionTone = toneFor(tone, ctx.index);
const inverse = sectionTone === 'inverse';

// Spec 5.19: every post and start-a-clinic guide rendered in this stage (production: published only),
// grouped by topic, newest first. The registry is the source, so the page never lists a hidden page.
const registry = await getRegistry();
const items = registry.visible.flatMap((record): IndexItem[] => {
  const item = toIndexItem(record as unknown as Listable);
  return item ? [item] : [];
});
const copy = new Map(topics.map((t) => [t.topic, t]));
const groups = groupByTopic(
  items,
  topics.map((t) => t.topic),
).map((group) => ({
  ...group,
  label: copy.get(group.topic)?.heading ?? POST_TOPIC_LABELS[group.topic],
  intro: copy.get(group.topic)?.intro,
}));

// Headings stay in order: topic headings sit one level under the block heading (h3, or h2 when the
// block has none), and entry titles one level under their topic.
const TopicHeading = (heading ? 'h3' : 'h2') as 'h2' | 'h3';
const EntryHeading = (heading ? 'h4' : 'h3') as 'h3' | 'h4';
const prefix = id ?? 'topic';
const anchor = (topic: string) => `${prefix}-${topic}`;
const STATUS_NOTE: Record<string, string> = { draft: 'Draft', review: 'In review' };
const muted = inverse ? 'text-ink-inverse-muted' : 'text-ink-muted';
---

{
  groups.length > 0 && (
    <Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={sectionTone}>
      {groups.length >= jumpLinksFrom && (
        <nav aria-label="Jump to a topic" class="mb-10">
          <ul class="flex flex-wrap gap-2">
            {groups.map((group) => (
              <li>
                <a
                  href={`#${anchor(group.topic)}`}
                  class:list={[
                    'inline-flex min-h-11 items-center rounded-control border px-4 text-sm font-medium no-underline',
                    inverse ? 'border-white/40 text-white hover:bg-white/10' : 'border-line bg-surface text-ink hover:border-blue-500',
                  ]}
                >
                  {group.label}
                  <span class:list={['ml-2', muted]}>
                    {group.items.length}
                    <span class="sr-only">{group.items.length === 1 ? 'article' : 'articles'}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <div class="grid gap-12 md:gap-16">
        {groups.map((group) => (
          <div class="grid gap-6 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-10 lg:grid-cols-[18rem_minmax(0,1fr)]">
            <div>
              <TopicHeading id={anchor(group.topic)} class:list={['text-2xl leading-tight', inverse && 'text-white']}>
                {group.label}
              </TopicHeading>
              {group.intro && <Md text={group.intro} class:list={['mt-3', muted]} />}
            </div>
            <ul class="divide-y divide-line border-y border-line" aria-labelledby={anchor(group.topic)}>
              {group.items.map((item) => {
                const href = registry.urlFor(item.path) ?? item.path;
                return (
                  <li class="group relative py-5">
                    <EntryHeading class="font-sans text-lg font-semibold leading-snug">
                      {/* The link's ::after covers the row, so the whole entry is one tap target. */}
                      <a href={href} class:list={['link-plain after:absolute after:inset-0 group-hover:underline', inverse && 'text-white']}>
                        {item.title}
                      </a>
                    </EntryHeading>
                    <p class:list={['mt-1.5', muted]}>{item.summary}</p>
                    <p class:list={['mt-2 flex flex-wrap items-center gap-x-2 text-sm', muted]}>
                      {item.date && (
                        <span>
                          Updated <time datetime={isoDate(item.date)}>{formatDate(item.date)}</time>
                        </span>
                      )}
                      {item.date && <span aria-hidden="true">·</span>}
                      <span>{item.minutes} minute read</span>
                      {STATUS_NOTE[item.status] && (
                        <span class="rounded-full border border-line-strong px-2 text-xs font-semibold text-ink">{STATUS_NOTE[item.status]}</span>
                      )}
                    </p>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </Section>
  )
}

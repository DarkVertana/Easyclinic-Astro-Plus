---
import { getEntry } from 'astro:content';
import type { SectionValue } from '../../../schemas/sections';
import { getRegistry } from '../../../lib/content/registry';
import { need, unconfirmed } from '../../../lib/content/need';
import { stripSentinels } from '../../../lib/content/sentinel';
import Section from '../../ui/Section.astro';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

/**
 * Local proof strip (spec 5.13 block 2). With a heading it renders as a section; without one it renders
 * the bare card, so a template can place it in the hero aside (section 11: the contact card sits in the hero).
 */
type Props = SectionValue<'contactCard'> & { ctx: BlockContext; class?: string };
const { id, eyebrow, heading, intro, tone, country: countryRef, showClients, ctx, class: className } = Astro.props;

const registry = await getRegistry();
const entry = await getEntry(countryRef);
if (!entry) throw new Error(`contactCard on ${ctx.path}: no country "${countryRef.id}"`);
const country = entry.data;
const contact = country.contact;
const inSection = Boolean(heading);
// Country templates already show the contact card in the hero (section 11), so the section version on
// those pages is the rest of the local proof strip: office, cities and named clients.
const proofOnly = inSection && ctx.index >= 0 && (ctx.family === 'country' || ctx.family === 'countryDemo');

// Named contact: shown only with consent on file (publishName), otherwise a publish blocker.
const consent = contact.publishName === true;
const nameLabel = `${country.name} contact name`;
const fullName = contact.name ? unconfirmed(Astro, `${nameLabel} consent`, contact.name, consent) : need(Astro, nameLabel, null);
/** "Or call Walter directly": the first name, keeping an honorific ("Dr Amina") so it still reads as a name. */
function callName(name: string): string {
  const parts = name.trim().split(/\s+/);
  return /^(dr|mr|mrs|ms|prof)\.?$/i.test(parts[0]) && parts.length > 1 ? parts.slice(0, 2).join(' ') : parts[0];
}
const firstName = contact.name ? unconfirmed(Astro, `${nameLabel} consent`, callName(contact.name), consent) : need(Astro, nameLabel, null);
const role = need(Astro, `${country.name} contact role`, contact.role);
const phone = need(Astro, `${country.name} contact phone`, contact.phone);
const telHref = contact.phone ? `tel:${contact.phone.replace(/[^\d+]/g, '')}` : null;
const hours = need(Astro, `${country.name} contact hours`, contact.hours);
const office = need(Astro, `${country.name} office or partner address`, country.office);
const cities = country.cities.length ? country.cities.join(', ') : need(Astro, `${country.name} cities`, null);
const clients = showClients ? (country.clients.length ? country.clients : [need(Astro, `${country.name} named client`, null)]) : [];

// Click-to-chat routed to the country contact, prefilled with the page name (spec 7.9).
const prefill = `Hi, I was reading the EasyClinic page "${stripSentinels(ctx.pageLabel)}" and would like a demo.`;
const whatsappHref = contact.whatsapp ? `https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(prefill)}` : null;

const demoPath = country.pages.demo;
const demoHref = demoPath && demoPath !== ctx.path ? registry.urlFor(demoPath) : null;
const demoLabel = `Book a demo with ${firstName}`;
---

{
  inSection ? (
    <Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={toneFor(tone, ctx.index)}>
      <div class:list={['card grid gap-6 p-5 sm:p-6 md:gap-10 md:p-8', !proofOnly && 'md:grid-cols-2', className]}>
        {!proofOnly && (<div>
          <div class="flex items-start gap-3">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-700">
              <Icon name="user-round" size={22} />
            </span>
            <div>
              <p class="text-lg font-semibold leading-snug text-ink-heading">{fullName}</p>
              <p class="text-sm text-ink-muted">{role}</p>
            </div>
          </div>
          {demoHref && (
            <div class="mt-5">
              <Button href={demoHref} label={demoLabel} variant="solid" event="contact card demo" />
            </div>
          )}
          <p class="mt-4">
            Or call {firstName} directly:{' '}
            {telHref ? (
              <a href={telHref} class="inline-flex min-h-11 items-center whitespace-nowrap font-semibold" data-track="cta_click" data-label="contact card phone">
                {phone}
              </a>
            ) : (
              <span class="font-semibold">{phone}</span>
            )}
          </p>
          <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2">
            {whatsappHref && (
              <a href={whatsappHref} class="btn border-line-strong bg-surface text-ink-heading hover:bg-surface-muted hover:text-ink-heading" data-track="whatsapp_click" data-label="contact card" rel="noopener">
                <Icon name="brand-whatsapp" size={18} class="text-whatsapp" />
                <span>Message {firstName} on WhatsApp</span>
              </a>
            )}
            {contact.email && (
              <a href={`mailto:${contact.email}`} class="inline-flex min-h-11 items-center gap-2 break-all" data-track="cta_click" data-label="contact card email">
                <Icon name="mail" size={18} />
                <span>{contact.email}</span>
              </a>
            )}
          </div>
        </div>)}

        <dl class:list={['grid gap-4 text-sm', proofOnly ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2']}>
          <div>
            <dt class="font-semibold text-ink-heading">Hours</dt>
            <dd class="mt-0.5 text-ink-muted">
              {hours}
              {contact.callbackWindow && <span class="block">Calls back within {contact.callbackWindow}</span>}
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-heading">Office</dt>
            <dd class="mt-0.5 text-ink-muted">{office}</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink-heading">Cities</dt>
            <dd class="mt-0.5 text-ink-muted">{cities}</dd>
          </div>
          {showClients && (
            <div>
              <dt class="font-semibold text-ink-heading">Clients include</dt>
              <dd class="mt-0.5 text-ink-muted">
                <ul class="grid gap-0.5">
                  {clients.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </div>
    </Section>
  ) : (
    <div class:list={['card p-5 text-left', className]}>
      <p class="eyebrow">Your local contact</p>
      <div class="mt-3 flex items-start gap-3">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-700">
          <Icon name="user-round" size={22} />
        </span>
        <div>
          <p class="font-semibold leading-snug text-ink-heading">{fullName}</p>
          <p class="text-sm text-ink-muted">{role}</p>
        </div>
      </div>
      <p class="mt-3">
        Or call {firstName} directly:{' '}
        {telHref ? (
          <a href={telHref} class="inline-flex min-h-11 items-center whitespace-nowrap font-semibold" data-track="cta_click" data-label="contact card phone">
            {phone}
          </a>
        ) : (
          <span class="font-semibold">{phone}</span>
        )}
      </p>
      {(whatsappHref || contact.email) && (
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          {whatsappHref && (
            <a href={whatsappHref} class="btn border-line-strong bg-surface !px-3 text-sm text-ink-heading hover:bg-surface-muted hover:text-ink-heading" data-track="whatsapp_click" data-label="contact card" rel="noopener">
              <Icon name="brand-whatsapp" size={18} class="text-whatsapp" />
              <span>WhatsApp {firstName}</span>
            </a>
          )}
          {contact.email && (
            <a href={`mailto:${contact.email}`} class="inline-flex min-h-11 items-center gap-2 break-all text-sm" data-track="cta_click" data-label="contact card email">
              <Icon name="mail" size={16} />
              <span>{contact.email}</span>
            </a>
          )}
        </div>
      )}
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 border-t border-line pt-3 text-sm">
        <dt class="font-semibold text-ink-heading">Hours</dt>
        <dd class="text-ink-muted">
          {hours}
          {contact.callbackWindow && <>, calls back within {contact.callbackWindow}</>}
        </dd>
        <dt class="font-semibold text-ink-heading">Office</dt>
        <dd class="text-ink-muted">{office}</dd>
        <dt class="font-semibold text-ink-heading">Cities</dt>
        <dd class="text-ink-muted">{cities}</dd>
        {showClients && (
          <>
            <dt class="font-semibold text-ink-heading">Clients include</dt>
            <dd class="text-ink-muted">{clients.join(', ')}</dd>
          </>
        )}
      </dl>
      {demoHref && (
        <p class="mt-2">
          <a href={demoHref} class="inline-flex min-h-11 items-center gap-1.5 font-semibold" data-track="cta_click" data-label="contact card demo">
            {demoLabel}
            <Icon name="arrow-right" size={18} />
          </a>
        </p>
      )}
    </div>
  )
}

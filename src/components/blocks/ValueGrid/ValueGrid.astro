---
import type { SectionValue } from '../../../schemas/sections';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'valueGrid'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, items, ctx } = Astro.props;
---

{/* Numbered value cards: one column on phones, two from 640px, three from 1200px. */}
<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={toneFor(tone, ctx.index)} center>
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
    {
      items.map((item, i) => (
        <li class="value-card group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface p-6 sm:p-7">
          <span class="value-card__bar absolute inset-x-0 top-0 h-1 bg-blue-600" aria-hidden="true" />
          <div class="flex items-start justify-between gap-4">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 text-white shadow-[0_10px_20px_-10px_rgb(0_91_176/0.7)]" aria-hidden="true">
              <Icon name={item.icon} size={24} />
            </span>
            <span class="font-display text-4xl leading-none font-semibold text-blue-100 transition-colors group-hover:text-blue-200" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="mt-5 font-display text-xl font-semibold text-ink-heading">{item.title}</h3>
          <Md text={item.body} class="mt-2 text-[0.9375rem] leading-relaxed text-ink-muted" />
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .value-card {
    box-shadow: 0 10px 30px -22px rgb(10 37 64 / 0.3);
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      border-color 0.2s;
  }
  .value-card__bar {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
  }
  @media (hover: hover) {
    .value-card:hover {
      transform: translateY(-3px);
      border-color: var(--color-blue-200);
      box-shadow: 0 24px 48px -26px rgb(10 37 64 / 0.4);
    }
    .value-card:hover .value-card__bar {
      transform: scaleX(1);
    }
  }
</style>

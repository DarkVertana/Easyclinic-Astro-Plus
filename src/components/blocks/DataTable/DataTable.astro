---
import type { SectionValue } from '../../../schemas/sections';
import { need } from '../../../lib/content/need';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'dataTable'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, caption, columns, rows, note, ctx } = Astro.props;
const sectionTone = toneFor(tone, ctx.index);

// Accessible name: the visible caption when set, else the section heading (by reference when it has an id).
const labelledBy = !caption && heading && id ? `${id}-heading` : undefined;
const label = !caption && heading && !id ? heading : undefined;

// One cell per column. A short row gets a placeholder rather than shifting cells under the wrong
// header, and a long row is flagged; both block publishing (spec 7.2: no bracketed placeholders).
const body = rows.map((row, r) => ({
  cells: columns.map((column, c) =>
    row[c] !== undefined
      ? { md: row[c], placeholder: null }
      : { md: null, placeholder: need(Astro, `${column || `column ${c + 1}`} in row ${r + 1}`, null) },
  ),
  overflow:
    row.length > columns.length ? need(Astro, `row ${r + 1} has ${row.length} cells for ${columns.length} columns`, null) : null,
}));
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={sectionTone}>
  {/* Explicit roles keep table semantics when the cells are display:block below 640px (Safari drops them). */}
  <table
    class:list={['dt', columns.length >= 5 && 'dt-dense']}
    role="table"
    aria-labelledby={labelledBy}
    aria-label={label}
  >
    {caption && <caption>{caption}</caption>}
    <thead role="rowgroup">
      <tr role="row">
        {
          columns.map((column) => (
            <th scope="col" role="columnheader">
              {column}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        body.map((row) => (
          <tr role="row">
            {row.cells.map((cell, c) => {
              const content = cell.md ? <Md text={cell.md} inline /> : cell.placeholder;
              const last = c === row.cells.length - 1 && row.overflow;
              return c === 0 ? (
                <th scope="row" role="rowheader" data-label={columns[c] || undefined}>
                  {content}
                  {last && <span class="block">{row.overflow}</span>}
                </th>
              ) : (
                <td role="cell" data-label={columns[c] || undefined}>
                  {content}
                  {last && <span class="block">{row.overflow}</span>}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
  {note && <Md text={note} class:list={['mt-4 max-w-[46rem] text-sm', sectionTone === 'inverse' ? 'text-ink-inverse-muted' : 'text-ink-muted']} />}
</Section>

<style>
  .dt {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-card, 0.75rem);
    background: var(--surface);
    color: var(--ink);
    text-align: left;
  }

  .dt caption {
    caption-side: top;
    padding-bottom: 0.75rem;
    text-align: left;
    font-weight: 600;
    color: var(--ink-heading);
  }

  :global([data-tone='inverse']) .dt caption {
    color: var(--ink-inverse);
  }

  .dt th,
  .dt td {
    padding: 0.75rem 1rem;
    vertical-align: top;
    border-top: 1px solid var(--border);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .dt thead th {
    border-top: 0;
    background: var(--surface-muted);
    font-size: var(--text-sm, 0.875rem);
    font-weight: 600;
    color: var(--ink-heading);
  }

  .dt thead th:first-child {
    border-top-left-radius: calc(var(--radius-card, 0.75rem) - 1px);
  }

  .dt thead th:last-child {
    border-top-right-radius: calc(var(--radius-card, 0.75rem) - 1px);
  }

  .dt tbody th {
    font-weight: 600;
    color: var(--ink-heading);
  }

  .dt-dense tbody th,
  .dt-dense tbody td {
    font-size: var(--text-sm, 0.875rem);
  }

  /* Below 640px every row becomes a card; each cell carries its column label (spec 7.5). */
  @media (width < 40rem) {
    .dt,
    .dt caption,
    .dt tbody,
    .dt tr,
    .dt th,
    .dt td {
      display: block;
    }

    .dt {
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    .dt thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .dt tbody tr {
      padding-block: 0.5rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-card, 0.75rem);
      background: var(--surface);
    }

    .dt tbody tr + tr {
      margin-top: 1rem;
    }

    .dt tbody th,
    .dt tbody td {
      padding: 0.5rem 1rem;
      border-top: 0;
      font-size: var(--text-base, 1rem);
    }

    .dt tbody th {
      padding-bottom: 0.75rem;
      margin-bottom: 0.25rem;
      border-bottom: 1px solid var(--border);
    }

    .dt tbody [data-label]::before {
      content: attr(data-label);
      /* Empty alt text: screen readers already announce the column header. */
      content: attr(data-label) / '';
      display: block;
      margin-bottom: 0.125rem;
      font-size: var(--text-sm, 0.875rem);
      font-weight: 600;
      color: var(--ink-muted);
    }
  }
</style>

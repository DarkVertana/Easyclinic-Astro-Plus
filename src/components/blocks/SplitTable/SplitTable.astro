---
import type { SectionValue } from '../../../schemas/sections';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'splitTable'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, left, right, more = [], note, layout = 'cards', ctx } = Astro.props;
const sectionTone = toneFor(tone, ctx.index);
const inverse = sectionTone === 'inverse';

/*
 * Spec 5.7, "Central control, local flexibility": what head office locks against what a branch
 * adjusts, or any two-sided comparison. The sides do not pair item by item, so each is its own list
 * under its own h3 rather than a table. Side by side from 640px, stacked below. The two accent
 * colours only tell the panels apart; the titles carry the meaning.
 *
 * Each card has a tinted header (icon, title, item count) and a checklist. A long list of short items
 * runs in two columns on wide screens, so the two cards come out close in height.
 */
const plainLength = (item: string) => item.replace(/[*_`[\]()]/g, '').length;
// One scheme for every card: a light grey header, a brand-blue icon tile that lifts when the card is hovered,
// and green checks with white ticks.
const sides = [left, right, ...more].map((side) => ({
  ...side,
  twoCols: side.items.length > 5 && side.items.every((item) => plainLength(item) <= 42),
}));
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={sectionTone} wideHeader={layout === 'versus'}>
  {layout === 'versus' ? (
    // Versus: no boxes. Two open columns split by a rule with a "vs" mark; the left side in grey, the right in brand
    // blue. Side by side from 768px with a vertical rule, stacked below with a horizontal one.
    <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:gap-0">
      {[left, right].map((side, i) => (
        <>
          {i === 1 && (
            <div class="flex items-center gap-4 md:flex-col md:px-8 lg:px-12" aria-hidden="true">
              <span class:list={['h-px flex-1 md:h-8 md:w-px md:flex-none', inverse ? 'bg-white/15' : 'bg-line']} />
              <span class:list={['grid size-12 shrink-0 place-items-center rounded-full font-display text-sm font-semibold uppercase tracking-wide', inverse ? 'bg-white/10 text-white' : 'bg-surface text-ink-heading ring-1 ring-line shadow-[0_6px_16px_-10px_rgb(10_37_64/0.4)]']}>vs</span>
              <span class:list={['h-px flex-1 md:w-px', inverse ? 'bg-white/15' : 'bg-line']} />
            </div>
          )}
          <div>
            <h3 class:list={['flex items-center gap-4 border-b-2 pb-5 font-display text-xl font-semibold leading-snug sm:text-[1.375rem]', i === 0 ? (inverse ? 'border-white/30' : 'border-grey-400') : 'border-blue-600', inverse && '!text-white']}>
              {side.icon && (
                <span class:list={['grid size-12 shrink-0 place-items-center rounded-2xl', i === 0 ? (inverse ? 'bg-white/10 text-white' : 'bg-grey-100 text-ink-muted') : 'bg-blue-700 text-white shadow-[0_8px_18px_-8px_rgb(0_91_176/0.6)]']} aria-hidden="true">
                  <Icon name={side.icon} size={24} />
                </span>
              )}
              <span class="min-w-0 flex-1">{side.title}</span>
            </h3>
            <ol role="list" class="mt-6 grid gap-5">
              {side.items.map((item, n) => (
                <li class="flex gap-4">
                  <span class:list={['w-7 shrink-0 pt-0.5 font-display text-sm font-semibold tabular-nums', i === 0 ? (inverse ? 'text-white/50' : 'text-grey-400') : (inverse ? 'text-teal-500' : 'text-blue-700')]} aria-hidden="true">
                    {String(n + 1).padStart(2, '0')}
                  </span>
                  <Md text={item} inline class:list={['min-w-0 flex-1 text-base leading-relaxed', inverse ? 'text-ink-inverse-muted' : 'text-ink']} />
                </li>
              ))}
            </ol>
          </div>
        </>
      ))}
    </div>
  ) : (
  <div class="grid gap-5 sm:grid-cols-2 lg:gap-6">
    {
      sides.map((side) => (
        <div class="group flex flex-col overflow-hidden rounded-card border border-line bg-surface text-ink transition-[box-shadow,border-color,translate] duration-300 ease-out hover:-translate-y-0.5 hover:border-blue-100 hover:shadow-[0_4px_8px_-4px_rgb(10_37_64/0.08),0_12px_28px_-12px_rgb(10_37_64/0.16)] motion-reduce:hover:translate-y-0">
          <h3 class="flex items-center gap-3.5 border-b border-line bg-grey-50 px-5 py-4 font-display text-lg font-semibold leading-snug text-ink-heading sm:px-6 sm:py-5">
            {side.icon && (
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-blue-700 text-white shadow-[0_4px_10px_-4px_rgb(10_37_64/0.35)] transition duration-300 ease-out group-hover:-translate-y-0.5 group-hover:-rotate-6 group-hover:scale-110 group-hover:bg-blue-600 group-hover:shadow-[0_10px_20px_-8px_rgb(0_91_176/0.55)] motion-reduce:transition-none motion-reduce:group-hover:transform-none">
                <Icon name={side.icon} size={22} />
              </span>
            )}
            <span class="min-w-0 flex-1">{side.title}</span>
            <span class="shrink-0 rounded-full bg-white px-2.5 py-0.5 font-sans text-xs font-semibold text-ink-muted ring-1 ring-line">
              {side.items.length}
              <span class="sr-only"> items</span>
            </span>
          </h3>
          {/* role="list" keeps list semantics in Safari, which drops them when list-style is none. */}
          <ul role="list" class:list={['grid gap-x-6 gap-y-3.5 px-5 py-5 sm:px-6 sm:py-6', side.twoCols && 'lg:grid-cols-2']}>
            {side.items.map((item) => (
              <li class="flex gap-3 text-[0.9375rem] leading-snug sm:text-base">
                <span class="mt-px flex size-5 shrink-0 items-center justify-center rounded-full bg-[#3ec26f] text-white" aria-hidden="true">
                  <Icon name="check" size={12} />
                </span>
                <Md text={item} inline class="min-w-0 flex-1" />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  )}
  {
    note && layout === 'versus' && (
      <div class:list={['mt-10 flex items-start gap-3 border-t pt-6', inverse ? 'border-white/15 text-ink-inverse-muted' : 'border-line text-ink-muted']}>
        <Icon name="info" size={20} class:list={['mt-0.5 shrink-0', inverse ? 'text-teal-500' : 'text-blue-700']} />
        <Md text={note} class="text-[0.9375rem] leading-relaxed" />
      </div>
    )
  }
  {
    note && layout !== 'versus' && (
      <div class:list={['mt-6 flex items-start gap-3 rounded-card border px-5 py-4 sm:px-6', inverse ? 'border-white/15 bg-white/5 text-ink-inverse-muted' : 'border-blue-100 bg-blue-50/60 text-ink']}>
        <Icon name="info" size={20} class:list={['mt-0.5 shrink-0', inverse ? 'text-teal-500' : 'text-blue-700']} />
        <Md text={note} class="text-[0.9375rem] leading-relaxed" />
      </div>
    )
  }
</Section>

---
import type { SectionValue } from '../../../schemas/sections';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import Button from '../../ui/Button.astro';
import Screenshot from '../../ui/Screenshot.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'splitContent'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, body, link, secondary, media, centerHeading, mediaFirst, alignTop, stickyMedia, chips = [], chipsLabel, compact = false, featureList = false, ctx } = Astro.props;
const topHeading = centerHeading && heading;

// Compact: the body's "### Title" + text pairs become a two-column grid of points, each with a check marker.
const points = compact
  ? body
      .split(/^###\s+/m)
      .map((chunk) => chunk.trim())
      .filter(Boolean)
      .map((chunk) => {
        const [title, ...rest] = chunk.split('\n');
        return { title: title.trim(), text: rest.join('\n').trim() };
      })
  : [];
---

<!-- Two columns on wide screens: the heading, text and buttons on the left; the image on the right. -->
<Section id={id} tone={toneFor(tone, ctx.index)}>
  {
    topHeading && (
      <div class:list={['mx-auto text-center', compact ? 'mb-10 md:mb-14' : 'mb-8 md:mb-12']}>
        {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
        {/* One line from lg: the size scales with the viewport up to the usual 40px. */}
        <h2 id={id ? `${id}-heading` : undefined} class="lg:text-[min(3.1vw,2.5rem)]">{heading}</h2>
      </div>
    )
  }
  {/* Side by side from lg. Below that the centred-heading layout stacks as one centred reading column. */}
  <div class:list={['grid gap-10', compact ? 'lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-12 xl:gap-16' : featureList ? (mediaFirst ? 'lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-12 xl:gap-16' : 'lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-12 xl:gap-16') : 'lg:grid-cols-2 lg:gap-16', alignTop ? 'items-start' : 'items-center']}>
    {/* Stacked (below lg): the text runs the full width, the image smaller and centred beneath it. */}
    <div>
      {!topHeading && eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
      {!topHeading && heading && <h2 id={id ? `${id}-heading` : undefined}>{heading}</h2>}
      {intro && <Md text={intro} class:list={['lede text-ink-muted', !topHeading && 'mt-4', topHeading && 'split-intro']} />}
      {
        compact ? (
          <ul role="list" class:list={['grid gap-y-6 lg:gap-y-5', ((heading && !topHeading) || intro) && 'mt-8']}>
            {points.map((point) => (
              <li class="flex gap-3.5">
                <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-lg bg-surface text-teal-700 shadow-[0_1px_2px_rgb(10_37_64/0.08)] ring-1 ring-teal-500/25">
                  <Icon name="check" size={16} />
                </span>
                <div>
                  <h3 class="font-display text-[1.1875rem] font-semibold leading-snug text-ink-heading sm:text-[1.375rem]">{point.title}</h3>
                  {point.text && <Md text={point.text} class="mt-1.5 text-base leading-relaxed text-ink-muted sm:text-[1.0625rem]" />}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <Md
            text={body}
            class:list={[
              'leading-relaxed',
              topHeading ? 'max-w-none lg:max-w-[42rem]' : 'max-w-[42rem]',
              featureList ? 'split-list text-base text-ink sm:text-[1.0625rem]' : topHeading ? 'split-points text-[1.0625rem] sm:text-lg' : 'text-lg',
              ((heading && !topHeading) || intro) && 'mt-6',
            ]}
          />
        )
      }
      {
        chips.length > 0 && (
          <div class:list={[compact ? 'mt-9 border-t border-blue-200/70 pt-7' : 'mt-6']}>
            {chipsLabel && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.08em] text-blue-700">{chipsLabel}</p>}
            <ul role="list" class="flex flex-wrap gap-2">
              {chips.map((chip) => (
                <li class="inline-flex items-center gap-[0.4375rem] rounded-full border border-blue-500 bg-surface py-1.5 pr-3.5 pl-[0.4375rem] text-sm leading-[1.2] font-semibold text-ink-heading max-sm:text-[0.8125rem]">
                  <span class="grid size-[1.125rem] shrink-0 place-items-center rounded-full bg-[#3ec26f] text-white" aria-hidden="true">
                    <Icon name="check" size={10} />
                  </span>
                  {chip}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        (link || secondary) && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            {link && <Button {...link} variant="cta" />}
            {secondary && <Button {...secondary} variant="outline" />}
          </div>
        )
      }
    </div>
    {/* The centred-heading layout runs the image full width below lg and caps it at 592px beside the text, about the
        width of the images it shows, so they are not stretched. A class, not an inline style: the CSP blocks those.
        Compact: the screenshot sits as a card on a soft tinted panel. */}
    {
      compact ? (
        <div class:list={['w-full overflow-hidden rounded-2xl border-2 border-[#c7c7c7] bg-surface max-[48rem]:order-first shadow-[0_2px_6px_rgb(10_37_64/0.06),0_28px_56px_-24px_rgb(10_37_64/0.3)]', mediaFirst && 'lg:order-first', stickyMedia && 'lg:sticky lg:top-24 lg:self-start']}>
          <Screenshot media={{ ...media, frame: 'none' }} sizes="(min-width: 80rem) 600px, (min-width: 60rem) 48vw, 100vw" />
        </div>
      ) : featureList ? (
        <div class:list={['w-full overflow-hidden rounded-2xl border-2 border-[#c7c7c7] bg-surface shadow-[0_2px_6px_rgb(10_37_64/0.05),0_20px_44px_-24px_rgb(10_37_64/0.25)] max-[48rem]:order-first', mediaFirst && 'lg:order-first', stickyMedia && 'lg:sticky lg:top-24 lg:self-start']}>
          <Screenshot media={{ ...media, frame: 'none' }} sizes="(min-width: 80rem) 680px, (min-width: 60rem) 52vw, 100vw" />
        </div>
      ) : (
        <div class:list={['overflow-hidden rounded-2xl shadow-[0_24px_60px_-24px_rgb(10_37_64/0.35)]', mediaFirst ? 'lg:order-first lg:justify-self-start' : 'lg:justify-self-end', stickyMedia && 'lg:sticky lg:top-24 lg:self-start', 'w-full', topHeading && 'lg:max-w-[37rem]']}>
          <Screenshot media={{ ...media, frame: 'none' }} sizes="(min-width: 75rem) 640px, (min-width: 60rem) 50vw, 100vw" />
        </div>
      )
    }
  </div>
</Section>

<style is:global>
  /* Feature list: a tight run of point headings, each with a line or two under it. */
  .split-list h3 {
    margin: 0 0 0.375rem;
    font-size: 1.3125rem;
    line-height: 1.3;
  }
  .split-list h3:not(:first-child) {
    margin-top: 1.5rem;
  }
  .split-list p {
    margin: 0;
    line-height: 1.65;
  }
  @media (max-width: 39.99rem) {
    .split-list h3 {
      font-size: 1.1875rem;
    }
  }
  /* Phones: smaller point headings and intro so they keep their weight without crowding the narrow column. */
  @media (max-width: 39.99rem) {
    .split-points h3 {
      font-size: 1.1875rem;
    }
    .split-intro {
      font-size: 1.0625rem;
    }
  }
</style>

---
import type { SectionValue } from '../../../schemas/sections';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import Button from '../../ui/Button.astro';
import Screenshot from '../../ui/Screenshot.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'splitContent'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, body, link, secondary, media, ctx } = Astro.props;
---

<!-- Two columns on wide screens: the heading, text and buttons on the left; the image on the right. -->
<Section id={id} tone={toneFor(tone, ctx.index)}>
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
      {heading && <h2 id={id ? `${id}-heading` : undefined}>{heading}</h2>}
      {intro && <Md text={intro} class="lede mt-4 text-ink-muted" />}
      <Md text={body} class:list={['max-w-[42rem] text-lg leading-relaxed', (heading || intro) && 'mt-6']} />
      {
        (link || secondary) && (
          <div class="mt-8 flex flex-wrap items-center gap-3">
            {link && <Button {...link} variant="cta" />}
            {secondary && <Button {...secondary} variant="outline" />}
          </div>
        )
      }
    </div>
    <div class="overflow-hidden rounded-2xl shadow-[0_24px_60px_-24px_rgb(10_37_64/0.35)]">
      <Screenshot media={{ ...media, frame: 'none' }} sizes="(min-width: 75rem) 640px, (min-width: 60rem) 50vw, 100vw" />
    </div>
  </div>
</Section>

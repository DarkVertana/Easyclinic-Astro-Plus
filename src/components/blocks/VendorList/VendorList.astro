---
import type { SectionValue } from '../../../schemas/sections';
import { need } from '../../../lib/content/need';
import { formatDate, isoDate } from '../../../lib/format/date';
import Section from '../../ui/Section.astro';
import Md from '../../ui/Md.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'vendorList'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, vendors, clean, ctx } = Astro.props;
const sectionTone = toneFor(tone, ctx.index);
const inverse = sectionTone === 'inverse';

// Headings stay in order: vendor names sit one level under the section heading (h3, or h2 when the block
// has no heading of its own), and "Strengths", "Limits" and "Key facts" one level under the vendor name.
const VendorHeading = (heading ? 'h3' : 'h2') as 'h2' | 'h3';
const SubHeading = (heading ? 'h4' : 'h3') as 'h3' | 'h4';
const prefix = id ?? `vendor-list-${ctx.index}`;

const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');

/** One piece of a fact's provenance line: plain text, the source link or the checked-on date. */
type Part = { text: string; href?: string; datetime?: string };

// Spec 5.14: every competitor fact is sourced and dated. A competitor fact without a source or a
// checked-on date renders a placeholder and blocks publishing; "Not published" needs the date it was
// checked (spec 5.16) but has nothing to link to. Easy Clinic's own facts may omit both.
function provenance(vendor: string, strict: boolean, f: (typeof vendors)[number]['facts'][number]): Part[] {
  const notPublished = /^\s*not published/i.test(f.value);
  const source: Part | null = f.source
    ? { text: hostOf(f.source), href: f.source }
    : strict && !notPublished
      ? { text: need(Astro, `source for ${vendor}: ${f.label}`, null) }
      : null;
  const date: Part | null = f.checkedOn
    ? { text: formatDate(f.checkedOn), datetime: isoDate(f.checkedOn) }
    : strict
      ? { text: need(Astro, `checked-on date for ${vendor}: ${f.label}`, null) }
      : null;
  return [
    ...(source ? [{ text: 'Source: ' }, source] : []),
    ...(date ? [{ text: source ? ', checked on ' : 'Checked on ' }, date] : []),
  ];
}

const cards = vendors.map((v) => ({
  ...v,
  headingId: `${v.id}-name`,
  label: v.rank ? `${v.rank}. ${v.name}` : v.name,
  facts: v.facts.map((f) => ({ label: f.label, value: f.value, provenance: provenance(v.name, !v.us, f) })),
}));

// A short index at the top once the list is long enough to scroll past.
const showIndex = cards.length >= 4;
---

<Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={sectionTone}>
  {
    showIndex && (
      <nav aria-labelledby={`${prefix}-index`} class="mb-8">
        <p id={`${prefix}-index`} class:list={['text-sm font-semibold', inverse ? 'text-ink-inverse-muted' : 'text-ink-muted']}>
          Jump to a vendor
        </p>
        <ul class="mt-2 flex flex-wrap gap-2">
          {cards.map((v) => (
            <li>
              <a
                href={`#${v.id}`}
                class="inline-flex min-h-11 items-center rounded-full border border-line bg-surface px-4 font-medium text-link hover:border-blue-500 hover:text-link-hover"
              >
                {v.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="grid gap-6" data-clean={clean ? '' : undefined}>
    {
      cards.map((v) => (
        <article id={v.id} aria-labelledby={v.headingId} class:list={['vl-card card text-ink', clean ? 'vl-clean' : 'p-6 md:p-8', clean && v.us && 'vl-us']}>
          <header class:list={[clean && 'vl-head']}>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              {clean && (
                <span class="vl-rank" aria-hidden="true">
                  {v.rank ?? <Icon name="circle-dot" size={18} />}
                </span>
              )}
              <VendorHeading id={v.headingId}>{clean ? v.name : v.label}</VendorHeading>
              {clean && v.rank && <span class="sr-only">, ranked {v.rank}</span>}
              {/* Disclosure only: Easy Clinic gets the same structure and weight as every other vendor (spec 5.14). */}
              {v.us && (
                <span class="inline-flex items-center rounded-full border border-line-strong bg-surface-muted px-2.5 py-0.5 font-sans text-xs font-semibold text-ink-muted">
                  Our product
                </span>
              )}
            </div>
            <p class="mt-2">
              <span class="font-semibold text-ink-heading">Best for:</span> {v.bestFor}
            </p>
            {v.url && (
              <p>
                <a href={v.url} rel="noopener" class:list={['inline-flex min-h-11 items-center gap-1.5 font-semibold', clean && 'vl-site']}>
                  <span>{v.name} website</span>
                  <Icon name="arrow-up-right" size={16} />
                </a>
              </p>
            )}
          </header>

          <div class:list={[clean && 'vl-main']}>
          <Md text={v.body} class:list={[clean ? 'max-w-[60rem]' : 'max-w-[46rem]', clean ? '' : v.url ? 'mt-2' : 'mt-4']} minHeading={SubHeading === 'h4' ? 4 : 3} />

          <div class:list={['mt-6 grid gap-6 md:grid-cols-2', clean ? 'md:gap-5' : 'border-t border-line pt-6 md:gap-10']}>
            <div class:list={[clean && 'vl-panel vl-panel--pros']}>
              <SubHeading id={`${v.id}-strengths`} class="font-sans text-base font-semibold">
                Strengths
              </SubHeading>
              <ul class="mt-3 space-y-2" aria-labelledby={`${v.id}-strengths`}>
                {v.pros.map((item) => (
                  <li class="flex gap-2.5">
                    {clean ? <span class="vl-ico vl-ico--pro" aria-hidden="true"><Icon name="check" size={12} /></span> : <Icon name="check" size={18} class="mt-1 text-success" />}
                    <Md text={item} inline />
                  </li>
                ))}
              </ul>
            </div>
            <div class:list={[clean && 'vl-panel vl-panel--cons']}>
              <SubHeading id={`${v.id}-limits`} class="font-sans text-base font-semibold">
                Limits
              </SubHeading>
              <ul class="mt-3 space-y-2" aria-labelledby={`${v.id}-limits`}>
                {v.cons.map((item) => (
                  <li class="flex gap-2.5">
                    {clean ? <span class="vl-ico vl-ico--con" aria-hidden="true"><Icon name="minus" size={12} /></span> : <Icon name="minus" size={18} class="mt-1 text-ink-muted" />}
                    <Md text={item} inline />
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {v.facts.length > 0 && (
            <div class:list={['mt-6', !clean && 'border-t border-line pt-6']}>
              <SubHeading class="font-sans text-base font-semibold">Key facts</SubHeading>
              <dl class:list={['mt-3 grid sm:grid-cols-2 lg:grid-cols-3', clean ? 'gap-3' : 'gap-x-8 gap-y-4']}>
                {v.facts.map((f) => (
                  <div class:list={[clean && 'vl-fact']}>
                    <dt class="text-sm font-semibold text-ink-muted">{f.label}</dt>
                    <dd class="mt-0.5">
                      <Md text={f.value} inline class="font-semibold text-ink-heading" />
                      {f.provenance.length > 0 && (
                        // One expression, so no stray spaces land before the comma.
                        <span class="mt-1 block text-sm text-ink-muted">
                          {f.provenance.map((p) =>
                            p.href ? (
                              <a href={p.href} rel="noopener" class="vl-src underline">{p.text}</a>
                            ) : p.datetime ? (
                              <time datetime={p.datetime}>{p.text}</time>
                            ) : (
                              p.text
                            ),
                          )}
                        </span>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  /* Clean look. */
  .vl-clean {
    padding: 0;
    overflow: hidden;
    border: 1px solid #e3eaf5;
    border-radius: 20px;
    box-shadow:
      0 1px 2px rgb(16 42 84 / 0.04),
      0 18px 40px -30px rgb(16 42 84 / 0.3);
  }
  .vl-clean.vl-us {
    border: 1.5px solid var(--color-blue-500);
  }
  .vl-head {
    display: grid;
    gap: 0.25rem;
    padding: 1.25rem 1.25rem 1rem;
    border-bottom: 1px solid #e8eef7;
    background: linear-gradient(180deg, #f3f8ff, #ffffff);
  }
  .vl-us .vl-head {
    background: linear-gradient(180deg, #e6f1ff, #ffffff);
  }
  .vl-rank {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    background: var(--color-blue-500);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
  }
  .vl-site {
    min-height: 2.5rem;
    margin-top: 0.5rem;
    padding: 0 1rem;
    border: 1px solid #c9dcf5;
    border-radius: 9999px;
    background: var(--surface);
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .vl-site:hover {
    border-color: var(--color-blue-500);
  }
  .vl-main {
    padding: 1.25rem;
  }
  @media (min-width: 40rem) {
    .vl-head {
      padding: 1.5rem 2rem 1.25rem;
    }
    .vl-main {
      padding: 1.5rem 2rem 2rem;
    }
  }
  @media (min-width: 60rem) {
    .vl-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 2rem;
    }
    .vl-head > p:last-child:has(.vl-site) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .vl-site {
      margin-top: 0;
    }
  }
  .vl-panel {
    padding: 1.125rem 1.25rem;
    border: 1px solid;
    border-radius: 14px;
  }
  .vl-panel--pros {
    border-color: #cdeed9;
    background: #f3fbf6;
  }
  .vl-panel--cons {
    border-color: #f6dfbf;
    background: #fffaf2;
  }
  .vl-ico {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2rem;
    border-radius: 9999px;
    color: var(--color-white);
  }
  .vl-ico--pro {
    background: #00a046;
  }
  .vl-ico--con {
    background: #d98a1c;
  }
  .vl-fact {
    padding: 0.875rem 1rem;
    border: 1px solid #e3ecf8;
    border-radius: 12px;
    background: #f7faff;
  }

  /* The cards stay light on an inverse section, so markdown keeps its normal colours rather than the
     inverse section's white. */
  .vl-card :global(.prose-md strong) {
    color: var(--ink-heading);
  }
  .vl-card :global(.prose-md a) {
    color: var(--link);
  }
  .vl-card :global(.prose-md a:hover) {
    color: var(--link-hover);
  }
  /* Links inside strengths, limits and fact values are told apart from the text by more than colour. */
  .vl-card li :global(a),
  .vl-card dd :global(a) {
    text-decoration: underline;
  }
  /* A 44px tap target for the source link without spreading the small print. */
  .vl-src {
    position: relative;
  }
  .vl-src::after {
    content: '';
    position: absolute;
    inset: -0.875rem -0.25rem;
  }
</style>

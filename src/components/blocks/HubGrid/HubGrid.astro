---
import type { SectionValue } from '../../../schemas/sections';
import { getRegistry } from '../../../lib/content/registry';
import { isProduction } from '../../../lib/content/stage';
import Section from '../../ui/Section.astro';
import Icon from '../../ui/Icon.astro';
import { toneFor, type BlockContext } from '../types';

type Props = SectionValue<'hubGrid'> & { ctx: BlockContext };
const { id, eyebrow, heading, intro, tone, groups, columns, layout = 'cards', ctx } = Astro.props;
const sectionTone = toneFor(tone, ctx.index);

const registry = await getRegistry();

interface Card {
  href: string;
  label: string;
  description?: string;
  icon?: string;
  /** The target page has no content entry yet (preview only). */
  missing: boolean;
  /** Id of the "Not built yet" note, so the link's accessible description carries it too. */
  noteId?: string;
}

// Headings stay in order: group titles sit one level under the section heading (h3, or h2 when the
// block has no heading of its own); card titles sit under their group title, or at h3 when the group
// has none.
const GroupHeading = (heading ? 'h3' : 'h2') as 'h2' | 'h3';
const prefix = id ?? `hub-grid-${ctx.index}`;

// Spec 2.9: every hub links down to all its leaves. Label and description default to the target page's
// own link label and summary, so the hub stays in step with its pages. A leaf that is not rendered in
// this stage (a draft, or a page that does not exist, in production) drops out; in preview a leaf with
// no entry yet shows as a dashed card with a "Not built yet" note.
const visibleGroups = groups
  .map((group, g) => ({
    title: group.title,
    titleId: `${prefix}-group-${g + 1}`,
    CardHeading: (group.title && heading ? 'h4' : 'h3') as 'h3' | 'h4',
    cards: group.items.flatMap((item, i): Card[] => {
      const href = registry.urlFor(item.href);
      if (!href) return [];
      const target = registry.get(item.href.split('#')[0]);
      const missing = !target && !isProduction;
      return [
        {
          href,
          label: item.label ?? target?.label ?? href,
          description: item.description ?? target?.data.summary,
          icon: item.icon,
          missing,
          noteId: missing ? `${prefix}-${g + 1}-${i + 1}-status` : undefined,
        },
      ];
    }),
  }))
  .filter((group) => group.cards.length > 0);

// One column on phones, two from sm, then the requested count from lg.
const GRID = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];

// Panels layout: groups alternate blue and green (owner request 2026-10-30: #EAF5FF blue-50 for 1 and 3, #e8f5ee green-50 for 2 and 4).
const ACCENTS = [
  { tint: 'bg-blue-50', chip: 'bg-white text-blue-700', ink: 'text-blue-700' },
  { tint: 'bg-green-50', chip: 'bg-white text-green-700', ink: 'text-green-700' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

{
  visibleGroups.length > 0 && (
    <Section id={id} eyebrow={eyebrow} heading={heading} intro={intro} tone={sectionTone}>
      {layout === 'panels' ? (
        <div class="grid gap-5 md:gap-6">
          {visibleGroups.map(({ title, titleId, CardHeading, cards }, g) => {
            const accent = ACCENTS[g % ACCENTS.length];
            return (
              <div
                class:list={[
                  'overflow-hidden rounded-[18px] border border-line bg-surface text-ink',
                  title && 'lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] xl:grid-cols-[19rem_minmax(0,1fr)]',
                ]}
              >
                {title && (
                  // Phones and tablets: a header strip over the rows. Wide screens: a label column beside them.
                  <div class:list={['flex items-center gap-4 px-5 py-4 sm:px-6 lg:flex-col lg:items-start lg:justify-between lg:gap-8 lg:p-8', accent.tint]}>
                    <div class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-5">
                      <span class:list={['flex size-10 shrink-0 items-center justify-center rounded-full text-sm font-semibold tabular-nums shadow-sm lg:size-12 lg:text-base', accent.chip]} aria-hidden="true">
                        {pad(g + 1)}
                      </span>
                      <GroupHeading id={titleId} class="text-xl leading-tight text-ink-heading lg:text-2xl">
                        {title}
                      </GroupHeading>
                    </div>
                    <p class:list={['ml-auto text-sm font-medium lg:ml-0', accent.ink]}>
                      {cards.length} {cards.length === 1 ? 'module' : 'modules'}
                    </p>
                  </div>
                )}
                <ul class="divide-y divide-line" aria-labelledby={title ? titleId : undefined}>
                  {cards.map((card) => (
                    <li
                      class:list={[
                        'group relative flex gap-4 px-5 py-5 transition-colors hover:bg-grey-50 focus-within:bg-grey-50 sm:gap-5 sm:px-6 lg:px-8 lg:py-6',
                        card.missing && 'border-dashed',
                      ]}
                    >
                      {card.icon && (
                        <span class:list={['flex size-11 shrink-0 items-center justify-center rounded-control', accent.tint, accent.ink]}>
                          <Icon name={card.icon} size={22} />
                        </span>
                      )}
                      <div class="min-w-0 flex-1">
                        <CardHeading class="font-sans text-base font-semibold leading-snug sm:text-lg">
                          {/* The link's ::after covers the row, so the whole row is one tap target. */}
                          <a href={card.href} class="link-plain after:absolute after:inset-0 hover:no-underline" aria-describedby={card.noteId}>
                            {card.label}
                          </a>
                        </CardHeading>
                        {card.description && <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink-muted">{card.description}</p>}
                        {card.missing && (
                          <p id={card.noteId} class="mt-2 flex items-center gap-1.5 text-sm font-medium text-warning">
                            <Icon name="circle-dashed" size={16} />
                            <span>Not built yet</span>
                          </p>
                        )}
                      </div>
                      <span
                        class="hidden size-9 shrink-0 items-center justify-center self-center rounded-full border border-line text-link transition-colors group-hover:border-blue-500 group-hover:bg-blue-500 group-hover:text-white sm:flex"
                        aria-hidden="true"
                      >
                        <Icon name="arrow-right" size={18} class="transition-transform group-hover:translate-x-0.5" />
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
      ) : (
      <div class="grid gap-10 md:gap-12">
        {visibleGroups.map(({ title, titleId, CardHeading, cards }) => (
          <div>
            {title && (
              <GroupHeading id={titleId} class:list={['mb-4 text-xl leading-tight', sectionTone === 'inverse' && 'text-white']}>
                {title}
              </GroupHeading>
            )}
            <ul class:list={['grid gap-4', GRID]} aria-labelledby={title ? titleId : undefined}>
              {cards.map((card) => (
                <li
                  class:list={[
                    'card group relative flex h-full flex-col p-6 text-ink transition-colors hover:border-blue-500 focus-within:border-blue-500',
                    card.missing && 'border-dashed border-line-strong',
                  ]}
                >
                  {card.icon && (
                    <span class="mb-4 flex size-11 items-center justify-center rounded-control bg-blue-50 text-blue-700">
                      <Icon name={card.icon} size={22} />
                    </span>
                  )}
                  <CardHeading class="font-sans text-lg font-semibold leading-snug">
                    {/* The link's ::after covers the card, so the whole card is one tap target. */}
                    <a
                      href={card.href}
                      class="link-plain flex items-start justify-between gap-3 after:absolute after:inset-0 after:rounded-card hover:no-underline"
                      aria-describedby={card.noteId}
                    >
                      <span class="min-w-0 group-hover:underline">{card.label}</span>
                      <Icon name="arrow-right" size={18} class="mt-1 text-link transition-transform group-hover:translate-x-0.5" />
                    </a>
                  </CardHeading>
                  {card.description && <p class="mt-2 text-ink-muted">{card.description}</p>}
                  {card.missing && (
                    <p id={card.noteId} class="mt-auto flex items-center gap-1.5 pt-4 text-sm font-medium text-warning">
                      <Icon name="circle-dashed" size={16} />
                      <span>Not built yet</span>
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      )}
    </Section>
  )
}

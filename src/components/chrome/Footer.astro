---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import logo from '../../assets/logo/easyclinic-logo-white.png';
import { getRegistry } from '../../lib/content/registry';
import Icon from '../ui/Icon.astro';
import Flag from '../ui/Flag.astro';
import FooterGroupBody from './FooterGroupBody.astro';

const nav = (await getEntry('nav', 'nav'))!.data;
const site = (await getEntry('site', 'site'))!.data;
const registry = await getRegistry();
const countries = (await getCollection('countries')).filter((c) => c.data.flagship);

const resolve = (href: string) => (href.startsWith('/') ? registry.urlFor(href) : href);
const links = (list: (typeof nav.footer)[number]['links']) =>
  list.map((l) => ({ ...l, href: resolve(l.href), missing: l.href.startsWith('/') && !registry.get(l.href.split('#')[0]) })).filter((l) => l.href);
const groups = nav.footer
  .map((g) => ({ ...g, links: links(g.links), sections: g.sections.map((s) => ({ ...s, links: links(s.links) })).filter((s) => s.links.length) }))
  .filter((g) => g.links.length || g.sections.length);
// Below 1200px a "continued" column (the second half of a long list on desktop) folds back into its group, so phones
// and tablets get one Specialties group, not two.
const merged = groups.reduce<typeof groups>((acc, g) => {
  const prev = acc[acc.length - 1];
  if (g.continued && prev) acc[acc.length - 1] = { ...prev, links: [...prev.links, ...g.links], sections: [...prev.sections, ...g.sections] };
  else acc.push(g);
  return acc;
}, []);
const legal = nav.legal.map((l) => ({ ...l, href: resolve(l.href) })).filter((l) => l.href);

// Country phone numbers (spec 3.3): India and Kenya only, the two countries with their own office and number
// (owner decision 2026-10-23; the UAE and Nigeria use the India number).
const FOOTER_PHONES = ['in', 'ke'];
const contacts = countries
  .filter((c) => FOOTER_PHONES.includes(c.data.code.toLowerCase()))
  .sort((a, b) => FOOTER_PHONES.indexOf(a.data.code.toLowerCase()) - FOOTER_PHONES.indexOf(b.data.code.toLowerCase()))
  .map((c) => ({ country: c.data.name, code: c.data.code, phone: c.data.contact.phone }))
  .filter((c): c is { country: string; code: string; phone: string } => Boolean(c.phone));
const SOCIAL: Record<string, string> = { linkedin: 'LinkedIn', youtube: 'YouTube', facebook: 'Facebook', instagram: 'Instagram', x: 'X' };
const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-ink-inverse-muted" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Site links and contacts</h2>
  <div class="container-wide py-14 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_3fr]">
      {/* Tablets (640-1199px): the two paragraphs side by side and the contacts in a row under them, so the brand
          block uses the full width instead of a narrow column beside empty space. */}
      <div class="sm:grid sm:grid-cols-2 sm:gap-x-10 lg:block">
        <Image src={logo} alt={site.logoAlt} width={400} height={79} class="h-auto w-[188px] sm:col-span-2" />
        <p class="mt-4 max-w-xs text-[0.9375rem] leading-relaxed sm:max-w-none lg:max-w-xs">
          Easy Clinic is a secure and versatile healthcare software platform combining Electronic Medical Records (EMR), Practice
          Management, and Clinic Administration tools, designed for physicians, specialists, polyclinics, nursing homes, and
          multi-location clinic networks.
        </p>
        <p class="mt-3 max-w-xs text-[0.9375rem] leading-relaxed sm:mt-4 sm:max-w-none lg:mt-3 lg:max-w-xs">
          Built for an exceptional user experience, Easy Clinic integrates AI and automation to reduce clinical errors, enhance
          patient engagement, simplify documentation, and deliver intelligent, workflow-driven care across all levels of
          practice, boosting patient care and increasing revenues.
        </p>
        <div class="sm:col-span-2 sm:flex sm:flex-wrap sm:items-center sm:justify-between sm:gap-x-8 lg:block">
        <address class="mt-5 text-sm not-italic leading-relaxed">
          {site.address.street}, {site.address.city} {site.address.postalCode}, India<br />
          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="text-white">{site.phone}</a> ·
          <a href={`mailto:${site.email}`} class="text-white">{site.email}</a>
        </address>
        <ul class="mt-5 flex gap-2" aria-label="Easy Clinic on social media">
          {
            Object.entries(site.social).map(([key, url]) => (
              <li>
                <a href={url} class="flex size-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20" rel="noopener me" aria-label={`Easy Clinic on ${SOCIAL[key] ?? key}`}>
                  <Icon name={`brand-${key}`} size={18} />
                </a>
              </li>
            ))
          }
        </ul>
        </div>
      </div>

      {/* Phones: one tap-to-open section per group. */}
      <div class="sm:hidden">
        {
          merged.map((group) => (
            <details class="footer-acc border-t border-white/10 last:border-b">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-semibold text-white [&::-webkit-details-marker]:hidden">
                {group.title}
                <Icon name="chevron-down" size={20} class="footer-acc__chev text-white/70 transition-transform" />
              </summary>
              <nav aria-label={group.title} class="pb-6">
                <FooterGroupBody links={group.links} sections={group.sections} />
              </nav>
            </details>
          ))
        }
      </div>

      {/* Tablets: the groups two by two, long lists in two columns. */}
      <div class="hidden gap-x-10 gap-y-10 sm:grid sm:grid-cols-2 lg:hidden">
        {
          merged.map((group) => (
            <nav aria-label={group.title}>
              <p class="mb-4 font-display text-[1.3125rem] leading-tight font-semibold text-white">{group.title}</p>
              <FooterGroupBody links={group.links} sections={group.sections} split />
            </nav>
          ))
        }
      </div>

      {/* Desktop: five columns, a long list continuing in the next column under a hidden repeat of its title. */}
      <div class="hidden grid-cols-5 gap-8 lg:grid">
        {
          groups.map((group) => (
            <nav aria-label={group.continued ? `${group.title} (continued)` : group.title}>
              <p class:list={['mb-4 font-display text-[1.3125rem] leading-tight font-semibold text-white', group.continued && 'invisible']} aria-hidden={group.continued ? 'true' : undefined}>
                {group.title}
              </p>
              <FooterGroupBody links={group.links} sections={group.sections} />
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-6 border-t border-white/15 pt-8 md:flex-row md:items-center md:justify-between">
      <ul class="flex flex-wrap gap-3" aria-label="Call Easy Clinic">
        {
          contacts.map((c) => (
            <li>
              <a
                href={`tel:${c.phone.replace(/\s/g, '')}`}
                class="group flex items-center gap-3 rounded-card border border-white/10 bg-white/5 py-3 pr-5 pl-3 no-underline transition-colors hover:border-white/25 hover:bg-white/10"
              >
                <Flag code={c.code} size={40} />
                <span>
                  <span class="block text-xs font-semibold uppercase tracking-wider text-white">{c.country}</span>
                  <span class="block text-base font-semibold text-white">{c.phone}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <a href="#main" class="group flex items-center gap-3 self-start text-sm font-semibold text-white no-underline md:self-auto" data-back-to-top>
        Back to top
        {/* Outlined like the contact cards (1px white/10 border), brighter on hover. */}
        <span class="back-to-top-icon relative flex size-[38px] items-center justify-center rounded-full border border-white/10 text-white transition group-hover:-translate-y-0.5 group-hover:border-white/25">
          <Icon name="arrow-up" size={18} class="relative" />
        </span>
      </a>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-white/15 pt-6 text-sm md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.legalName}. Easy Clinic is a trading<br />name of {site.legalName}.</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {legal.map((l) => <li><a href={l.href} class="text-ink-inverse-muted hover:text-white">{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  {/* Decorative: the brand name scrolling right to left, full width, under everything else. Two identical runs make
      the loop seamless. Hidden from assistive tech; still with reduced motion. */}
  <div class="footer-marquee overflow-hidden pb-6 select-none" aria-hidden="true">
    <div class="footer-marquee-track flex w-max">
      {[0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {Array.from({ length: 4 }, () => (
            <>
              <span class="footer-marquee-word">Easy Clinic</span>
              <span class="footer-marquee-dot" />
            </>
          ))}
        </div>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer-acc[open] :global(.footer-acc__chev) {
    transform: rotate(180deg);
  }
  .footer-marquee-track {
    animation: footer-marquee 40s linear infinite;
  }
  .footer-marquee-word {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(4.5rem, 13vw, 12rem);
    line-height: 1.1;
    white-space: nowrap;
    /* Faint, brighter at the top and fading toward the bottom, as in the reference. */
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .footer-marquee-dot {
    flex-shrink: 0;
    width: clamp(0.75rem, 1.6vw, 1.5rem);
    aspect-ratio: 1;
    margin-inline: clamp(0.75rem, 2vw, 2rem);
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.09);
  }
  @keyframes footer-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-marquee-track {
      animation: none;
    }
  }

  /* One faint ring ripples out from the arrow and fades. Off with reduced motion. */
  .back-to-top-icon {
    isolation: isolate;
  }
  .back-to-top-icon::before,
  .back-to-top-icon::after {
    content: '';
    z-index: -1;
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.18);
    animation: back-to-top-ripple 2.4s ease-out infinite;
    pointer-events: none;
  }
  .back-to-top-icon::after {
    display: none;
  }
  @keyframes back-to-top-ripple {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .back-to-top-icon::before,
    .back-to-top-icon::after {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  // Smooth scroll for "Back to top" (an instant jump with reduced motion); the href still works without JS.
  document.querySelector('[data-back-to-top]')?.addEventListener('click', (event) => {
    event.preventDefault();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    document.getElementById('main')?.focus({ preventScroll: true });
  });
</script>

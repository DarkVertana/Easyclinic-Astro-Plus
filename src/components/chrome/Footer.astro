---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import logo from '../../assets/logo/easyclinic-logo-white.png';
import { getRegistry } from '../../lib/content/registry';
import { optionalConfirmed } from '../../lib/content/need';
import { isProduction } from '../../lib/content/stage';
import Icon from '../ui/Icon.astro';

const nav = (await getEntry('nav', 'nav'))!.data;
const site = (await getEntry('site', 'site'))!.data;
const registry = await getRegistry();
const countries = (await getCollection('countries')).filter((c) => c.data.flagship);

const resolve = (href: string) => (href.startsWith('/') ? registry.urlFor(href) : href);
const groups = nav.footer
  .map((g) => ({ ...g, links: g.links.map((l) => ({ ...l, href: resolve(l.href), missing: l.href.startsWith('/') && !registry.get(l.href) })).filter((l) => l.href) }))
  .filter((g) => g.links.length);
const legal = nav.legal.map((l) => ({ ...l, href: resolve(l.href) })).filter((l) => l.href);

// Country phone numbers with the named local contact (spec 3.3). Unknown contacts show as placeholders in preview.
const contacts = countries.map((c) => {
  const contact = c.data.contact;
  return {
    country: c.data.name,
    name: optionalConfirmed(`${c.data.name} contact name`, contact.name, contact.publishName === true),
    phone: contact.phone,
  };
});
const SOCIAL: Record<string, string> = { linkedin: 'LinkedIn', youtube: 'YouTube', facebook: 'Facebook', instagram: 'Instagram', x: 'X' };
const year = new Date().getFullYear();
---

<footer class="bg-navy-950 text-ink-inverse-muted" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Site links and contacts</h2>
  <div class="container-page py-14 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_3fr]">
      <div>
        <Image src={logo} alt={site.logoAlt} width={162} height={32} class="h-8 w-auto" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed">
          Clinic software for doctors, polyclinics, clinic chains and hospital OPDs. Run from Kolkata since {site.foundingYear}.
        </p>
        <address class="mt-5 text-sm not-italic leading-relaxed">
          {site.address.street}, {site.address.city} {site.address.postalCode}, India<br />
          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="text-white">{site.phone}</a> ·
          <a href={`mailto:${site.email}`} class="text-white">{site.email}</a>
        </address>
        <ul class="mt-5 flex gap-2" aria-label="EasyClinic on social media">
          {
            Object.entries(site.social).map(([key, url]) => (
              <li>
                <a href={url} class="flex size-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20" rel="noopener me" aria-label={`EasyClinic on ${SOCIAL[key] ?? key}`}>
                  <Icon name={`brand-${key}`} size={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
        {
          groups.map((group) => (
            <nav aria-label={group.title}>
              <p class="mb-3 font-semibold text-white">{group.title}</p>
              <ul class="space-y-2 text-sm">
                {group.links.map((l) => (
                  <li>
                    <a href={l.href} class:list={['text-ink-inverse-muted no-underline hover:text-white hover:underline', l.missing && !isProduction && 'underline decoration-dotted']}>
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-12 grid gap-4 border-t border-white/15 pt-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        // Only countries with a published number are listed; names appear once cleared to publish.
        contacts.filter((c) => c.phone).map((c) => (
          <div class="text-sm">
            <p class="font-semibold text-white">{c.country}</p>
            {c.name && <p>{c.name}</p>}
            <a href={`tel:${c.phone!.replace(/\s/g, '')}`} class="text-white">
              {c.phone}
            </a>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-white/15 pt-6 text-sm md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.legalName}. EasyClinic is a trading name of {site.legalName}.</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-2">
        {legal.map((l) => <li><a href={l.href} class="text-ink-inverse-muted hover:text-white">{l.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

---
import { getEntry } from 'astro:content';
import { stripSentinels } from '../../lib/content/sentinel';

interface Props {
  title: string;
  description: string;
  /** Canonical path with trailing slash. */
  path: string;
  canonical?: string;
  indexable: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: Record<string, unknown> | null;
  publishedTime?: Date;
  modifiedTime?: Date | null;
}

const { title, description, path, canonical, indexable, ogType = 'website', ogImage = '/og/default.png', jsonLd, modifiedTime } = Astro.props;
const site = (await getEntry('site', 'site'))!.data;
const canonicalUrl = canonical ?? new URL(path, site.url).href;
const image = new URL(ogImage, site.url).href;
const cleanTitle = stripSentinels(title);
const cleanDescription = stripSentinels(description);
// JSON-LD is serialised with "<" escaped so content can never close the script element.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<title>{cleanTitle}</title>
<meta name="description" content={cleanDescription} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="EasyClinic" />
<meta property="og:title" content={cleanTitle} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_GB" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitterHandle} />
<meta name="twitter:title" content={cleanTitle} />
<meta name="twitter:description" content={cleanDescription} />
<meta name="twitter:image" content={image} />
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{ld && <script type="application/ld+json" set:html={ld} />}

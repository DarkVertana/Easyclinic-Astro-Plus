---
import { getEntry } from 'astro:content';
import { stripSentinels } from '../../lib/content/sentinel';
import { isProduction } from '../../lib/content/stage';
import { OG_FALLBACK, ogImagePath } from '../../lib/seo/og-path';
import { ogImageUrl } from '../../pages/og/_origin';

interface Props {
  title: string;
  description: string;
  /** Canonical path with trailing slash. */
  path: string;
  /**
   * Absolute canonical URL; defaults to the site URL plus `path`. An empty string omits <link rel="canonical">
   * and og:url: the 404 page passes it, because Vercel serves that page at every missing URL and /404/ itself
   * answers 404, so a canonical there would point at a 4xx page.
   */
  canonical?: string;
  indexable: boolean;
  ogType?: 'website' | 'article';
  /** Defaults to the page's generated card (src/pages/og/[...path].png.ts) for content-backed pages, else /og/default.png. */
  ogImage?: string;
  jsonLd?: Record<string, unknown> | null;
  publishedTime?: Date;
  modifiedTime?: Date | null;
}

// Astro.locals.page is set by src/pages/[...path].astro, whose pages all get a generated 1200x630 card.
const generatedImage = Astro.locals.page ? ogImagePath(Astro.locals.page.path) : OG_FALLBACK;
const { title, description, path, canonical, indexable, ogType = 'website', ogImage = generatedImage, jsonLd, modifiedTime } = Astro.props;
const site = (await getEntry('site', 'site'))!.data;
const canonicalUrl = canonical === '' ? null : (canonical ?? new URL(path, site.url).href);
// Absolute on the origin that serves this build's cards: the site URL in production, the deployment's own URL on
// a Vercel preview (src/pages/og/_origin.ts). The canonical URL above stays on the site URL everywhere.
const image = ogImageUrl(ogImage, { production: isProduction, siteUrl: site.url, env: process.env, pageOrigin: Astro.url.origin });
const cleanTitle = stripSentinels(title);
const cleanDescription = stripSentinels(description);
// JSON-LD is serialised with "<" escaped so content can never close the script element.
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<title>{cleanTitle}</title>
<meta name="description" content={cleanDescription} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="EasyClinic" />
<meta property="og:title" content={cleanTitle} />
<meta property="og:description" content={cleanDescription} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_GB" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={site.twitterHandle} />
<meta name="twitter:title" content={cleanTitle} />
<meta name="twitter:description" content={cleanDescription} />
<meta name="twitter:image" content={image} />
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{ld && <script type="application/ld+json" set:html={ld} />}

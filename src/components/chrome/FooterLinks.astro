---
import { isProduction } from '../../lib/content/stage';

/** One list of footer links. A link to a page that does not exist yet is dotted in preview. */
interface Props {
  links: { label: string; href: string | null; missing: boolean }[];
  class?: string;
}

const { links, class: className } = Astro.props;
---

<ul class:list={['space-y-2.5 text-[0.9375rem]', className]}>
  {
    links.map((l) => (
      <li>
        <a href={l.href} class:list={['text-ink-inverse-muted no-underline hover:text-white hover:underline', l.missing && !isProduction && 'underline decoration-dotted']}>
          {l.label}
        </a>
      </li>
    ))
  }
</ul>

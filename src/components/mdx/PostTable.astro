---
/**
 * Tables in blog posts (docs/components.md rule 3): below 640px every body row becomes a card and each
 * cell shows its column header, so the page never scrolls sideways and there is no scroll region. The
 * Markdown table arrives as the slot (thead and tbody from MDX); each body cell gets its column header as
 * `data-label`, and explicit roles keep the table semantics when the cells are display:block (Safari drops
 * them otherwise). Guides keep their own table styles.
 */
import { labelTableCells } from '../../lib/content/post-table';

const html = labelTableCells(await Astro.slots.render('default'));
---

<div class="post-table">
  <table role="table" set:html={html} />
</div>

<style>
  .post-table :global(td),
  .post-table :global(th) {
    overflow-wrap: break-word;
  }

  /* Below 640px every body row becomes a card; each cell carries its column label (spec 7.5). */
  @media (width < 40rem) {
    .post-table table,
    .post-table :global(tbody),
    .post-table :global(tr),
    .post-table :global(th),
    .post-table :global(td) {
      display: block;
      width: auto;
    }

    .post-table table {
      border: 0;
      overflow: visible;
    }

    .post-table :global(thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .post-table :global(tbody tr) {
      padding-block: 0.5rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-card, 0.75rem);
      background: var(--surface);
    }

    .post-table :global(tbody tr + tr) {
      margin-top: 1rem;
    }

    .post-table :global(tbody td),
    .post-table :global(tbody th) {
      padding: 0.5rem 1rem;
      border: 0;
      background: transparent;
    }

    .post-table :global(tbody [data-label]::before) {
      content: attr(data-label);
      /* Empty alt text: screen readers already announce the column header. */
      content: attr(data-label) / '';
      display: block;
      margin-bottom: 0.125rem;
      font-size: var(--text-sm, 0.875rem);
      font-weight: 600;
      color: var(--ink-muted);
    }
  }
</style>

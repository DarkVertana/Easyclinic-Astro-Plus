---
import Md from '../ui/Md.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  heading: string;
  items: Array<{ question: string; answer: string }>;
  tone?: 'plain' | 'wash';
}

const { heading, items, tone = 'plain' } = Astro.props;
---

{
  items.length > 0 && (
    <section id="faq" aria-labelledby="faq-heading" class:list={['section-y', tone === 'wash' ? 'bg-surface-alt' : 'bg-surface']}>
      <div class="container-measure">
        <h2 id="faq-heading">{heading}</h2>
        {/* Answers are in the server HTML; <details> only collapses them visually (spec 7.1). */}
        <div class="mt-8 divide-y divide-line border-y border-line">
          {items.map((item) => (
            <details class="group py-1" data-faq>
              <summary class="flex min-h-12 cursor-pointer list-none items-start justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
                <h3 class="font-sans text-lg font-semibold leading-snug text-ink-heading">{item.question}</h3>
                <Icon name="plus" size={20} class="mt-1 text-blue-600 transition-transform group-open:rotate-45" />
              </summary>
              <Md text={item.answer} class="pb-5 text-ink" />
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

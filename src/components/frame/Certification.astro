---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import certificate from '../../assets/images/dhs-certificate.png';
import dhaLogo from '../../assets/images/dha-logo.png';
import shaIntegrated from '../../assets/images/sha-logo.png';
import badgeSha from '../../assets/images/sha.png';
import badgeAuth from '../../assets/images/auth.png';
import badgeCln from '../../assets/images/cln.png';
import badgeSec from '../../assets/images/sec.png';
import badgeShr from '../../assets/images/shr.png';
import badgeR4 from '../../assets/images/R4.png';

/**
 * Home page certification section, below the feature pills: a white certificate card on the left (DHA and
 * SHA marks, the "DHA certified" heading, the certificate, which opens full size in a dialog, and its
 * number), and on the right the eyebrow, heading and intro over six capability cards, one per certified
 * scope badge. Certificate facts checked against service.dha.go.ke/api/public/verify on 2026-10-29.
 */
const certificateNumber = 'CERT-2026-MHA2Q9YM';
const certificateAlt =
  'Digital Health System Certification issued by the Digital Health Agency, Kenya, to Easy Clinic of Novel Software Solutions Private Ltd, certified 17 October 2026, expiry 16 October 2028, digitally signed';
const full = await getImage({ src: certificate, format: 'webp', quality: 90 });

const scopes: { badge: ImageMetadata; code: string; title: string; items: string[] }[] = [
  {
    badge: badgeSha,
    code: 'SHA',
    title: 'SHA & registry integration',
    items: [
      'Patient/client registry lookup',
      'Facility Registry verification',
      'Healthcare professional registry validation',
      'SHA eligibility and benefit checks',
      'Sub-benefits, interventions, coverage and utilisation',
    ],
  },
  {
    badge: badgeAuth,
    code: 'AUTH',
    title: 'Visit & authorization workflows',
    items: [
      'OTP-based visit authorization',
      'Biometric authorization support',
      'Claim, preauthorization and authorization status callbacks',
      'Correlation IDs and protected transaction audit trails',
    ],
  },
  {
    badge: badgeShr,
    code: 'SHR',
    title: 'Shared Health Record',
    items: [
      'Open-visit and consent lifecycle',
      'Consent OTP verification and refresh',
      'Patient record retrieval',
      'FHIR collection Bundle submission and read-back',
      'Encounter completion and visit closure',
    ],
  },
  {
    badge: badgeR4,
    code: 'R4',
    title: 'FHIR R4 & Kenya Core exchange',
    items: [
      'Patient, Encounter and Observation',
      'Condition and AllergyIntolerance',
      'MedicationRequest and e-prescribing resources',
      'ServiceRequest and DiagnosticReport',
      'Clinical summaries and interoperable FHIR Bundles',
    ],
  },
  {
    badge: badgeCln,
    code: 'CLN',
    title: 'Certified clinical & reporting capabilities',
    items: [
      'Patient demographics and CPOE',
      'Problem list and medication management',
      'Clinical decision support and clinical summaries',
      'Electronic prescribing and quality measures',
      'Immediate disease, IDSR, PHE, IHR and routine reporting',
    ],
  },
  {
    badge: badgeSec,
    code: 'SEC',
    title: 'Terminology, security & assurance',
    items: [
      'ICD-11, SNOMED CT and LOINC coded exchange',
      'HPT-aligned medication workflows',
      'MFA, RBAC and automatic session timeout',
      'Immutable audit history and data-integrity controls',
      'Encryption, encrypted backups and disaster-recovery evidence',
    ],
  },
];
---

<section id="certification" aria-labelledby="certification-heading" class="cert py-14 md:py-20">
  <div class="container-page">
    <div class="cert__layout">
      {/* ---- Left: the certificate card. ---- */}
      <aside class="cert__card" aria-labelledby="certification-card-heading">
        <div class="cert__marks">
          <Image src={dhaLogo} alt="Digital Health Agency, Kenya" width={256} class="cert__mark" loading="lazy" />
          <Image src={shaIntegrated} alt="SHA Integrated: Social Health Authority, Kenya" width={272} class="cert__mark cert__mark--sha" loading="lazy" />
        </div>

        <p class="cert__kicker">Digital Health System Certification</p>
        <h3 id="certification-card-heading" class="cert__card-heading">Limsoft Pro is DHA certified</h3>
        <p class="cert__card-body">
          Limsoft Pro has satisfactorily met the compliance and conformance requirements of the Kenya Digital Health Certification Framework for the declared scope.
        </p>

        <button type="button" class="cert__doc" data-cert-open aria-haspopup="dialog" aria-label="Enlarge the Digital Health Agency certificate">
          <Image src={certificate} alt={certificateAlt} widths={[400, 800, certificate.width]} sizes="(min-width: 64rem) 392px, (min-width: 40rem) 60vw, 100vw" loading="lazy" decoding="async" class="cert__doc-image" />
        </button>

        <p class="cert__number">
          <span class="cert__number-label">Certificate no.</span>
          <span class="cert__number-value">{certificateNumber}</span>
        </p>

        <dialog class="cert__dialog" data-cert-dialog aria-label="Digital Health Agency certificate, enlarged">
          <button type="button" class="cert__close" data-cert-close aria-label="Close enlarged certificate">
            <Icon name="x" size={24} />
          </button>
          <img src={full.src} width={full.attributes.width} height={full.attributes.height} alt={certificateAlt} loading="lazy" decoding="async" />
        </dialog>
      </aside>

      {/* ---- Right: the heading and the six scope cards. ---- */}
      <div class="cert__main">
        <p class="cert__eyebrow">DHA certified · SHA compliant · FHIR R4</p>
        <h2 id="certification-heading" class="cert__heading">Built for Kenya's connected digital health ecosystem</h2>
        <p class="cert__intro">
          The latest Limsoft healthcare platform brings DHA/AfyaConnect interoperability, SHA workflows, Kenya Core-aligned FHIR R4 exchange, national terminology support, public-health reporting and strengthened security controls into the day-to-day hospital workflow.
        </p>

        <ul class="cert__grid">
          {
            scopes.map((s) => (
              <li class="cert__scope">
                <Image src={s.badge} alt={s.code} width={96} class="cert__badge" loading="lazy" />
                <h3 class="cert__scope-title">{s.title}</h3>
                <ul class="cert__list">
                  {s.items.map((item) => (
                    <li>
                      <span class="cert__check" aria-hidden="true">
                        <Icon name="check" size={10} />
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const open = document.querySelector<HTMLButtonElement>('[data-cert-open]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-cert-dialog]');
  if (open && dialog) {
    open.addEventListener('click', () => dialog.showModal());
    // A click on the backdrop or the close button closes it; Escape is native to <dialog>.
    dialog.addEventListener('click', (e) => {
      const target = e.target as Element;
      if (target === dialog || target.closest('[data-cert-close]')) dialog.close();
    });
  }
</script>

<style>
  .cert {
    background: #f4f7fb;
    border-block: 1px solid #e6edf6;
  }

  /* Phones: the card above the content; from lg: the card in a fixed left column, the content beside it. */
  .cert__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 40rem) {
    .cert__layout {
      gap: 2.5rem;
    }
  }
  /* From lg: a 440px card column and a 40px gap to the content. */
  @media (min-width: 64rem) {
    .cert__layout {
      grid-template-columns: 440px minmax(0, 1fr);
      align-items: start;
      gap: 40px;
    }
  }

  /* ---- The certificate card. ---- */
  .cert__card {
    padding: 1.5rem;
    border: 1px solid #e3eaf5;
    border-radius: 20px;
    background: var(--color-white);
    box-shadow:
      0 1px 2px rgb(16 42 84 / 0.04),
      0 24px 48px -28px rgb(16 42 84 / 0.22);
  }
  @media (min-width: 40rem) {
    .cert__card {
      max-width: 28rem;
    }
  }
  @media (min-width: 64rem) {
    .cert__card {
      position: sticky;
      top: 6rem;
      max-width: none;
    }
  }
  .cert__marks {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 0;
    border: 1px solid #e3eaf5;
    border-radius: 12px;
    background: var(--color-white);
  }
  .cert__mark {
    height: auto;
    width: 8rem;
  }
  .cert__mark--sha {
    width: 8.5rem;
  }
  .cert__kicker {
    margin-top: 1rem;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #e5484d;
  }
  .cert__card-heading {
    margin-top: 0.5rem;
    font-size: 2rem;
    line-height: 1.15;
    color: #08275a;
  }
  @media (min-width: 40rem) {
    .cert__card-heading {
      font-size: 40px;
    }
  }
  .cert__card-body {
    margin-top: 0.75rem;
    font-size: 18px;
    line-height: 1.6;
    color: #181818;
  }
  .cert__doc {
    display: block;
    width: 100%;
    margin-top: 1.25rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: var(--color-white);
    cursor: zoom-in;
  }
  .cert__doc:focus-visible {
    outline: 2px solid var(--color-blue-500);
    outline-offset: 2px;
  }
  .cert__doc-image {
    display: block;
    width: 100%;
    height: auto;
  }
  .cert__number {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid #e3eaf5;
    border-radius: 12px;
    background: #f8fafd;
  }
  .cert__number-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .cert__number-value {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-heading);
    overflow-wrap: anywhere;
  }

  /* ---- The heading block. ---- */
  .cert__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #e5484d;
  }
  .cert__eyebrow::before {
    content: '';
    width: 1.25rem;
    height: 3px;
    border-radius: 3px;
    background: #e5484d;
  }
  .cert__heading {
    margin-top: 1rem;
    max-width: 34rem;
    font-size: 2rem;
    line-height: 1.15;
    color: #08275a;
  }
  @media (min-width: 40rem) {
    .cert__heading {
      font-size: 40px;
    }
  }
  .cert__intro {
    margin-top: 1rem;
    max-width: 48rem;
    font-size: 18px;
    line-height: 1.65;
    color: #181818;
  }

  /* ---- The six scope cards, two across from sm. ---- */
  .cert__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .cert__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .cert__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (min-width: 75rem) {
    .cert__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .cert__scope {
    padding: 1.125rem 1.25rem 1.25rem;
    border: 1px solid #e3eaf5;
    border-radius: 14px;
    background: var(--color-white);
    box-shadow: 0 1px 2px rgb(16 42 84 / 0.04);
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }
  .cert__scope:hover {
    border-color: #c7dcf5;
    box-shadow: 0 12px 28px -20px rgb(16 42 84 / 0.3);
  }
  /* The badge PNGs carry their own light-blue ground, so each shows as a small chip. */
  .cert__badge {
    display: block;
    width: auto;
    height: 2.625rem;
    border-radius: 8px;
  }
  .cert__scope-title {
    margin-top: 0.75rem;
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.35;
    font-weight: 700;
    color: var(--color-navy-900);
  }
  .cert__list {
    display: grid;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cert__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 16px;
    line-height: 1.55;
    color: #181818;
  }
  /* A solid green disc with a white tick, like the feature pills. */
  .cert__check {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-top: 0.25rem;
    border-radius: 9999px;
    background: #00c554;
    color: var(--color-white);
  }

  /* ---- The enlarged certificate. ---- */
  .cert__dialog {
    max-width: min(96vw, 1400px);
    max-height: 94vh;
    padding: 0;
    margin: auto;
    border: 0;
    border-radius: var(--radius-card, 0.75rem);
    background: var(--color-white);
    overflow: auto;
  }
  .cert__dialog::backdrop {
    background: rgb(10 22 40 / 0.8);
  }
  .cert__dialog img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cert__close {
    position: sticky;
    top: 0.75rem;
    float: right;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0.75rem 0.75rem -3.5rem 0;
    border-radius: 9999px;
    background: var(--color-navy-900);
    color: var(--color-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .cert__doc,
    .cert__scope {
      transition: none;
    }
  }
</style>

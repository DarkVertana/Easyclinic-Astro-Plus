---
import { Image } from 'astro:assets';
import americares from '../../assets/images/client-logo/1a.jpg';
import penda from '../../assets/images/client-logo/2a.jpg';
import cimas from '../../assets/images/client-logo/3aaa.jpg';
import qualitas from '../../assets/images/client-logo/5a.jpg';
import who from '../../assets/images/client-logo/6a.jpg';
import northStar from '../../assets/images/client-logo/7a.jpg';
import caringMinds from '../../assets/images/client-logo/Caring-Mindsa.jpg';
import germanOsteo from '../../assets/images/client-logo/German-Osteoa.jpg';
import sethGsKem from '../../assets/images/client-logo/SETH-G-S-K-E-M-HOSPITAL.jpg';
import daleView from '../../assets/images/client-logo/THE-DALE-VIEWa.jpg';

/**
 * Home page client logo strip, above "What is Easy Clinic?": one row of logos sliding right to left in their
 * own colours. The set is rendered twice so the loop is seamless; the copy is hidden from assistive tech,
 * and with reduced motion the strip stops and wraps into a static grid.
 */
const logos = [
  { src: americares, alt: 'AmeriCares' },
  { src: penda, alt: 'Penda Health' },
  { src: cimas, alt: 'CIMAS' },
  { src: qualitas, alt: 'Qualitas Health' },
  { src: who, alt: 'World Health Organization' },
  { src: northStar, alt: 'North Star Alliance' },
  { src: caringMinds, alt: 'Caring Minds Institute of Mental Health' },
  { src: germanOsteo, alt: 'German Osteo Care' },
  { src: sethGsKem, alt: 'Seth GS Medical College and KEM Hospital' },
  { src: daleView, alt: 'The Dale View, Punalal' },
];
---

<section id="clients" aria-labelledby="clients-heading" class="section-y">
  <div class="container-page text-center">
    <h2 id="clients-heading" class="min-[64rem]:whitespace-nowrap min-[64rem]:text-[min(2.6vw,2.441rem)]">
      Physicians, specialists and clinic chains using<br class="hidden sm:inline" /> Easy Clinic around the world
    </h2>
    <p class="mx-auto mt-4 max-w-[46rem] text-[1.0625rem] leading-[1.75] text-ink md:text-[1.125rem] min-[64rem]:max-w-[62rem]">
      From single-doctor clinics to multi-location chains, these teams use Easy Clinic every day.
    </p>
  </div>

  <div class="clients__strip mt-10 md:mt-14">
    <div class="clients__track">
      {
        [0, 1].map((copy) => (
          <ul class="clients__set" aria-hidden={copy === 1 ? 'true' : undefined} data-copy={copy}>
            {logos.map((logo) => (
              <li class="clients__item">
                <Image
                  src={logo.src}
                  alt={copy === 1 ? '' : logo.alt}
                  widths={[240, 480]}
                  sizes="(min-width: 960px) 16vw, (min-width: 640px) 22vw, 30vw"
                  loading="lazy"
                  decoding="async"
                  class="clients__logo"
                />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* --per logos are in view at once; each logo plus its gap takes an equal share of the strip's width. */
  .clients__strip {
    --per: 3;
    --gap: 1.5rem;
    container-type: inline-size;
    overflow: hidden;
    /* Soften the logos entering and leaving at the edges. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .clients__track {
    display: flex;
    width: max-content;
    animation: clients-scroll 35s linear infinite;
  }

  .clients__strip:hover .clients__track {
    animation-play-state: paused;
  }

  .clients__set {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--gap);
    padding-inline-end: var(--gap);
    margin: 0;
    list-style: none;
  }

  .clients__item {
    flex-shrink: 0;
    width: calc(100cqi / var(--per) - var(--gap));
    aspect-ratio: 12 / 5;
  }

  .clients__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (min-width: 40rem) {
    .clients__strip {
      --per: 4;
      --gap: 2.5rem;
    }
  }

  @media (min-width: 60rem) {
    .clients__strip {
      --per: 6;
      --gap: 3rem;
    }
  }

  @keyframes clients-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* No motion: stop the strip, drop the duplicate set and wrap the logos into a centred grid. */
  @media (prefers-reduced-motion: reduce) {
    .clients__strip {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .clients__track {
      display: block;
      width: auto;
      animation: none;
    }
    .clients__item {
      width: 180px;
    }
    .clients__set {
      flex-wrap: wrap;
      flex-shrink: 1;
      justify-content: center;
      row-gap: 1.5rem;
      padding-inline: 1rem;
    }
    .clients__set[data-copy='1'] {
      display: none;
    }
  }
</style>

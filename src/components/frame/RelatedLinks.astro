---
import { getRegistry } from '../../lib/content/registry';
import Icon from '../ui/Icon.astro';
import Flag from '../ui/Flag.astro';

interface Props {
  heading: string;
  links: Array<{ href: string; label?: string; description?: string }>;
  /** Show country pages as a row of flag pills above the cards (the home page) instead of as cards. */
  countryPills?: boolean;
  /** The light-blue section background instead of white (/about-us/). */
  tinted?: boolean;
}

const { heading, links, countryPills = false, tinted = false } = Astro.props;
const registry = await getRegistry();
// A country page shows its flag; other targets get an icon for what they are.
const ICONS: [string, string][] = [
  ['/features/', 'layers'],
  ['/ai/', 'sparkles'],
  ['/curapilot/', 'stethoscope'],
  ['/trust/', 'shield-check'],
  ['/pricing/', 'wallet'],
  ['/solutions/', 'building-2'],
  ['/compare/', 'list-checks'],
  ['/blog/', 'file-text'],
];
// Pages with an icon of their own, matched before the prefixes above, so a row of solution or feature cards
// does not repeat one icon (owner request 2026-10-30).
const PAGE_ICONS: Record<string, string> = {
  '/solutions/solo-clinic/': 'user-round',
  '/solutions/polyclinic/': 'users',
  '/solutions/clinic-chain/': 'network',
  '/solutions/hospital-opd/': 'hospital',
  '/solutions/ngo-clinics/': 'heart-handshake',
  '/features/appointment-scheduling/': 'calendar-clock',
  '/features/emr/': 'notebook-pen',
  '/features/billing/': 'receipt',
  '/features/insurance-claims/': 'shield-check',
  '/features/lab/': 'flask-conical',
  '/features/pharmacy-and-inventory/': 'pill',
  '/features/whatsapp/': 'message-circle',
  '/features/telehealth/': 'video',
  '/features/patient-engagement/': 'message-circle-heart',
  '/features/reports-and-dashboards/': 'chart-column',
  '/features/revenue-management/': 'trending-up',
  '/features/multi-location/': 'map-pin',
};
const iconFor = (href: string) => PAGE_ICONS[href.split('#')[0]] ?? ICONS.find(([prefix]) => href.startsWith(prefix))?.[1] ?? 'arrow-up-right';
// Curated next steps (spec 2.9), replacing the shared "Explore the rest of the platform" block.
const items = links
  .map((l) => {
    const target = registry.get(l.href.split('#')[0]);
    const href = registry.urlFor(l.href);
    const country = (target?.data as { country?: { id: string } } | undefined)?.country?.id;
    return href
      ? { href, label: l.label ?? target?.label ?? l.href, description: l.description ?? target?.data.summary, missing: !target, country, icon: iconFor(l.href) }
      : null;
  })
  .filter((l): l is NonNullable<typeof l> => l !== null);
// Markets not in the page's related links (the home page holds nine, the schema maximum). A market with its
// own country page names it as the third value and the pill links there once that page is published;
// the rest go to the countries hub (the old /emr-software-in-*/ URLs redirect there too).
const OTHER_MARKETS: [string, string, string?][] = [
  ['MU', 'Mauritius', '/best-clinic-management-software-mauritius/'],
  ['QA', 'Qatar', '/best-clinic-management-software-qatar/'],
  ['RW', 'Rwanda', '/best-clinic-management-software-rwanda/'],
  ['SC', 'Seychelles', '/best-clinic-management-software-seychelles/'],
  ['SO', 'Somalia', '/best-clinic-management-software-somalia/'],
  ['ZA', 'South Africa', '/best-clinic-management-software-south-africa/'],
  ['SR', 'Suriname', '/best-clinic-management-software-suriname/'],
  ['TZ', 'Tanzania', '/best-clinic-management-software-tanzania/'],
  ['TT', 'Trinidad and Tobago', '/best-clinic-management-software-trinidad-and-tobago/'],
  ['UG', 'Uganda', '/best-clinic-management-software-uganda/'],
];
const hubHref = registry.urlFor('/countries/');
const otherPills =
  countryPills && hubHref
    ? OTHER_MARKETS.map(([country, name, page]) => ({ href: (page && registry.urlFor(page)) || hubHref, label: `Best Clinic Software in ${name}`, country }))
    : [];
// Every market in one alphabetical row; the UAE sorts by its full name.
const sortName = (label: string) => label.replace('Clinic Software in ', '').replace(/^UAE$/, 'United Arab Emirates');
const pills = countryPills
  ? [...items.filter((i) => i.country).map((i) => ({ href: i.href, label: i.label, country: i.country! })), ...otherPills].sort((a, b) =>
      sortName(a.label).localeCompare(sortName(b.label)),
    )
  : [];
const cards = countryPills ? items.filter((i) => !i.country) : items;
---

{
  items.length > 0 && (
    <nav aria-labelledby="related-heading" class:list={['section-y', tinted ? 'bg-surface-alt' : 'bg-surface', countryPills && 'pb-0!']}>
      <div class="container-page">
        {/* On the home page a hairline closes the section, as wide as the content rather than the screen. */}
        <div class:list={[countryPills && 'border-b border-[#c7c7c7] pb-14 md:pb-20']}>
        <h2 id="related-heading" class:list={['text-2xl md:text-3xl', countryPills && 'text-center']}>{heading}</h2>
        {pills.length > 0 && (
          <ul class="mt-8 flex flex-wrap justify-center gap-3" aria-label="Easy Clinic by country">
            {pills.map((item) => (
              <li>
                <a href={item.href} class="country-pill group inline-flex min-h-11 items-center gap-2.5 rounded-full py-1.5 pr-5 pl-2 font-medium text-ink-heading no-underline">
                  <Flag code={item.country} size={28} class="ring-1 ring-line" />
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        )}
        {cards.length > 0 && (
        <ul class:list={['grid gap-4 sm:grid-cols-2', pills.length > 0 ? 'mt-6' : 'mt-8', cards.length % 4 === 0 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
          {cards.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['related-card group flex h-full items-center gap-4 rounded-card border bg-surface p-5 no-underline', item.missing && 'border-dashed']}
              >
                {item.country ? (
                  <Flag code={item.country} size={40} class="ring-1 ring-line" />
                ) : (
                  <span class="related-card__icon flex size-10 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-700" aria-hidden="true">
                    <Icon name={item.icon} size={19} />
                  </span>
                )}
                <span class="min-w-0 flex-1">
                  <span class="flex items-center justify-between gap-2 font-semibold text-ink-heading group-hover:text-blue-700">
                    {item.label}
                    <Icon name="arrow-right" size={16} class="shrink-0 text-ink-muted transition-[translate,color] duration-150 group-hover:translate-x-1 group-hover:text-blue-700" />
                  </span>
                  {item.description && (
                    <span class="mt-1 line-clamp-2 text-sm leading-[1.55] text-ink-muted">{item.description}</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
        )}
        </div>
      </div>
    </nav>
  )
}

<style>
  .related-card {
    border-color: #c7c7c7;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }
  /* A light wash and a soft blue edge; the arrow nudges right. */
  .related-card:hover,
  .related-card:focus-visible {
    background: #f7fbff;
    border-color: var(--color-blue-200);
  }
  .country-pill {
    border: 1.5px solid var(--color-blue-500);
    background: var(--surface);
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }
  .country-pill:hover,
  .country-pill:focus-visible {
    background: #f7fbff;
    border-color: var(--color-blue-700);
    color: var(--color-blue-700);
  }
  .related-card__icon {
    transition: background-color 200ms ease;
  }
  .related-card:hover .related-card__icon {
    background: var(--color-blue-100);
  }
</style>

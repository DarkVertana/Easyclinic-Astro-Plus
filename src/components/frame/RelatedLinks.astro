---
import { getRegistry } from '../../lib/content/registry';
import Icon from '../ui/Icon.astro';

interface Props {
  heading: string;
  links: Array<{ href: string; label?: string; description?: string }>;
}

const { heading, links } = Astro.props;
const registry = await getRegistry();
// Curated next steps (spec 2.9), replacing the shared "Explore the rest of the platform" block.
const items = links
  .map((l) => {
    const target = registry.get(l.href.split('#')[0]);
    const href = registry.urlFor(l.href);
    return href ? { href, label: l.label ?? target?.label ?? l.href, description: l.description ?? target?.data.summary, missing: !target } : null;
  })
  .filter((l): l is NonNullable<typeof l> => l !== null);
---

{
  items.length > 0 && (
    <nav aria-labelledby="related-heading" class="section-y bg-surface">
      <div class="container-page">
        <h2 id="related-heading" class="text-2xl md:text-3xl">{heading}</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <li>
              <a href={item.href} class:list={['card group flex h-full flex-col p-5 no-underline hover:border-blue-500', item.missing && 'border-dashed border-line-strong']}>
                <span class="flex items-center justify-between gap-2 font-semibold text-ink-heading">
                  {item.label}
                  <Icon name="arrow-right" size={18} class="text-blue-600 transition-transform group-hover:translate-x-0.5" />
                </span>
                {item.description && <span class="mt-2 text-sm text-ink-muted">{item.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

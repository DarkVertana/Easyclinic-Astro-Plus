---
import type { ReferenceDataEntry } from 'astro:content';
import type { MediaProps } from '../ui/Screenshot.astro';
import Button from '../ui/Button.astro';
import Md from '../ui/Md.astro';
import Screenshot from '../ui/Screenshot.astro';
import AuthorByline from './AuthorByline.astro';
import HeroStrip from './HeroStrip.astro';

interface Props {
  eyebrow?: string;
  h1: string;
  openingAnswer: string;
  ctas: { primary: { label: string; href: string; event?: string }; secondary?: { label: string; href: string; event?: string } };
  heroMedia?: MediaProps;
  heroStrip?: { regulators: ReferenceDataEntry<'regulators'>[]; ratings: boolean; study: boolean };
  /** A narrower answer paragraph (40rem), so it wraps to the planned number of lines (the home page). */
  narrowLede?: boolean;
  /** No gap between the text and image columns on wide screens. */
  noColumnGap?: boolean;
  /** The text column (heading, answer, CTAs, ratings) runs the full width of its grid column beside the image (the home page). */
  fullWidthText?: boolean;
  /** The hero image without its grey border (owner request 2026-10-27: /contact-us/). */
  plainImage?: boolean;
  /** A hero image with 18px corners, full width when stacked and capped at 36rem beside the text, so a near-square illustration sits level with it (owner request 2026-10-30: /features/). */
  compactImage?: boolean;
  /** The feature-page hero: a heading written to fit two lines, and a screenshot card as tall as the text. */
  largeHeading?: boolean;
  byline?: { author: ReferenceDataEntry<'authors'> | null; reviewedBy?: ReferenceDataEntry<'authors'>; lastUpdated: Date | null };
}

const { eyebrow, h1, openingAnswer, ctas, heroMedia, heroStrip, largeHeading = false, narrowLede = false, byline, noColumnGap = false, fullWidthText = false, plainImage = false, compactImage = false } = Astro.props;
// A hero with media sets its whole text column (heading, answer, CTAs, contact card, ratings strip, byline) beside the
// image, which is centred against it. (The template always passes the aside slot, sometimes empty, so check what it renders.)
const aside = Astro.slots.has('aside') ? (await Astro.slots.render('aside')).trim() : '';
// An image panel for the right column, and a stats line under the CTAs. With a panel the text sits in rows 2 and 3
// of four, so the two 1fr rows centre it against the panel. It goes side by side from md
// (960px), as the panel is narrow enough to share the row with the text.
const media = Astro.slots.has('media') ? (await Astro.slots.render('media')).trim() : '';
const stats = Astro.slots.has('stats') ? (await Astro.slots.render('stats')).trim() : '';
---

<section class="overflow-x-clip rounded-t-[30px] bg-[var(--hero-bg)] lg:flex lg:min-h-[620px] lg:items-center">
  <div
    class:list={[
      'container-page grid w-full items-center gap-10 pt-10 pb-10 md:pt-14',
      media ? 'md:grid-cols-[1.05fr_1fr] md:grid-rows-[1fr_auto_auto_1fr] md:items-start md:gap-x-10 md:gap-y-0 md:pb-16 lg:gap-x-16' : heroMedia ? ['md:pb-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-y-0 lg:items-center', noColumnGap ? 'lg:gap-x-0' : 'lg:gap-x-12 xl:gap-x-16'] : 'md:pb-16',
    ]}
  >
    <div class:list={['max-w-[44rem] lg:col-start-1', fullWidthText && 'lg:max-w-none', media ? 'md:col-start-1 md:row-start-2' : 'lg:row-start-1 lg:self-end']}>
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      <h1 class:list={[media && 'md:text-[2.375rem] md:leading-[1.15]', largeHeading ? 'lg:text-[2.75rem] lg:leading-[1.12]' : 'lg:text-[2.875rem]']}>{h1}</h1>
      <Md text={openingAnswer} class:list={['lede mt-5 text-ink', narrowLede && 'lg:max-w-[40rem]', media && 'md:text-[1.0625rem] lg:text-[1.1875rem]']} />
      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Button {...ctas.primary} variant="cta" />
        {ctas.secondary && <Button {...ctas.secondary} variant="outline" />}
      </div>
      {stats && <Fragment set:html={stats} />}
    </div>

    {/* The grid's row gap would open up between the CTAs and what follows them; -mt-10 takes it back. Beside an image
        the two rows stretch to its height, so the text hugs the boundary between them (self-end, self-start) and the
        pair stays together, centred against the image. */}
    <div class:list={['-mt-10 max-w-[44rem] lg:col-start-1 lg:mt-0', fullWidthText && 'lg:max-w-none', media ? 'md:col-start-1 md:row-start-3 md:mt-0' : 'lg:row-start-2 lg:self-start']}>
      {aside && <Fragment set:html={aside} />}

      <HeroStrip heroStrip={heroStrip} />

      {byline && <AuthorByline {...byline} class={media ? 'mt-6 border-t border-line pt-5' : 'mt-6'} />}
    </div>

    {media && <div class="flex justify-center pt-2 md:col-start-2 md:pt-0 md:row-[1/span_4] md:self-center md:justify-end"><Fragment set:html={media} /></div>}

    {
      heroMedia && (
        // No card: the image sits straight on the hero, centred against the whole text column (h1 to byline) at its
        // natural shape and in full, with no glow or shadow behind it.
        <Screenshot
          media={heroMedia}
          priority
          outlined={heroMedia.kind !== 'illustration' && !plainImage}
          sizes="(min-width: 90rem) 680px, (min-width: 60rem) 48vw, 100vw"
          class:list={[
            'relative',
            (plainImage || compactImage) && '[&_img]:rounded-[18px]',
            compactImage && 'max-w-none lg:max-w-[36rem] lg:justify-self-end',
            'lg:col-start-2 lg:row-[1/span_2] lg:self-center',
            // Stacked (below 1200px), a photo or illustration stays at most 36rem wide, in line with the text above it;
            // a screenshot keeps the full width so its detail stays readable.
            heroMedia.kind !== 'screenshot' && !compactImage && 'w-full max-w-[36rem] lg:max-w-none',
            compactImage && 'w-full',
          ]}
        />
      )
    }
  </div>
</section>

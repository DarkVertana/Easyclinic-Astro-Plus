---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import Md from '../ui/Md.astro';
import frontDesk from '../../assets/images/stomatolog-nurse-tooth-clinic-checking-patient-appointment-looking-computer-monitor-stomatology-assistant-teeth-doctor-discussing-reception-dental-office_482257-11962-1.jpg';
import { getCollection } from 'astro:content';

interface Props {
  /** Fallback only: every page shows the home page's closing block (home.yaml), so editing it there changes the band site-wide. */
  closing: { heading: string; body?: string; primary: { label: string; href: string; event?: string }; secondary?: { label: string; href: string; event?: string } };
  /** No longer shown in the band (the floating WhatsApp button covers it); kept so callers need not change. */
  whatsappHref?: string;
}
const [home] = await getCollection('home');
const closing = home?.data.closing ?? Astro.props.closing;

/** How the demo runs; shown in the booking card. */
const steps = ['Pick a time that suits your clinic', 'We walk through a day like yours', 'Ask anything, with no obligation to buy'];

/** What a clinic gets. */
const benefits = [
  'Your whole team is trained before you go live',
  'Records can be imported from your old system',
  'Built on a low-code platform, so it fits your workflows',
  'Your patient data belongs to your clinic',
];
---

<section aria-labelledby="closing-heading" class="relative isolate overflow-hidden">
  {/* Full-bleed front-desk photo under a black overlay so white text reads over it. */}
  <Image
    src={frontDesk}
    alt=""
    widths={[960, 1480, 1920]}
    sizes="100vw"
    layout="none"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    loading="lazy"
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/80"></div>

  <div class="container-page grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.15fr_1fr] lg:gap-0">
    <div class="text-white">
      <h2 id="closing-heading" class="!text-white">{closing.heading}</h2>
      {closing.body && <Md text={closing.body} class="lede mt-6 max-w-xl text-white/85 [&_a]:text-white [&_a]:underline" />}

      <ul class="mt-8 space-y-3">
        {benefits.map((item) => (
          <li class="flex items-start gap-3 text-white/90">
            <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-1 h-5 w-5 shrink-0 text-teal-500"><circle cx="10" cy="10" r="10" fill="currentColor" /><path d="m6 10.2 2.6 2.6L14 7.4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-2xl bg-white p-6 text-ink sm:p-8">
      <p class="text-sm font-semibold tracking-wide text-blue-600 uppercase">Book your demo</p>
      <p class="mt-2 text-xl font-semibold text-ink-heading">Tell us a convenient time and we'll walk you through it.</p>

      <ul class="mt-6 space-y-3.5">
        {steps.map((step) => (
          <li class="flex items-start gap-3 text-ink">
            <svg aria-hidden="true" viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-teal-700"><circle cx="10" cy="10" r="10" fill="currentColor" opacity="0.12" /><path d="m6 10.2 2.6 2.6L14 7.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>{step}</span>
          </li>
        ))}
      </ul>

      <div class="mt-8 flex flex-col gap-3">
        <Button {...closing.primary} variant="cta" class="w-full justify-center" />
        {closing.secondary && <Button {...closing.secondary} variant="outline" class="w-full justify-center" />}
      </div>
    </div>
  </div>
</section>

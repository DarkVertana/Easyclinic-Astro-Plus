---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import google from '../../assets/images/customers/google-rated.png';
import capterraEase from '../../assets/images/customers/e9072545-49b2-4167-a7ff-28caf990b6b1.svg';
import getappBest from '../../assets/images/customers/13195c27-f3c6-4a02-b25f-11684b5daeea.svg';
import softwareAdvice from '../../assets/images/customers/0162bf71-f327-443a-a3d3-de7420649f42.png';
import capterraValue from '../../assets/images/customers/bd0658e0-b95f-4bbb-9ea4-c0db42bc0fd9.svg';
import softwareSuggest from '../../assets/images/customers/leader-mobile-support-2024.png';
import capterraRating from '../../assets/images/customers/8cd98050-a66a-47c3-804d-2d6207c410ff.svg';
import getappReviews from '../../assets/images/customers/214f0d10-1648-440a-9863-b8cd2b831b4e.webp';

/**
 * Review-site badges in a slider (owner request 2026-11-09, /customers/, below "Where to go next"). Native
 * scroll-snap, so it swipes on touch and scrolls without JavaScript; the script adds the arrows, one dot per badge
 * and a slow autoplay that pauses on hover, focus or reduced motion. Each badge links to its review page.
 */
const CAPTERRA = 'https://www.capterra.com/p/10026882/Easy-Clinic/';
const GETAPP = 'https://www.getapp.com/healthcare-pharmaceuticals-software/a/easy-clinic/';

const badges = [
  { src: google, alt: 'Google: Top Rated Service 2026, 4.8, verified by Trustindex', card: true },
  { src: capterraEase, alt: 'Capterra Best Ease of Use 2025', href: CAPTERRA },
  { src: getappBest, alt: 'GetApp Best Functionality and Features 2025', href: GETAPP },
  { src: softwareAdvice, alt: 'Software Advice: rated 4.9', href: 'https://www.softwareadvice.com/product/525635-Easy-Clinic/#reviews' },
  { src: capterraValue, alt: 'Capterra Best Value 2025', href: CAPTERRA },
  { src: softwareSuggest, alt: 'SoftwareSuggest Leader, Mobile Support 2024', href: 'https://www.softwaresuggest.com/easy-clinic' },
  { src: capterraRating, alt: 'Capterra star rating for Easy Clinic', href: 'https://www.capterra.com/p/10026882/Easy-Clinic/reviews/' },
  { src: getappReviews, alt: 'GetApp user reviews: rated 4.9', href: GETAPP },
];
---

<section id="review-badges" aria-labelledby="review-badges-heading" class="rb-section">
  <h2 id="review-badges-heading" class="sr-only">Ratings and awards on review sites</h2>
  <div class="container-page">
    <div class="rb" data-rb aria-roledescription="carousel">
      <button type="button" class="rb__arrow rb__arrow--prev" data-rb-prev aria-label="Previous badges">
        <Icon name="chevron-left" size={36} />
      </button>
      <ul class="rb__track" data-rb-track>
        {
          badges.map((b, i) => {
            const img = <Image src={b.src} alt={b.alt} width={b.card ? 260 : 200} class:list={['rb__img', b.card && 'rb__img--card']} loading="lazy" />;
            return (
              <li class="rb__slide" aria-roledescription="slide" aria-label={`${i + 1} of ${badges.length}`}>
                {b.href ? (
                  <a href={b.href} class="rb__link" target="_blank" rel="noopener noreferrer" data-track="outbound_click" data-label={b.alt}>
                    {img}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ) : (
                  <span class:list={['rb__link', b.card && 'rb__link--card']}>{img}</span>
                )}
              </li>
            );
          })
        }
      </ul>
      <button type="button" class="rb__arrow rb__arrow--next" data-rb-next aria-label="Next badges">
        <Icon name="chevron-right" size={36} />
      </button>
      <div class="rb__dots" data-rb-dots>
        {badges.map((b, i) => <button type="button" class="rb__dot" data-rb-dot={i} aria-label={`Show badge ${i + 1}: ${b.alt}`} />)}
      </div>
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-rb]')) {
    const track = root.querySelector<HTMLElement>('[data-rb-track]')!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-rb-dot]')];
    root.classList.add('rb--js');

    const current = () => {
      const left = track.scrollLeft;
      let best = 0;
      slides.forEach((s, i) => {
        if (Math.abs(s.offsetLeft - track.offsetLeft - left) < Math.abs(slides[best].offsetLeft - track.offsetLeft - left)) best = i;
      });
      return best;
    };
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[n].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    };
    const paint = () => {
      // At the end of the track the last dot lights, since the last badges cannot scroll to the left edge.
      const on = atEnd() ? slides.length - 1 : current();
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === on)));
    };

    root.querySelector('[data-rb-prev]')!.addEventListener('click', () => go(track.scrollLeft <= 4 ? slides.length - 1 : current() - 1));
    root.querySelector('[data-rb-next]')!.addEventListener('click', () => go(atEnd() ? 0 : current() + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('scroll', () => requestAnimationFrame(paint), { passive: true });
    paint();

    // Slow autoplay; stops while the pointer or focus is inside, and never runs under reduced motion.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let paused = false;
      const pause = () => (paused = true);
      const resume = () => (paused = false);
      root.addEventListener('mouseenter', pause);
      root.addEventListener('mouseleave', resume);
      root.addEventListener('focusin', pause);
      root.addEventListener('focusout', resume);
      setInterval(() => {
        if (!paused && !document.hidden) go(atEnd() ? 0 : current() + 1);
      }, 3500);
    }
  }
</script>

<style>
  /* A full-width pale band with no outer top padding; the badge row spans the same container width as every other
     section. Badges sit two per view on phones, up to six on wide screens. */
  .rb-section {
    background: #eef3f8;
    padding-block: 2rem 1.5rem;
  }
  @media (min-width: 60rem) {
    .rb-section {
      padding-block: 2.75rem 2rem;
    }
  }
  .rb {
    position: relative;
  }
  /* With the script, the arrows get a strip at each end so they never sit on a badge. */
  .rb--js {
    padding-inline: 2.25rem;
  }
  @media (min-width: 40rem) {
    .rb--js {
      padding-inline: 2.75rem;
    }
  }
  .rb__track {
    display: flex;
    margin: 0;
    padding: 0.75rem 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .rb__track::-webkit-scrollbar {
    display: none;
  }
  .rb__slide {
    /* Positioned, so the absolutely placed sr-only text stays inside the scrolling track instead of widening the page. */
    position: relative;
    flex: 0 0 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
    scroll-snap-align: start;
  }
  @media (min-width: 40rem) {
    .rb__slide {
      flex-basis: calc(100% / 3);
    }
  }
  @media (min-width: 64rem) {
    .rb__slide {
      flex-basis: 25%;
    }
  }
  @media (min-width: 80rem) {
    .rb__slide {
      flex-basis: calc(100% / 6);
    }
  }

  .rb__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 7.5rem;
    border-radius: 0.75rem;
    transition: transform 0.2s;
  }
  @media (min-width: 40rem) {
    .rb__link {
      height: 9.5rem;
    }
  }
  a.rb__link:hover {
    transform: translateY(-3px);
  }
  a.rb__link:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .rb__img {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  /* The Google badge is a wide label, so it sits on a white card as on the live site. */
  .rb__img--card {
    max-height: 5.5rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.75rem;
    background: var(--color-white);
    box-shadow: 0 6px 18px rgb(10 37 64 / 0.1);
  }
  @media (min-width: 40rem) {
    .rb__img--card {
      max-height: 7rem;
      padding: 0.875rem 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rb__track {
      scroll-behavior: auto;
    }
    .rb__link {
      transition: none;
    }
  }

  /* Arrows and dots need the script; without it the row still scrolls. */
  .rb__arrow,
  .rb__dots {
    display: none;
  }
  .rb--js .rb__arrow {
    position: absolute;
    top: calc(50% - 0.75rem);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    /* Plain chevrons over the row's edges, so the row keeps the full container width. */
    background: none;
    color: #c7c7c7; /* owner request 2026-11-09 */
    transform: translateY(-50%);
    transition: color 0.2s;
  }
  .rb--js .rb__arrow:hover {
    color: var(--color-grey-400);
  }
  .rb--js .rb__arrow:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .rb__arrow--prev {
    left: -0.375rem;
  }
  .rb__arrow--next {
    right: -0.375rem;
  }
  .rb--js .rb__dots {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 1rem;
  }
  /* A 24px tap target around each 8px dot. */
  .rb__dot {
    position: relative;
    width: 1.5rem;
    height: 1.5rem;
  }
  .rb__dot::before {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #c3cad3;
    transition: background-color 0.2s, transform 0.2s;
  }
  .rb__dot[aria-current='true']::before {
    background: var(--color-navy-900);
    transform: scale(1.15);
  }
  .rb__dot:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 0;
    border-radius: 999px;
  }
</style>

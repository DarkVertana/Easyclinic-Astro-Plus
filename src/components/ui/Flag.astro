---
/**
 * A country flag drawn inline (no image request; the CSP allows images from this site only), cropped to a circle.
 * Simplified for small sizes: the stripes and the main emblem, without fine detail. Unknown codes render nothing.
 */
interface Props {
  /** ISO 3166-1 alpha-2 code: the four country pages (IN, KE, AE, NG) and the home page's other markets. */
  code: string;
  size?: number;
  class?: string;
}

const { code, size = 40, class: className } = Astro.props;
const id = `flag-${code.toLowerCase()}`;
const c = code.toUpperCase();
const known = ['IN', 'KE', 'AE', 'NG', 'ET', 'FJ', 'GH', 'MY', 'MV', 'MU', 'QA', 'RW', 'SC', 'SO', 'ZA', 'SR', 'TZ', 'TT', 'UG'].includes(c);
/** Points of a five-pointed star centred on (cx, cy) with outer radius r. */
function star(cx: number, cy: number, r: number): string {
  return Array.from({ length: 10 }, (_, i) => {
    const rad = i % 2 === 0 ? r : r * 0.4;
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    return `${(cx + rad * Math.cos(a)).toFixed(2)},${(cy + rad * Math.sin(a)).toFixed(2)}`;
  }).join(' ');
}
---

{
  known && (
    <svg viewBox="0 0 40 40" width={size} height={size} class:list={['shrink-0 rounded-full', className]} aria-hidden="true">
      <defs>
        <clipPath id={id}>
          <circle cx="20" cy="20" r="20" />
        </clipPath>
      </defs>
      <g clip-path={`url(#${id})`}>
        {code.toUpperCase() === 'IN' && (
          <>
            <rect width="40" height="13.4" fill="#ff9933" />
            <rect y="13.3" width="40" height="13.4" fill="#ffffff" />
            <rect y="26.6" width="40" height="13.4" fill="#138808" />
            <circle cx="20" cy="20" r="5" fill="none" stroke="#000080" stroke-width="1.1" />
            <circle cx="20" cy="20" r="1.1" fill="#000080" />
            <g stroke="#000080" stroke-width="0.5">
              <line x1="20" y1="15" x2="20" y2="25" />
              <line x1="15" y1="20" x2="25" y2="20" />
              <line x1="16.5" y1="16.5" x2="23.5" y2="23.5" />
              <line x1="23.5" y1="16.5" x2="16.5" y2="23.5" />
            </g>
          </>
        )}
        {code.toUpperCase() === 'KE' && (
          <>
            <rect width="40" height="40" fill="#ffffff" />
            <rect width="40" height="12" fill="#000000" />
            <rect y="14.5" width="40" height="11" fill="#bb0000" />
            <rect y="28" width="40" height="12" fill="#006600" />
            <ellipse cx="20" cy="20" rx="4.6" ry="9" fill="#bb0000" stroke="#ffffff" stroke-width="0.8" />
            <ellipse cx="20" cy="20" rx="2.2" ry="9" fill="#000000" />
            <ellipse cx="20" cy="20" rx="1.3" ry="2.6" fill="#ffffff" />
          </>
        )}
        {code.toUpperCase() === 'AE' && (
          <>
            <rect width="40" height="13.4" fill="#00732f" />
            <rect y="13.3" width="40" height="13.4" fill="#ffffff" />
            <rect y="26.6" width="40" height="13.4" fill="#000000" />
            <rect width="12" height="40" fill="#ff0000" />
          </>
        )}
        {code.toUpperCase() === 'NG' && (
          <>
            <rect width="40" height="40" fill="#ffffff" />
            <rect width="13.4" height="40" fill="#008751" />
            <rect x="26.6" width="13.4" height="40" fill="#008751" />
          </>
        )}
        {c === 'ET' && (
          <>
            <rect width="40" height="13.4" fill="#078930" />
            <rect y="13.3" width="40" height="13.4" fill="#fcdd09" />
            <rect y="26.6" width="40" height="13.4" fill="#da121a" />
            <circle cx="20" cy="20" r="7" fill="#0f47af" />
            <polygon points={star(20, 20.5, 5)} fill="none" stroke="#fcdd09" stroke-width="0.9" />
          </>
        )}
        {c === 'FJ' && (
          <>
            <rect width="40" height="40" fill="#68bfe5" />
            <rect width="20" height="20" fill="#012169" />
            <rect x="8" width="4" height="20" fill="#ffffff" />
            <rect y="8" width="20" height="4" fill="#ffffff" />
            <rect x="9" width="2" height="20" fill="#c8102e" />
            <rect y="9" width="20" height="2" fill="#c8102e" />
            <path d="M25 17h9v8c0 3-4.5 5-4.5 5S25 28 25 25z" fill="#ffffff" stroke="#c8102e" stroke-width="0.8" />
          </>
        )}
        {c === 'GH' && (
          <>
            <rect width="40" height="13.4" fill="#ce1126" />
            <rect y="13.3" width="40" height="13.4" fill="#fcd116" />
            <rect y="26.6" width="40" height="13.4" fill="#006b3f" />
            <polygon points={star(20, 20.6, 6)} fill="#000000" />
          </>
        )}
        {c === 'MY' && (
          <>
            <rect width="40" height="40" fill="#ffffff" />
            {[0, 1, 2, 3, 4, 5, 6].map((i) => (
              <rect y={i * 5.72} width="40" height="2.86" fill="#cc0001" />
            ))}
            <rect width="22" height="22.9" fill="#010066" />
            <circle cx="10" cy="11.5" r="6" fill="#ffcc00" />
            <circle cx="12" cy="11.5" r="5" fill="#010066" />
            <polygon points={star(17.5, 11.5, 3.6)} fill="#ffcc00" />
          </>
        )}
        {c === 'MV' && (
          <>
            <rect width="40" height="40" fill="#d21034" />
            <rect x="8" y="8" width="24" height="24" fill="#007e3a" />
            <circle cx="21" cy="20" r="6" fill="#ffffff" />
            <circle cx="23.5" cy="20" r="5.2" fill="#007e3a" />
          </>
        )}
        {c === 'MU' && (
          <>
            <rect width="40" height="10" fill="#ea2839" />
            <rect y="10" width="40" height="10" fill="#1a206d" />
            <rect y="20" width="40" height="10" fill="#ffd500" />
            <rect y="30" width="40" height="10" fill="#00a551" />
          </>
        )}
        {c === 'QA' && (
          <>
            <rect width="40" height="40" fill="#8a1538" />
            <polygon
              points="0,0 14,0 18,2.2 14,4.4 18,6.7 14,8.9 18,11.1 14,13.3 18,15.6 14,17.8 18,20 14,22.2 18,24.4 14,26.7 18,28.9 14,31.1 18,33.3 14,35.6 18,37.8 14,40 0,40"
              fill="#ffffff"
            />
          </>
        )}
        {c === 'RW' && (
          <>
            <rect width="40" height="20" fill="#00a1de" />
            <rect y="20" width="40" height="10" fill="#fad201" />
            <rect y="30" width="40" height="10" fill="#20603d" />
            <circle cx="29" cy="10" r="4.5" fill="#fad201" />
          </>
        )}
        {c === 'SC' && (
          <>
            <rect width="40" height="40" fill="#007a3d" />
            <polygon points="0,40 0,0 14,0" fill="#003f87" />
            <polygon points="0,40 14,0 28,0" fill="#fcd856" />
            <polygon points="0,40 28,0 40,0 40,14" fill="#d62828" />
            <polygon points="0,40 40,14 40,27" fill="#ffffff" />
          </>
        )}
        {c === 'SO' && (
          <>
            <rect width="40" height="40" fill="#4189dd" />
            <polygon points={star(20, 21, 8)} fill="#ffffff" />
          </>
        )}
        {c === 'ZA' && (
          <>
            <rect width="40" height="20" fill="#e03c31" />
            <rect y="20" width="40" height="20" fill="#001489" />
            <polygon points="0,0 7,0 21,15 40,15 40,25 21,25 7,40 0,40" fill="#ffffff" />
            <polygon points="0,3 4,3 19,17 40,17 40,23 19,23 4,37 0,37" fill="#007749" />
            <polygon points="0,6 14,20 0,34" fill="#ffb81c" />
            <polygon points="0,9 11,20 0,31" fill="#000000" />
          </>
        )}
        {c === 'SR' && (
          <>
            <rect width="40" height="40" fill="#377e3f" />
            <rect y="8" width="40" height="24" fill="#ffffff" />
            <rect y="12" width="40" height="16" fill="#b40a2d" />
            <polygon points={star(20, 20.6, 5.5)} fill="#ecc81d" />
          </>
        )}
        {c === 'TZ' && (
          <>
            <polygon points="0,0 40,0 0,40" fill="#1eb53a" />
            <polygon points="40,0 40,40 0,40" fill="#00a3dd" />
            <polygon points="-2,34 34,-2 42,6 6,42" fill="#fcd116" />
            <polygon points="0,36.5 36.5,0 40,3.5 3.5,40" fill="#000000" />
          </>
        )}
        {c === 'TT' && (
          <>
            <rect width="40" height="40" fill="#ce1126" />
            <polygon points="0,-3 6,-3 43,34 43,40 34,40 -3,3" fill="#ffffff" />
            <polygon points="2,-3 6,-3 43,34 43,38 38,43 -3,2" fill="#000000" />
          </>
        )}
        {c === 'UG' && (
          <>
            {['#000000', '#fcdc04', '#d90000', '#000000', '#fcdc04', '#d90000'].map((fill, i) => (
              <rect y={i * 6.67} width="40" height="6.7" fill={fill} />
            ))}
            <circle cx="20" cy="20" r="7" fill="#ffffff" />
            <circle cx="20" cy="20" r="3" fill="#9ca69c" />
          </>
        )}
      </g>
      <circle cx="20" cy="20" r="19.5" fill="none" stroke="rgb(255 255 255 / 0.35)" />
    </svg>
  )
}

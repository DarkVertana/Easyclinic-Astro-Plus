# Build stage: production renders published pages only. Defaults from VERCEL_ENV.
# CONTENT_STAGE=production
# Launch switch: until true, every host (including www) is noindex.
# INDEXING_ENABLED=true

# GA4 measurement ID (property 347728478). Loaded only on www.easyclinic.io.
PUBLIC_GA4_ID=
# Demo form: submissions are POSTed as JSON to this URL (Zapier, Make or a CRM endpoint).
CRM_WEBHOOK_URL=
# Optional bearer token sent with the webhook.
CRM_WEBHOOK_TOKEN=
# Signs the confirmation-page reference so the conversion event fires only for real submissions.
DEMO_REF_SECRET=

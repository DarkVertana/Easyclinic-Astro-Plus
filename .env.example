# Build stage: production renders published pages only. Defaults from VERCEL_ENV.
# CONTENT_STAGE=production
# Launch switch: until true, every host (including www) is noindex.
# INDEXING_ENABLED=true

# GA4 measurement ID (property 347728478). Loaded only on www.easyclinic.io.
PUBLIC_GA4_ID=
# Demo form: submissions are POSTed as JSON to this URL (Zapier, Make or a CRM endpoint).
CRM_WEBHOOK_URL=
# Optional bearer token sent with the webhook.
CRM_WEBHOOK_TOKEN=
# Signs the confirmation-page reference so the conversion event fires only for real submissions.
DEMO_REF_SECRET=

# Keystatic editor (docs/keystatic-design.md section 3.4). Off unless set; never set these in Production.
# `pnpm dev` needs none of them (local storage). A preview deployment with the editor needs all of them.
# KEYSTATIC_STORAGE=github
# KEYSTATIC_GITHUB_REPO=owner/name
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Blog admin (/admin/). What each one does and how to get it: docs/admin-guide.md, "Setup". All server-only and optional:
# without them the admin runs locally (`corepack pnpm dev`) with a file store and local content, or shows what is missing.
# Google sign-in: OAuth client with redirect URI https://<host>/admin/auth/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated email addresses. Approvers can publish; editors can write and submit.
ADMIN_APPROVERS=
ADMIN_EDITORS=
# Signs the sign-in cookie. Create with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Neon Postgres connection string for submissions and AI jobs.
DATABASE_URL=
# Fine-grained GitHub token: Contents read and write on this repository only.
GITHUB_TOKEN=
# owner/name
ADMIN_GITHUB_REPO=
# Preview address for a content branch; see the guide for the format.
ADMIN_PREVIEW_URL_TEMPLATE=
# AI drafting, and the most AI runs allowed per week.
ANTHROPIC_API_KEY=
ADMIN_WEEKLY_AI_LIMIT=
# Dollar ceilings for AI spending. Defaults: 5 per job, 50 per week.
ADMIN_JOB_MAX_USD=
ADMIN_WEEKLY_MAX_USD=
# Local development only. `astro dev` ignores GITHUB_TOKEN and DATABASE_URL unless this is 1, and 1 turns off the
# passwordless development sign-in, so you then need the Google settings above. Never needed on a deployment.
ADMIN_DEV_ALLOW_REAL=
# Insights: the whole service-account key file as one line of JSON, the numeric GA4 property ID, and the Search Console
# property exactly as Google shows it (sc-domain:easyclinic.io or https://www.easyclinic.io/).
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE=
# Scheduled publishing. Vercel sends CRON_SECRET as a bearer token; without it the schedule route refuses every call.
# Create with: openssl rand -base64 32
CRON_SECRET=
# The delay the schedule dialog promises, in words. Default: within a day on Hobby.
ADMIN_SCHEDULE_PRECISION=

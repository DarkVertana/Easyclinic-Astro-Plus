{
  "name": "easyclinic-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-output.ts",
    "build:prod": "CONTENT_STAGE=production astro build && CONTENT_STAGE=production node scripts/check-output.ts",
    "check": "astro sync && astro check",
    "test": "vitest run --project unit",
    "test:output": "vitest run --project output",
    "serve:output": "node scripts/serve-output.ts",
    "e2e": "playwright test",
    "lint:content": "node scripts/lint-content.ts",
    "facts:report": "node scripts/report-facts.ts",
    "smoke": "node scripts/smoke.ts",
    "coverage": "node scripts/check-coverage.ts",
    "lh": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/vercel": "11.0.11",
    "@keystar/ui": "0.10.0",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "lucide-static": "^1.48.0",
    "marked": "^18.0.14",
    "react": "19.3.0",
    "react-aria": "3.50.0",
    "react-dom": "19.3.0",
    "react-stately": "3.48.0",
    "satori": "0.33.5",
    "sharp": "0.35.4",
    "simple-icons": "^16.32.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "^5.0.6",
    "chrome-launcher": "^1.2.1",
    "html-validate": "11.16.0",
    "js-yaml": "4.3.2",
    "lighthouse": "^13.5.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-mdx": "3.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-mdxjs": "3.0.0",
    "node-html-parser": "^9.0.4",
    "schema-dts": "2.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^6.0.3",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
